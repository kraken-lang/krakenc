// Kraken Self-Hosted Compiler — Parser / Translator
// Single-pass recursive descent: reads tokens from SOA arrays, emits C code
// into a VecString output buffer. Handles the Kraken language subset needed
// for bootstrapping: functions, structs, variables, control flow, expressions.

module parser;

// ---------------------------------------------------------------------------
// Translator State
// ---------------------------------------------------------------------------

pub struct Translator {
    pos: int;
    count: int;
    indent: int;
    errors: int;
    file: string;
    int_data: VecInt;
    lexemes: VecString;
    out: VecString;
    sema: MapStringString;
}

fn translate_union(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let name = tr_lexeme(c);
    c = tr_advance(c);
    c = skip_generic_params(c);
    c = tr_advance(c);

    tr_emit_line(c, str_concat("union ", str_concat(name, " {")));
    while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
        let fname = tr_lexeme(c);
        c = tr_advance(c);
        if (tr_at_end(c)) { break; }
        if (tr_kind(c) != TK_COLON()) {
            if (tr_kind(c) == TK_RBRACE()) { break; }
            c = tr_advance(c);
            continue;
        }
        c = tr_advance(c);
        let fk = tr_kind(c); let fn_name = tr_lexeme(c); c = tr_advance(c);
        if (fk == TK_OP_STAR() && !tr_at_end(c)) { c = tr_advance(c); }
        c = skip_array_type_suffix(c, fk);
        c = skip_generic_params(c);
        let fc = type_to_c(fk, fn_name);
        if (fk == TK_IDENTIFIER()) { fc = "int64_t"; }
        if (fk == TK_KW_FN()) { fc = "void*"; c = skip_fn_type_sig(c); }
        tr_emit_line(c, str_concat(fc, str_concat(" ", str_concat(fname, ";"))));
        if (!tr_at_end(c) && (tr_kind(c) == TK_SEMICOLON() || tr_kind(c) == TK_COMMA())) { c = tr_advance(c); }
    }
    c = tr_advance(c);
    tr_emit_line(c, "};");
    tr_emit(c, "\n");
    return c;
}

pub fn new_translator(token_count: int, file: string, id: VecInt, lex: VecString, o: VecString) -> Translator {
    return Translator {
        pos: 0,
        count: token_count,
        indent: 0,
        errors: 0,
        file: file,
        int_data: id,
        lexemes: lex,
        out: o,
        sema: map_string_string_new(),
    };
}

// ---------------------------------------------------------------------------
// Token access helpers — all read from embedded vecs via single Translator
// ---------------------------------------------------------------------------

fn tr_at_end(tr: Translator) -> bool {
    return tr.pos >= tr.count;
}

fn tr_kind(tr: Translator) -> int {
    if (tr_at_end(tr)) { return TK_EOF(); }
    return vec_int_get(tr.int_data, tr.pos * 3);
}

fn tr_lexeme(tr: Translator) -> string {
    if (tr_at_end(tr)) { return ""; }
    return vec_string_get(tr.lexemes, tr.pos);
}

fn tr_line(tr: Translator) -> int {
    if (tr_at_end(tr)) { return 0; }
    return vec_int_get(tr.int_data, tr.pos * 3 + 1);
}

fn tr_col(tr: Translator) -> int {
    if (tr_at_end(tr)) { return 0; }
    return vec_int_get(tr.int_data, tr.pos * 3 + 2);
}

fn tr_advance(tr: Translator) -> Translator {
    return Translator {
        pos: tr.pos + 1, count: tr.count, indent: tr.indent, errors: tr.errors,
        file: tr.file, int_data: tr.int_data, lexemes: tr.lexemes, out: tr.out, sema: tr.sema,
    };
}

fn tr_skip(tr: Translator, n: int) -> Translator {
    return Translator {
        pos: tr.pos + n, count: tr.count, indent: tr.indent, errors: tr.errors,
        file: tr.file, int_data: tr.int_data, lexemes: tr.lexemes, out: tr.out, sema: tr.sema,
    };
}

fn tr_indent(tr: Translator) -> Translator {
    return Translator {
        pos: tr.pos, count: tr.count, indent: tr.indent + 1, errors: tr.errors,
        file: tr.file, int_data: tr.int_data, lexemes: tr.lexemes, out: tr.out, sema: tr.sema,
    };
}

fn tr_dedent(tr: Translator) -> Translator {
    let new_i = tr.indent - 1;
    if (new_i < 0) { new_i = 0; }
    return Translator {
        pos: tr.pos, count: tr.count, indent: new_i, errors: tr.errors,
        file: tr.file, int_data: tr.int_data, lexemes: tr.lexemes, out: tr.out, sema: tr.sema,
    };
}

fn tr_reset_pos(tr: Translator) -> Translator {
    return Translator {
        pos: 0, count: tr.count, indent: 0, errors: tr.errors,
        file: tr.file, int_data: tr.int_data, lexemes: tr.lexemes, out: tr.out, sema: tr.sema,
    };
}

fn tr_error(tr: Translator, msg: string) -> Translator {
    let ln = tr_line(tr);
    let co = tr_col(tr);
    let d = new_error(KRA_UNEXPECTED_TOKEN(), msg, tr.file, ln, co);
    print_diagnostic(d);
    return Translator {
        pos: tr.pos, count: tr.count, indent: tr.indent, errors: tr.errors + 1,
        file: tr.file, int_data: tr.int_data, lexemes: tr.lexemes, out: tr.out, sema: tr.sema,
    };
}

// ---------------------------------------------------------------------------
// Output helpers — emit to tr.out
// ---------------------------------------------------------------------------

fn tr_emit(tr: Translator, s: string) -> void {
    vec_string_push(tr.out, s);
}

fn tr_emit_indent(tr: Translator) -> void {
    let i = 0;
    while (i < tr.indent) {
        vec_string_push(tr.out, "    ");
        i = i + 1;
    }
}

fn tr_emit_line(tr: Translator, s: string) -> void {
    tr_emit_indent(tr);
    vec_string_push(tr.out, s);
    vec_string_push(tr.out, "\n");
}

// ---------------------------------------------------------------------------
// Kraken type -> C type mapping
// ---------------------------------------------------------------------------

fn type_to_c(kind: int, name: string) -> string {
    if (kind == TK_KW_INT())    { return "int64_t"; }
    if (kind == TK_KW_FLOAT())  { return "double"; }
    if (kind == TK_KW_BOOL())   { return "bool"; }
    if (kind == TK_KW_STRING()) { return "kr_str"; }
    if (kind == TK_KW_STR())    { return "kr_str"; }
    if (kind == TK_KW_BYTES())  { return "uint8_t*"; }
    if (kind == TK_KW_VOID())   { return "void"; }
    if (kind == TK_KW_DYN())    { return "KrDyn"; }
    if (kind == TK_IDENTIFIER()) {
        // Generic type params / trait self type (erased in C backend)
        if (strcmp(name, "T") == 0 || strcmp(name, "U") == 0 || strcmp(name, "V") == 0 || strcmp(name, "K") == 0 || strcmp(name, "R") == 0) {
            return "int64_t";
        }
        if (strcmp(name, "Self") == 0) { return "void*"; }
        if (strcmp(name, "dyn") == 0) { return "KrDyn"; }
        // Opaque runtime handles
        if (strcmp(name, "VecInt") == 0)    { return "void*"; }
        if (strcmp(name, "VecString") == 0) { return "void*"; }
        if (strcmp(name, "VecBytes") == 0)  { return "void*"; }
        if (strcmp(name, "Vec") == 0)       { return "void*"; }
        if (strcmp(name, "Map") == 0)       { return "void*"; }
        if (strcmp(name, "MapStringInt") == 0)    { return "void*"; }
        if (strcmp(name, "MapStringString") == 0) { return "void*"; }
        // User-defined struct — pass by value (typedef'd name)
        return name;
    }
    return "void*";
}

fn count_tuple_arity_at(tr: Translator, pos: int) -> int {
    // Count tuple arity from a given token position (at the opening '(')
    let j = pos + 1;
    let commas = 0;
    let depth = 0;
    while (j < tr.count && !(vec_int_get(tr.int_data, j * 3) == TK_RPAREN() && depth == 0)) {
        if (vec_int_get(tr.int_data, j * 3) == TK_LPAREN()) { depth = depth + 1; }
        if (vec_int_get(tr.int_data, j * 3) == TK_RPAREN()) { depth = depth - 1; }
        if (vec_int_get(tr.int_data, j * 3) == TK_COMMA() && depth == 0) { commas = commas + 1; }
        j = j + 1;
    }
    return commas + 1;
}

fn count_tuple_arity(tr: Translator) -> int {
    // tr positioned AFTER opening '(' — counts commas at depth 0
    let c: Translator = tr;
    let commas = 0;
    let depth = 0;
    while (!tr_at_end(c) && !(tr_kind(c) == TK_RPAREN() && depth == 0)) {
        if (tr_kind(c) == TK_LPAREN()) { depth = depth + 1; }
        if (tr_kind(c) == TK_RPAREN()) { depth = depth - 1; }
        if (tr_kind(c) == TK_COMMA() && depth == 0) { commas = commas + 1; }
        c = tr_advance(c);
    }
    return commas + 1;
}

fn skip_tuple_type(tr: Translator) -> Translator {
    // tr positioned AFTER opening '(' — skips to matching ')' and advances past it
    let c: Translator = tr;
    let depth = 0;
    while (!tr_at_end(c) && !(tr_kind(c) == TK_RPAREN() && depth == 0)) {
        if (tr_kind(c) == TK_LPAREN()) { depth = depth + 1; }
        if (tr_kind(c) == TK_RPAREN()) { depth = depth - 1; }
        c = tr_advance(c);
    }
    if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
    return c;
}

fn tuple_type_c(arity: int) -> string {
    if (arity >= 1 && arity <= 10) { return str_concat("KrTuple", fmt_int(arity)); }
    return "void*";
}

fn has_tuple_comma_at(tr: Translator, pos: int) -> int {
    // Check if '(' at pos starts a tuple literal (has comma at depth 0).
    let ci = pos + 1;
    let cd = 1;
    while (ci < tr.count && cd > 0) {
        let ck = vec_int_get(tr.int_data, ci * 3);
        if (ck == TK_LPAREN()) { cd = cd + 1; }
        if (ck == TK_RPAREN()) { cd = cd - 1; }
        if (cd == 1 && ck == TK_COMMA()) { return 1; }
        ci = ci + 1;
    }
    return 0;
}

fn count_nested_tuple_leaves_at(tr: Translator, pos: int) -> int {
    // pos points to opening '(' of a tuple type like ((int, int), int)
    // Recursively counts total leaf (non-tuple) elements.
    let j = pos + 1;
    let total = 0;
    let depth = 0;
    let elem_start = j;
    while (j < tr.count) {
        let k = vec_int_get(tr.int_data, j * 3);
        if (k == TK_LPAREN()) { depth = depth + 1; }
        if (k == TK_RPAREN()) {
            if (depth == 0) {
                if (j > elem_start) {
                    let ek = vec_int_get(tr.int_data, elem_start * 3);
                    if (ek == TK_LPAREN()) {
                        total = total + count_nested_tuple_leaves_at(tr, elem_start);
                    } else {
                        total = total + 1;
                    }
                }
                break;
            }
            depth = depth - 1;
        }
        if (depth == 0 && k == TK_COMMA()) {
            let ek = vec_int_get(tr.int_data, elem_start * 3);
            if (ek == TK_LPAREN()) {
                total = total + count_nested_tuple_leaves_at(tr, elem_start);
            } else {
                total = total + 1;
            }
            elem_start = j + 1;
        }
        j = j + 1;
    }
    return total;
}

fn collect_tuple_structure_at(tr: Translator, pos: int) -> string {
    // Returns comma-separated leaf counts per top-level element.
    // e.g., ((int,int),(int,int)) → "2,2"
    // e.g., (((int,int),int),int) → "3,1"
    // e.g., (int,int,int) → "1,1,1"
    let j = pos + 1;
    let result = "";
    let depth = 0;
    let elem_start = j;
    let elem_idx = 0;
    while (j < tr.count) {
        let k = vec_int_get(tr.int_data, j * 3);
        if (k == TK_LPAREN()) { depth = depth + 1; }
        if (k == TK_RPAREN()) {
            if (depth == 0) {
                if (j > elem_start) {
                    let ek = vec_int_get(tr.int_data, elem_start * 3);
                    let leaves = 1;
                    if (ek == TK_LPAREN()) {
                        leaves = count_nested_tuple_leaves_at(tr, elem_start);
                    }
                    if (elem_idx > 0) { result = str_concat(result, ","); }
                    result = str_concat(result, fmt_int(leaves));
                }
                break;
            }
            depth = depth - 1;
        }
        if (depth == 0 && k == TK_COMMA()) {
            let ek = vec_int_get(tr.int_data, elem_start * 3);
            let leaves = 1;
            if (ek == TK_LPAREN()) {
                leaves = count_nested_tuple_leaves_at(tr, elem_start);
            }
            if (elem_idx > 0) { result = str_concat(result, ","); }
            result = str_concat(result, fmt_int(leaves));
            elem_idx = elem_idx + 1;
            elem_start = j + 1;
        }
        j = j + 1;
    }
    return result;
}

fn type_to_c_value(kind: int) -> string {
    if (kind == TK_KW_INT())    { return "0"; }
    if (kind == TK_KW_FLOAT())  { return "0.0"; }
    if (kind == TK_KW_BOOL())   { return "false"; }
    if (kind == TK_KW_STRING()) { return "\"\""; }
    if (kind == TK_KW_STR())    { return "\"\""; }
    return "NULL";
}

fn skip_generic_params(tr: Translator) -> Translator {
    let c: Translator = tr;
    if (tr_at_end(c) || tr_kind(c) != TK_OP_LT()) { return c; }
    c = tr_advance(c);
    let depth = 1;
    while (!tr_at_end(c) && depth > 0) {
        if (tr_kind(c) == TK_OP_LT()) { depth = depth + 1; }
        if (tr_kind(c) == TK_OP_GT()) { depth = depth - 1; }
        c = tr_advance(c);
    }
    return c;
}

// Skip array-style type annotation suffix when type starts with '[':
//   [T], [[T]], [(A, B)], ...
fn skip_array_type_suffix(tr: Translator, first_kind: int) -> Translator {
    let c: Translator = tr;
    if (first_kind != TK_LBRACKET()) { return c; }
    let depth = 1;
    while (!tr_at_end(c) && depth > 0) {
        let k = tr_kind(c);
        if (k == TK_LBRACKET()) { depth = depth + 1; }
        if (k == TK_RBRACKET()) { depth = depth - 1; }
        c = tr_advance(c);
    }
    return c;
}

// Skip function-type suffix in type positions:
//   fn(T1, T2) -> Ret
fn skip_fn_type_sig(tr: Translator) -> Translator {
    let c: Translator = tr;
    if (tr_at_end(c) || tr_kind(c) != TK_LPAREN()) { return c; }

    c = tr_advance(c);
    let depth = 1;
    while (!tr_at_end(c) && depth > 0) {
        if (tr_kind(c) == TK_LPAREN()) { depth = depth + 1; }
        if (tr_kind(c) == TK_RPAREN()) { depth = depth - 1; }
        c = tr_advance(c);
    }

    if (!tr_at_end(c) && tr_kind(c) == TK_ARROW()) {
        c = tr_advance(c);
        if (!tr_at_end(c) && tr_kind(c) == TK_LBRACKET()) {
            c = tr_advance(c);
            c = skip_array_type_suffix(c, TK_LBRACKET());
        } else {
            c = tr_advance(c);
        }
        c = skip_generic_params(c);
    }
    return c;
}

// Only skip `<...>` when it is turbofish/generic syntax attached to an
// identifier, and the closing `>` is followed by `(` or `{`.
// This avoids mis-parsing comparisons like `kind < 200`.
fn maybe_skip_turbofish(tr: Translator) -> Translator {
    let c: Translator = tr;
    if (tr_at_end(c) || tr_kind(c) != TK_OP_LT()) { return c; }

    let i = c.pos;
    let depth = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);
        if (k == TK_OP_LT()) { depth = depth + 1; }
        if (k == TK_OP_GT()) {
            depth = depth - 1;
            if (depth == 0) {
                let j = i + 1;
                if (j < c.count) {
                    let k2 = vec_int_get(c.int_data, j * 3);
                    if (k2 == TK_LPAREN() || k2 == TK_LBRACE()) {
                        return skip_generic_params(c);
                    }
                }
                return c;
            }
        }
        i = i + 1;
    }
    return c;
}

fn sanitize_c_name(name: string) -> string {
    if (name == "int")    { return "int_val"; }
    if (name == "float")  { return "float_val"; }
    if (name == "double") { return "double_val"; }
    if (name == "char")   { return "char_val"; }
    if (name == "void")   { return "void_val"; }
    if (name == "long")   { return "long_val"; }
    if (name == "short")  { return "short_val"; }
    if (name == "auto")   { return "auto_val"; }
    if (name == "register") { return "register_val"; }
    if (name == "extern") { return "extern_val"; }
    if (name == "static") { return "static_val"; }
    if (name == "const")  { return "const_val"; }
    if (name == "signed") { return "signed_val"; }
    if (name == "unsigned") { return "unsigned_val"; }
    if (name == "default") { return "default_val"; }
    if (name == "switch")  { return "switch_val"; }
    if (name == "case")    { return "case_val"; }
    if (name == "break")   { return "break_val"; }
    if (name == "continue") { return "continue_val"; }
    if (name == "goto")    { return "goto_val"; }
    if (name == "sizeof")  { return "sizeof_val"; }
    if (name == "typedef") { return "typedef_val"; }
    if (name == "union")   { return "union_val"; }
    if (name == "volatile") { return "volatile_val"; }
    return name;
}

fn mangle_top_level_fn_name(name: string) -> string {
    if (name == "log") { return "kr_user_log"; }
    return str_concat("kr_", name);
}

// Check if a variable name was already declared in the current scope (for shadowing).
// Scans backward from let_pos (the position of the CURRENT let keyword) looking for
// a previous let that declares the same variable name.
fn is_var_already_declared(tr: Translator, var_name: string, let_pos: int) -> int {
    let i = let_pos - 1;
    let depth = 0;
    while (i >= 0) {
        let k = vec_int_get(tr.int_data, i * 3);
        if (k == TK_RBRACE()) { depth = depth + 1; }
        if (k == TK_LBRACE()) {
            if (depth == 0) { break; }
            depth = depth - 1;
        }
        if (depth == 0 && k == TK_KW_LET()) {
            let j = i + 1;
            // Skip optional 'mut'
            if (j < tr.count && vec_int_get(tr.int_data, j * 3) == TK_KW_MUT()) { j = j + 1; }
            // Check simple: let NAME
            if (j < tr.count && vec_string_get(tr.lexemes, j) == var_name) {
                return 1;
            }
            // Check tuple: let (... NAME ...)
            if (j < tr.count && vec_int_get(tr.int_data, j * 3) == TK_LPAREN()) {
                j = j + 1;
                let pd = 1;
                while (j < tr.count && pd > 0) {
                    if (vec_int_get(tr.int_data, j * 3) == TK_LPAREN()) { pd = pd + 1; }
                    if (vec_int_get(tr.int_data, j * 3) == TK_RPAREN()) { pd = pd - 1; }
                    if (pd > 0 && vec_string_get(tr.lexemes, j) == var_name) {
                        return 1;
                    }
                    j = j + 1;
                }
            }
        }
        i = i - 1;
    }
    return 0;
}

// Best-effort local detection for function-typed variables declared as:
//   let name: fn(...) -> ...
fn is_local_fn_var(tr: Translator, name: string) -> bool {
    let i = tr.pos - 1;
    let depth = 0;
    while (i >= 0) {
        let k = vec_int_get(tr.int_data, i * 3);
        if (k == TK_RBRACE()) { depth = depth + 1; }
        if (k == TK_LBRACE()) {
            if (depth == 0) { break; }
            depth = depth - 1;
        }
        i = i - 1;
    }

    let start = i + 1;
    let j = start;
    while (j < tr.pos) {
        let k = vec_int_get(tr.int_data, j * 3);
        // Pattern: name: fn(...)  (covers function parameters and typed locals)
        if (vec_string_get(tr.lexemes, j) == name) {
            let j1 = j + 1;
            let j2 = j1 + 1;
            if (j2 < tr.pos) {
                if (vec_int_get(tr.int_data, j1 * 3) == TK_COLON() && vec_int_get(tr.int_data, j2 * 3) == TK_KW_FN()) {
                    return true;
                }
            }
        }
        if (k == TK_KW_LET()) {
            let j1 = j + 1;
            if (j1 < tr.pos && vec_string_get(tr.lexemes, j1) == name) {
                let j2 = j1 + 1;
                let j3 = j2 + 1;
                if (j3 < tr.pos) {
                    if (vec_int_get(tr.int_data, j2 * 3) == TK_COLON() && vec_int_get(tr.int_data, j3 * 3) == TK_KW_FN()) {
                        return true;
                    }
                }

                // Pattern: let name = |...| or let name: Type = |...|
                let j4 = j3 + 1;
                if (j4 < tr.pos) {
                    if (vec_int_get(tr.int_data, j2 * 3) == TK_OP_ASSIGN()) {
                        let k_rhs = vec_int_get(tr.int_data, j3 * 3);
                        if (k_rhs == TK_PIPE() || k_rhs == TK_OP_BIT_OR() || k_rhs == TK_OP_OR()) { return true; }
                    }
                    if (vec_int_get(tr.int_data, j3 * 3) == TK_OP_ASSIGN()) {
                        let k_rhs2 = vec_int_get(tr.int_data, j4 * 3);
                        if (k_rhs2 == TK_PIPE() || k_rhs2 == TK_OP_BIT_OR() || k_rhs2 == TK_OP_OR()) { return true; }
                    }
                }
            }
        }
        j = j + 1;
    }

    // Also check current function parameter list for: name: fn(...)
    let b = start - 1;
    if (b >= 0) {
        let fidx = b;
        // Find the fn keyword for the function DECLARATION (fn Name(...))
        // Skip fn keywords that are type annotations (fn followed by '(' directly)
        while (fidx >= 0) {
            if (vec_int_get(tr.int_data, fidx * 3) == TK_KW_FN()) {
                let fnext = fidx + 1;
                if (fnext < tr.count && vec_int_get(tr.int_data, fnext * 3) == TK_IDENTIFIER()) {
                    break;
                }
            }
            fidx = fidx - 1;
        }
        if (fidx >= 0) {
            let p = fidx;
            while (p < start && vec_int_get(tr.int_data, p * 3) != TK_LPAREN()) { p = p + 1; }
            if (p < start && vec_int_get(tr.int_data, p * 3) == TK_LPAREN()) {
                p = p + 1;
                let depthp = 1;
                while (p < start && depthp > 0) {
                    let kp = vec_int_get(tr.int_data, p * 3);
                    if (kp == TK_LPAREN()) { depthp = depthp + 1; }
                    if (kp == TK_RPAREN()) { depthp = depthp - 1; }
                    if (depthp == 1 && vec_string_get(tr.lexemes, p) == name) {
                        let c1 = p + 1;
                        let c2 = c1 + 1;
                        if (c2 < start) {
                            if (vec_int_get(tr.int_data, c1 * 3) == TK_COLON() && vec_int_get(tr.int_data, c2 * 3) == TK_KW_FN()) {
                                return true;
                            }
                        }
                    }
                    p = p + 1;
                }
            }
        }
    }
    // Check sema flag for captured closure variables (use sema_get != "" because
    // sema_has only checks key existence, not value; cleared flags have value "")
    if (sema_get(tr, str_concat("localfn:", name)) != "") { return true; }
    // Fallback: if name is a local variable (let name = ... OR let (name, ...) = ...) and NOT a known top-level function, treat as fn pointer
    if (!sema_has(tr, str_concat("f:", str_concat(name, ":ret")))) {
        let lj = start;
        while (lj < tr.pos) {
            if (vec_int_get(tr.int_data, lj * 3) == TK_KW_LET()) {
                let lj1 = lj + 1;
                if (lj1 < tr.pos && vec_string_get(tr.lexemes, lj1) == name) {
                    return true;
                }
                // Tuple destructuring: let (name1, name2, ...) = ...
                if (lj1 < tr.pos && vec_int_get(tr.int_data, lj1 * 3) == TK_LPAREN()) {
                    let lj2 = lj1 + 1;
                    while (lj2 < tr.pos && vec_int_get(tr.int_data, lj2 * 3) != TK_RPAREN()) {
                        if (vec_string_get(tr.lexemes, lj2) == name) { return true; }
                        lj2 = lj2 + 1;
                    }
                }
            }
            lj = lj + 1;
        }
    }
    return false;
}

// Best-effort local typed-variable lookup for patterns like:
//   let var_name: TypeName = ...
fn lookup_local_var_type_name(tr: Translator, var_name: string) -> string {
    // Scan backward to find the function body's opening { (skip all nested blocks)
    let i = tr.pos - 1;
    let depth = 0;
    let fn_start = 0;
    while (i >= 0) {
        let k = vec_int_get(tr.int_data, i * 3);
        if (k == TK_RBRACE()) { depth = depth + 1; }
        if (k == TK_LBRACE()) {
            if (depth <= 0) { fn_start = i + 1; }
            depth = depth - 1;
        }
        if (k == TK_KW_FN()) {
            // Only break on actual fn declarations (fn NAME), not fn type annotations (fn()
            let ni = i + 1;
            if (ni < tr.count && vec_int_get(tr.int_data, ni * 3) == TK_IDENTIFIER()) {
                break;
            }
        }
        i = i - 1;
    }

    let j = fn_start;
    while (j < tr.pos) {
        let k = vec_int_get(tr.int_data, j * 3);
        if (k == TK_KW_LET()) {
            let j1 = j + 1;
            if (j1 < tr.pos && vec_string_get(tr.lexemes, j1) == var_name) {
                let j2 = j1 + 1;
                let j3 = j2 + 1;
                if (j3 < tr.pos && vec_int_get(tr.int_data, j2 * 3) == TK_COLON()) {
                    if (vec_int_get(tr.int_data, j3 * 3) == TK_KW_DYN()) {
                        let j4 = j3 + 1;
                        if (j4 < tr.pos && vec_int_get(tr.int_data, j4 * 3) == TK_IDENTIFIER()) {
                            return str_concat("dyn:", vec_string_get(tr.lexemes, j4));
                        }
                        return "dyn:";
                    }
                    if (vec_int_get(tr.int_data, j3 * 3) == TK_LBRACKET()) {
                        return "[array]";
                    }
                    if (vec_int_get(tr.int_data, j3 * 3) == TK_IDENTIFIER()) {
                        return vec_string_get(tr.lexemes, j3);
                    }
                }
                // Detect untyped array init: let name = [...]
                if (j3 < tr.count && vec_int_get(tr.int_data, j2 * 3) == TK_OP_ASSIGN()) {
                    if (vec_int_get(tr.int_data, j3 * 3) == TK_LBRACKET()) {
                        return "[array]";
                    }
                }
            }
        }
        j = j + 1;
    }

    // Also check function parameters: scan forward from the fn keyword found above.
    // Use 'i' which points at the fn keyword (or <0 if not found).
    if (i >= 0 && vec_int_get(tr.int_data, i * 3) == TK_KW_FN()) {
        // Skip fn NAME and optional generic params to find (
        let pi = i + 1;
        // Skip function name
        if (pi < tr.count && vec_int_get(tr.int_data, pi * 3) == TK_IDENTIFIER()) { pi = pi + 1; }
        // Skip generic params <T, U>
        if (pi < tr.count && vec_int_get(tr.int_data, pi * 3) == TK_OP_LT()) {
            let gd = 1;
            pi = pi + 1;
            while (pi < tr.count && gd > 0) {
                if (vec_int_get(tr.int_data, pi * 3) == TK_OP_LT()) { gd = gd + 1; }
                if (vec_int_get(tr.int_data, pi * 3) == TK_OP_GT()) { gd = gd - 1; }
                pi = pi + 1;
            }
        }
        // Now pi should be at ( of the parameter list
        if (pi < tr.count && vec_int_get(tr.int_data, pi * 3) == TK_LPAREN()) {
            let pd = 1;
            pi = pi + 1;
            while (pi < tr.count && pd > 0) {
                if (vec_int_get(tr.int_data, pi * 3) == TK_LPAREN()) { pd = pd + 1; }
                if (vec_int_get(tr.int_data, pi * 3) == TK_RPAREN()) { pd = pd - 1; }
                if (pd == 1 && vec_int_get(tr.int_data, pi * 3) == TK_IDENTIFIER()) {
                    if (vec_string_get(tr.lexemes, pi) == var_name) {
                        let pi2 = pi + 1;
                        if (pi2 < tr.count && vec_int_get(tr.int_data, pi2 * 3) == TK_COLON()) {
                            let pi3 = pi2 + 1;
                            if (pi3 < tr.count) {
                                if (vec_int_get(tr.int_data, pi3 * 3) == TK_KW_DYN()) {
                                    let pi4 = pi3 + 1;
                                    if (pi4 < tr.count && vec_int_get(tr.int_data, pi4 * 3) == TK_IDENTIFIER()) {
                                        return str_concat("dyn:", vec_string_get(tr.lexemes, pi4));
                                    }
                                    return "dyn:";
                                }
                                if (vec_int_get(tr.int_data, pi3 * 3) == TK_LBRACKET()) {
                                    return "[array]";
                                }
                                if (vec_int_get(tr.int_data, pi3 * 3) == TK_IDENTIFIER()) {
                                    return vec_string_get(tr.lexemes, pi3);
                                }
                            }
                        }
                    }
                }
                pi = pi + 1;
            }
        }
    }
    return "";
}

// Look up the concrete type assigned to a dyn variable.
// For: let dc: dyn Shape = c;  where c: Circle  → returns "Circle"
fn lookup_dyn_concrete_type(tr: Translator, var_name: string) -> string {
    let i = tr.pos - 1;
    let depth = 0;
    while (i >= 0) {
        let k = vec_int_get(tr.int_data, i * 3);
        if (k == TK_RBRACE()) { depth = depth + 1; }
        if (k == TK_LBRACE()) {
            if (depth == 0) { break; }
            depth = depth - 1;
        }
        i = i - 1;
    }
    let start = i + 1;
    let j = start;
    while (j < tr.pos) {
        let k = vec_int_get(tr.int_data, j * 3);
        if (k == TK_KW_LET()) {
            let j1 = j + 1;
            if (j1 < tr.pos && vec_string_get(tr.lexemes, j1) == var_name) {
                // Found let var_name — scan for = and get the RHS identifier
                let jx = j1 + 1;
                while (jx < tr.pos && vec_int_get(tr.int_data, jx * 3) != TK_OP_ASSIGN()) {
                    if (vec_int_get(tr.int_data, jx * 3) == TK_SEMICOLON()) { break; }
                    jx = jx + 1;
                }
                if (jx < tr.pos && vec_int_get(tr.int_data, jx * 3) == TK_OP_ASSIGN()) {
                    let rhs = jx + 1;
                    if (rhs < tr.pos && vec_int_get(tr.int_data, rhs * 3) == TK_IDENTIFIER()) {
                        let rhs_name = vec_string_get(tr.lexemes, rhs);
                        // Check if RHS is a struct literal: Name { ... }
                        let rhs2 = rhs + 1;
                        if (rhs2 < tr.pos && vec_int_get(tr.int_data, rhs2 * 3) == TK_LBRACE()) {
                            return rhs_name;
                        }
                        // RHS is a variable — look up its type
                        let rhs_type = lookup_local_var_type_name(tr, rhs_name);
                        if (rhs_type != "" && str_char_at(rhs_type, 0) >= 65 && str_char_at(rhs_type, 0) <= 90) {
                            return rhs_type;
                        }
                        // RHS might be untyped let — check if it was initialized from a struct literal
                        let rj = start;
                        while (rj < tr.pos) {
                            if (vec_int_get(tr.int_data, rj * 3) == TK_KW_LET()) {
                                let rj1 = rj + 1;
                                if (rj1 < tr.pos && vec_string_get(tr.lexemes, rj1) == rhs_name) {
                                    let rx = rj1 + 1;
                                    while (rx < tr.pos && vec_int_get(tr.int_data, rx * 3) != TK_OP_ASSIGN() && vec_int_get(tr.int_data, rx * 3) != TK_SEMICOLON()) { rx = rx + 1; }
                                    if (rx < tr.pos && vec_int_get(tr.int_data, rx * 3) == TK_OP_ASSIGN()) {
                                        let rx1 = rx + 1;
                                        if (rx1 < tr.pos && vec_int_get(tr.int_data, rx1 * 3) == TK_IDENTIFIER()) {
                                            let rx2 = rx1 + 1;
                                            if (rx2 < tr.pos && vec_int_get(tr.int_data, rx2 * 3) == TK_LBRACE()) {
                                                return vec_string_get(tr.lexemes, rx1);
                                            }
                                        }
                                    }
                                }
                            }
                            rj = rj + 1;
                        }
                    }
                }
            }
        }
        j = j + 1;
    }
    return "";
}

// Detect whether a top-level function declaration is generic: fn name<...>(...)
fn is_generic_top_level_fn_name(tr: Translator, fn_name: string) -> bool {
    let i = 0;
    while (i + 2 < tr.count) {
        if (vec_int_get(tr.int_data, i * 3) == TK_KW_FN()) {
            let i1 = i + 1;
            if (vec_int_get(tr.int_data, i1 * 3) == TK_IDENTIFIER() && vec_string_get(tr.lexemes, i1) == fn_name) {
                let i2 = i1 + 1;
                if (i2 < tr.count && vec_int_get(tr.int_data, i2 * 3) == TK_OP_LT()) { return true; }
                return false;
            }
        }
        i = i + 1;
    }
    return false;
}

// Best-effort local detection for variables initialized from generic function calls:
//   let x = generic_fn(...);
fn is_local_generic_call_var(tr: Translator, name: string) -> bool {
    let i = tr.pos - 1;
    let depth = 0;
    while (i >= 0) {
        let k = vec_int_get(tr.int_data, i * 3);
        if (k == TK_RBRACE()) { depth = depth + 1; }
        if (k == TK_LBRACE()) {
            if (depth == 0) { break; }
            depth = depth - 1;
        }
        i = i - 1;
    }

    let start = i + 1;
    let j = start;
    while (j < tr.pos) {
        if (vec_int_get(tr.int_data, j * 3) == TK_KW_LET()) {
            let j1 = j + 1;
            if (j1 < tr.pos && vec_string_get(tr.lexemes, j1) == name) {
                let p = j1 + 1;
                // Skip optional type annotation
                if (p < tr.pos && vec_int_get(tr.int_data, p * 3) == TK_COLON()) {
                    p = p + 1;
                    let pd = 0;
                    let bd = 0;
                    let sd = 0;
                    while (p < tr.pos) {
                        let kk = vec_int_get(tr.int_data, p * 3);
                        if (kk == TK_LPAREN()) { pd = pd + 1; }
                        if (kk == TK_RPAREN() && pd > 0) { pd = pd - 1; }
                        if (kk == TK_LBRACE()) { bd = bd + 1; }
                        if (kk == TK_RBRACE() && bd > 0) { bd = bd - 1; }
                        if (kk == TK_LBRACKET()) { sd = sd + 1; }
                        if (kk == TK_RBRACKET() && sd > 0) { sd = sd - 1; }
                        if (pd == 0 && bd == 0 && sd == 0 && kk == TK_OP_ASSIGN()) { break; }
                        p = p + 1;
                    }
                }

                if (p < tr.pos && vec_int_get(tr.int_data, p * 3) == TK_OP_ASSIGN()) {
                    let rhs = p + 1;
                    if (rhs < tr.pos && vec_int_get(tr.int_data, rhs * 3) == TK_IDENTIFIER()) {
                        let rhs_call = rhs + 1;
                        if (rhs_call < tr.pos && vec_int_get(tr.int_data, rhs_call * 3) == TK_OP_LT()) {
                            let gd = 1;
                            rhs_call = rhs_call + 1;
                            while (rhs_call < tr.pos && gd > 0) {
                                let gk = vec_int_get(tr.int_data, rhs_call * 3);
                                if (gk == TK_OP_LT()) { gd = gd + 1; }
                                if (gk == TK_OP_GT()) { gd = gd - 1; }
                                rhs_call = rhs_call + 1;
                            }
                        }
                        if (rhs_call < tr.pos && vec_int_get(tr.int_data, rhs_call * 3) == TK_LPAREN()) {
                        let callee = vec_string_get(tr.lexemes, rhs);
                        if (is_generic_top_level_fn_name(tr, callee)) { return true; }
                        }
                    }
                }
            }
        }
        j = j + 1;
    }
    return false;
}

// Detect if an identifier refers to a top-level function declaration.
fn is_top_level_fn_name(tr: Translator, name: string) -> bool {
    let i = 0;
    while (i + 1 < tr.count) {
        let k = vec_int_get(tr.int_data, i * 3);
        if (k == TK_KW_FN()) {
            let i1 = i + 1;
            if (i1 < tr.count && vec_int_get(tr.int_data, i1 * 3) == TK_IDENTIFIER()) {
                if (vec_string_get(tr.lexemes, i1) == name) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// Translate Result
// ---------------------------------------------------------------------------

pub struct TranslateResult {
    errors: int;
    success: bool;
}

// ---------------------------------------------------------------------------
// Semantic registry — pre-pass to collect type information
// ---------------------------------------------------------------------------

// Sema key conventions:
//   "t:Trait:method"        → return C type of trait method
//   "t:Trait:method:params" → "type1,type2" param types
//   "i:Type:Trait"          → "1" if impl exists
//   "i:Type:Trait:method"   → "kr_Type_method" mangled name
//   "s:Struct:field"        → field C type
//   "s:Struct:fields"       → "field1,field2,..." ordered field names
//   "f:fn_name:ret"         → return C type
//   "f:fn_name:params"      → "name1:type1,name2:type2"
//   "f:fn_name:generic"     → "1" if generic

fn sema_set(tr: Translator, key: string, val: string) -> void {
    map_string_string_set(tr.sema, key, val);
}

fn sema_get(tr: Translator, key: string) -> string {
    return map_string_string_get(tr.sema, key);
}

fn sema_has(tr: Translator, key: string) -> bool {
    return map_string_string_has(tr.sema, key) == 1;
}

fn build_sema_registry(tr: Translator) -> Translator {
    let c: Translator = tr;
    let i = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);

        // --- Trait declarations: trait Name { fn method(self) -> Ret; ... } ---
        if (k == TK_KW_TRAIT()) {
            let i1 = i + 1;
            if (i1 < c.count && vec_int_get(c.int_data, i1 * 3) == TK_IDENTIFIER()) {
                let trait_name = vec_string_get(c.lexemes, i1);
                let ti = i1 + 1;
                // Skip generic params
                if (ti < c.count && vec_int_get(c.int_data, ti * 3) == TK_OP_LT()) {
                    let gd = 1; ti = ti + 1;
                    while (ti < c.count && gd > 0) {
                        if (vec_int_get(c.int_data, ti * 3) == TK_OP_LT()) { gd = gd + 1; }
                        if (vec_int_get(c.int_data, ti * 3) == TK_OP_GT()) { gd = gd - 1; }
                        ti = ti + 1;
                    }
                }
                // Expect {
                if (ti < c.count && vec_int_get(c.int_data, ti * 3) == TK_LBRACE()) {
                    ti = ti + 1;
                    let methods = "";
                    while (ti < c.count && vec_int_get(c.int_data, ti * 3) != TK_RBRACE()) {
                        if (vec_int_get(c.int_data, ti * 3) == TK_KW_FN()) {
                            ti = ti + 1;
                            if (ti < c.count) {
                                let mname = vec_string_get(c.lexemes, ti);
                                // Collect extra parameters beyond self
                                let mi = ti + 1;
                                let extra_params = "";
                                if (mi < c.count && vec_int_get(c.int_data, mi * 3) == TK_LPAREN()) {
                                    mi = mi + 1;
                                    // Skip self
                                    while (mi < c.count && vec_int_get(c.int_data, mi * 3) != TK_COMMA() && vec_int_get(c.int_data, mi * 3) != TK_RPAREN()) { mi = mi + 1; }
                                    if (mi < c.count && vec_int_get(c.int_data, mi * 3) == TK_COMMA()) {
                                        mi = mi + 1;
                                        // Collect remaining params: name: Type, ...
                                        while (mi < c.count && vec_int_get(c.int_data, mi * 3) != TK_RPAREN()) {
                                            let pnm = vec_string_get(c.lexemes, mi); mi = mi + 1;
                                            if (mi < c.count && vec_int_get(c.int_data, mi * 3) == TK_COLON()) {
                                                mi = mi + 1;
                                                if (mi < c.count) {
                                                    let ptk = vec_int_get(c.int_data, mi * 3);
                                                    let pty = type_to_c(ptk, vec_string_get(c.lexemes, mi));
                                                    if (ptk == TK_IDENTIFIER() && strlen(vec_string_get(c.lexemes, mi)) > 0) {
                                                        let pch = str_char_at(vec_string_get(c.lexemes, mi), 0);
                                                        if (pch >= 65 && pch <= 90) {
                                                            if (vec_string_get(c.lexemes, mi) == "Self") { pty = "void*"; }
                                                            else { pty = vec_string_get(c.lexemes, mi); }
                                                        }
                                                    }
                                                    if (extra_params != "") { extra_params = str_concat(extra_params, ","); }
                                                    extra_params = str_concat(extra_params, str_concat(pnm, str_concat(":", pty)));
                                                    mi = mi + 1;
                                                }
                                            }
                                            if (mi < c.count && vec_int_get(c.int_data, mi * 3) == TK_COMMA()) { mi = mi + 1; }
                                        }
                                    }
                                    if (mi < c.count && vec_int_get(c.int_data, mi * 3) == TK_RPAREN()) { mi = mi + 1; }
                                }
                                // Find return type
                                let ret_c = "int64_t";
                                while (mi < c.count && vec_int_get(c.int_data, mi * 3) != TK_SEMICOLON() && vec_int_get(c.int_data, mi * 3) != TK_LBRACE()) {
                                    if (vec_int_get(c.int_data, mi * 3) == TK_ARROW()) {
                                        let mi2 = mi + 1;
                                        if (mi2 < c.count) {
                                            ret_c = type_to_c(vec_int_get(c.int_data, mi2 * 3), vec_string_get(c.lexemes, mi2));
                                        }
                                    }
                                    mi = mi + 1;
                                }
                                sema_set(c, str_concat("t:", str_concat(trait_name, str_concat(":", mname))), ret_c);
                                if (extra_params != "") {
                                    sema_set(c, str_concat("t:", str_concat(trait_name, str_concat(":", str_concat(mname, ":params")))), extra_params);
                                }
                                // Store default method body position if present
                                if (mi < c.count && vec_int_get(c.int_data, mi * 3) == TK_LBRACE()) {
                                    sema_set(c, str_concat("t:", str_concat(trait_name, str_concat(":", str_concat(mname, ":default_pos")))), fmt_int(mi));
                                    // Skip past the body block
                                    let bd = 1; mi = mi + 1;
                                    while (mi < c.count && bd > 0) {
                                        if (vec_int_get(c.int_data, mi * 3) == TK_LBRACE()) { bd = bd + 1; }
                                        if (vec_int_get(c.int_data, mi * 3) == TK_RBRACE()) { bd = bd - 1; }
                                        mi = mi + 1;
                                    }
                                }
                                if (methods != "") { methods = str_concat(methods, ","); }
                                methods = str_concat(methods, mname);
                                ti = mi;
                            }
                        } else { ti = ti + 1; }
                    }
                    sema_set(c, str_concat("t:", str_concat(trait_name, ":_methods")), methods);
                }
            }
        }

        // --- Impl blocks: impl Trait for Type { ... } or impl Type { ... } ---
        if (k == TK_KW_IMPL()) {
            let i1 = i + 1;
            if (i1 < c.count && vec_int_get(c.int_data, i1 * 3) == TK_IDENTIFIER()) {
                let first_name = vec_string_get(c.lexemes, i1);
                let ii = i1 + 1;
                // Skip generic params on first name
                if (ii < c.count && vec_int_get(c.int_data, ii * 3) == TK_OP_LT()) {
                    let gd = 1; ii = ii + 1;
                    while (ii < c.count && gd > 0) {
                        if (vec_int_get(c.int_data, ii * 3) == TK_OP_LT()) { gd = gd + 1; }
                        if (vec_int_get(c.int_data, ii * 3) == TK_OP_GT()) { gd = gd - 1; }
                        ii = ii + 1;
                    }
                }
                let trait_name = "";
                let type_name = first_name;
                // Check for "for Type" pattern
                if (ii < c.count && vec_string_get(c.lexemes, ii) == "for") {
                    trait_name = first_name;
                    ii = ii + 1;
                    if (ii < c.count && vec_int_get(c.int_data, ii * 3) == TK_IDENTIFIER()) {
                        type_name = vec_string_get(c.lexemes, ii);
                        ii = ii + 1;
                    }
                }
                if (trait_name != "") {
                    sema_set(c, str_concat("i:", str_concat(type_name, str_concat(":", trait_name))), "1");
                }
                // Skip generic params on type
                if (ii < c.count && vec_int_get(c.int_data, ii * 3) == TK_OP_LT()) {
                    let gd = 1; ii = ii + 1;
                    while (ii < c.count && gd > 0) {
                        if (vec_int_get(c.int_data, ii * 3) == TK_OP_LT()) { gd = gd + 1; }
                        if (vec_int_get(c.int_data, ii * 3) == TK_OP_GT()) { gd = gd - 1; }
                        ii = ii + 1;
                    }
                }
                // Scan methods in impl body
                if (ii < c.count && vec_int_get(c.int_data, ii * 3) == TK_LBRACE()) {
                    ii = ii + 1;
                    let bd = 1;
                    while (ii < c.count && bd > 0) {
                        let ik = vec_int_get(c.int_data, ii * 3);
                        if (ik == TK_LBRACE()) { bd = bd + 1; }
                        if (ik == TK_RBRACE()) { bd = bd - 1; if (bd == 0) { break; } }
                        if (bd == 1 && ik == TK_KW_FN()) {
                            let ii2 = ii + 1;
                            if (ii2 < c.count) {
                                let mname = vec_string_get(c.lexemes, ii2);
                                let mangled = str_concat("kr_", str_concat(type_name, str_concat("_", mname)));
                                if (trait_name != "") {
                                    sema_set(c, str_concat("i:", str_concat(type_name, str_concat(":", str_concat(trait_name, str_concat(":", mname))))), mangled);
                                }
                                sema_set(c, str_concat("i:", str_concat(type_name, str_concat("::", mname))), mangled);
                                // Scan for return type
                                let ri = ii2 + 1;
                                let ret_c = "void";
                                while (ri < c.count && vec_int_get(c.int_data, ri * 3) != TK_LBRACE()) {
                                    if (vec_int_get(c.int_data, ri * 3) == TK_ARROW()) {
                                        let ri2 = ri + 1;
                                        if (ri2 < c.count) {
                                            ret_c = type_to_c(vec_int_get(c.int_data, ri2 * 3), vec_string_get(c.lexemes, ri2));
                                        }
                                    }
                                    ri = ri + 1;
                                }
                                sema_set(c, str_concat("i:", str_concat(type_name, str_concat("::", str_concat(mname, ":ret")))), ret_c);
                            }
                        }
                        ii = ii + 1;
                    }
                }
            }
        }

        // --- Struct declarations: struct Name { field: Type, ... } ---
        if (k == TK_KW_STRUCT()) {
            let i1 = i + 1;
            if (i1 < c.count && vec_int_get(c.int_data, i1 * 3) == TK_IDENTIFIER()) {
                let sname = vec_string_get(c.lexemes, i1);
                let si = i1 + 1;
                // Skip generics
                if (si < c.count && vec_int_get(c.int_data, si * 3) == TK_OP_LT()) {
                    let gd = 1; si = si + 1;
                    while (si < c.count && gd > 0) {
                        if (vec_int_get(c.int_data, si * 3) == TK_OP_LT()) { gd = gd + 1; }
                        if (vec_int_get(c.int_data, si * 3) == TK_OP_GT()) { gd = gd - 1; }
                        si = si + 1;
                    }
                }
                if (si < c.count && vec_int_get(c.int_data, si * 3) == TK_LBRACE()) {
                    si = si + 1;
                    let fields = "";
                    while (si < c.count && vec_int_get(c.int_data, si * 3) != TK_RBRACE()) {
                        if (vec_int_get(c.int_data, si * 3) == TK_IDENTIFIER()) {
                            let fname = vec_string_get(c.lexemes, si);
                            let si2 = si + 1;
                            if (si2 < c.count && vec_int_get(c.int_data, si2 * 3) == TK_COLON()) {
                                let si3 = si2 + 1;
                                if (si3 < c.count) {
                                    let ftype = type_to_c(vec_int_get(c.int_data, si3 * 3), vec_string_get(c.lexemes, si3));
                                    sema_set(c, str_concat("s:", str_concat(sname, str_concat(":", fname))), ftype);
                                    if (fields != "") { fields = str_concat(fields, ","); }
                                    fields = str_concat(fields, fname);
                                }
                            }
                        }
                        si = si + 1;
                    }
                    sema_set(c, str_concat("s:", str_concat(sname, ":_fields")), fields);
                }
            }
        }

        // --- Function declarations: fn name(...) -> Ret { ... } ---
        if (k == TK_KW_FN()) {
            let i1 = i + 1;
            if (i1 < c.count && vec_int_get(c.int_data, i1 * 3) == TK_IDENTIFIER()) {
                let fname = vec_string_get(c.lexemes, i1);
                let fi = i1 + 1;
                let is_generic = 0;
                if (fi < c.count && vec_int_get(c.int_data, fi * 3) == TK_OP_LT()) {
                    is_generic = 1;
                    let gd = 1; fi = fi + 1;
                    while (fi < c.count && gd > 0) {
                        if (vec_int_get(c.int_data, fi * 3) == TK_OP_LT()) { gd = gd + 1; }
                        if (vec_int_get(c.int_data, fi * 3) == TK_OP_GT()) { gd = gd - 1; }
                        fi = fi + 1;
                    }
                }
                if (is_generic == 1) {
                    sema_set(c, str_concat("f:", str_concat(fname, ":generic")), "1");
                }
                // Skip to end of params to find ->
                if (fi < c.count && vec_int_get(c.int_data, fi * 3) == TK_LPAREN()) {
                    let pd = 1; fi = fi + 1;
                    // Collect params
                    let params_str = "";
                    while (fi < c.count && pd > 0) {
                        if (vec_int_get(c.int_data, fi * 3) == TK_LPAREN()) { pd = pd + 1; }
                        if (vec_int_get(c.int_data, fi * 3) == TK_RPAREN()) { pd = pd - 1; if (pd == 0) { fi = fi + 1; break; } }
                        // Collect param name:type pairs at depth 1
                        if (pd == 1 && vec_int_get(c.int_data, fi * 3) == TK_IDENTIFIER()) {
                            let pname = vec_string_get(c.lexemes, fi);
                            let pi2 = fi + 1;
                            if (pi2 < c.count && vec_int_get(c.int_data, pi2 * 3) == TK_COLON()) {
                                let pi3 = pi2 + 1;
                                if (pi3 < c.count) {
                                    let ptype = vec_string_get(c.lexemes, pi3);
                                    if (params_str != "") { params_str = str_concat(params_str, ","); }
                                    params_str = str_concat(params_str, str_concat(pname, str_concat(":", ptype)));
                                }
                            }
                        }
                        fi = fi + 1;
                    }
                    sema_set(c, str_concat("f:", str_concat(fname, ":params")), params_str);
                }
                // Check for -> RetType
                let ret_c = "void";
                if (fi < c.count && vec_int_get(c.int_data, fi * 3) == TK_ARROW()) {
                    let fi2 = fi + 1;
                    if (fi2 < c.count) {
                        ret_c = type_to_c(vec_int_get(c.int_data, fi2 * 3), vec_string_get(c.lexemes, fi2));
                    }
                }
                sema_set(c, str_concat("f:", str_concat(fname, ":ret")), ret_c);
            }
        }

        i = i + 1;
    }
    return c;
}

// ---------------------------------------------------------------------------
// Entry point: translate token stream to C source
// ---------------------------------------------------------------------------

pub fn translate(int_data: VecInt, lexemes: VecString, token_count: int, file: string, target: Target, out: VecString) -> TranslateResult {
    let tr: Translator = new_translator(token_count, file, int_data, lexemes, out);

    // Phase 0: build semantic registry (traits, impls, structs, fn sigs)
    tr = build_sema_registry(tr);

    // Emit C preamble (platform-aware)
    tr_emit(tr, emit_c_preamble(target));
    tr_emit(tr, "\n");

    // First pass: forward declarations
    tr = emit_forward_decls(tr);
    tr = tr_reset_pos(tr);

    // Second pass: emit struct definitions and function bodies
    tr = translate_program(tr);

    // Emit C main() entry point wrapper
    tr_emit(tr, "\nint main(int argc, char* argv[]) {\n");
    tr_emit(tr, "    kr_main();\n");
    tr_emit(tr, "    return 0;\n");
    tr_emit(tr, "}\n");

    return TranslateResult { errors: tr.errors, success: tr.errors == 0 };
}

// ---------------------------------------------------------------------------
// Forward declarations pass
// ---------------------------------------------------------------------------

fn emit_forward_decls(tr: Translator) -> Translator {
    let c: Translator = tr;
    tr_emit_line(c, "/* Forward declarations */");

    // Sub-pass 1: emit ALL struct/enum typedefs first
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_KW_PUB()) {
            c = tr_advance(c);
            let k2 = tr_kind(c);
            if (k2 == TK_KW_STRUCT()) {
                c = tr_advance(c);
                let name = tr_lexeme(c);
                tr_emit_line(c, str_concat(str_concat("typedef struct ", name), str_concat(" ", str_concat(name, ";"))));
                c = tr_advance(c); c = skip_generic_params(c);
            } else {
                if (k2 == TK_KW_UNION()) {
                    c = tr_advance(c);
                    let name = tr_lexeme(c);
                    tr_emit_line(c, str_concat(str_concat("typedef union ", name), str_concat(" ", str_concat(name, ";"))));
                    c = tr_advance(c); c = skip_generic_params(c);
                } else {
                if (k2 == TK_KW_ENUM()) {
                    c = tr_advance(c);
                    let name = tr_lexeme(c);
                    tr_emit_line(c, str_concat("typedef int64_t ", str_concat(name, ";")));
                    c = tr_advance(c); c = skip_generic_params(c);
                } else { c = tr_advance(c); }
                }
            }
        } else {
            if (k == TK_KW_STRUCT()) {
                c = tr_advance(c);
                let name = tr_lexeme(c);
                tr_emit_line(c, str_concat(str_concat("typedef struct ", name), str_concat(" ", str_concat(name, ";"))));
                c = tr_advance(c); c = skip_generic_params(c);
            } else {
                if (k == TK_KW_UNION()) {
                    c = tr_advance(c);
                    let name = tr_lexeme(c);
                    tr_emit_line(c, str_concat(str_concat("typedef union ", name), str_concat(" ", str_concat(name, ";"))));
                    c = tr_advance(c); c = skip_generic_params(c);
                } else {
                if (k == TK_KW_ENUM()) {
                    c = tr_advance(c);
                    let name = tr_lexeme(c);
                    tr_emit_line(c, str_concat("typedef int64_t ", str_concat(name, ";")));
                    c = tr_advance(c); c = skip_generic_params(c);
                } else { c = tr_advance(c); }
                }
            }
        }
    }

    // Sub-pass 2: emit ALL function prototypes (including impl methods)
    c = tr_reset_pos(c);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_KW_PUB()) {
            c = tr_advance(c);
            let k2 = tr_kind(c);
            if (k2 == TK_KW_FN()) {
                c = emit_fn_prototype(c);
            } else {
                if (k2 == TK_KW_IMPL()) { c = emit_impl_prototypes(c); }
                else {
                    if (k2 == TK_KW_TRAIT()) {
                        let c2: Translator = tr_advance(c);
                        let tname = tr_lexeme(c2);
                        tr_emit_line(c2, str_concat("typedef void* ", str_concat(tname, ";")));
                        c = tr_advance(c2);
                        c = skip_generic_params(c);
                        c = skip_brace_block(c);
                    } else {
                        if (k2 == TK_KW_STRUCT() || k2 == TK_KW_UNION() || k2 == TK_KW_ENUM()) {
                            c = tr_advance(c); c = skip_brace_block(tr_advance(c));
                        } else {
                            if (k2 == TK_KW_TYPE()) {
                                c = translate_type_alias(c);
                            } else {
                                if (k2 == TK_KW_CONST()) {
                                    let c2: Translator = tr_advance(c);
                                    if (!tr_at_end(c2) && tr_kind(c2) == TK_KW_FN()) {
                                        c = emit_fn_prototype(c2);
                                    } else {
                                        c = translate_const_decl(c);
                                    }
                                } else { c = tr_advance(c); }
                            }
                        }
                    }
                }
            }
        } else {
            if (tr_lexeme(c) == "extern") {
                while (!tr_at_end(c) && tr_kind(c) != TK_SEMICOLON()) { c = tr_advance(c); }
                if (!tr_at_end(c)) { c = tr_advance(c); }
            } else {
                if (k == TK_KW_FN()) {
                c = emit_fn_prototype(c);
            } else {
                if (k == TK_KW_IMPL()) { c = emit_impl_prototypes(c); }
                else {
                    if (k == TK_KW_TRAIT()) {
                        let c2: Translator = tr_advance(c);
                        let tname = tr_lexeme(c2);
                        tr_emit_line(c2, str_concat("typedef void* ", str_concat(tname, ";")));
                        c = tr_advance(c2);
                        c = skip_generic_params(c);
                        c = skip_brace_block(c);
                    } else {
                        if (k == TK_KW_STRUCT() || k == TK_KW_UNION() || k == TK_KW_ENUM()) {
                            c = tr_advance(c); c = skip_brace_block(tr_advance(c));
                        } else {
                            if (k == TK_KW_TYPE()) {
                                c = translate_type_alias(c);
                            } else {
                                if (k == TK_KW_CONST()) {
                                    let c2: Translator = tr_advance(c);
                                    if (!tr_at_end(c2) && tr_kind(c2) == TK_KW_FN()) {
                                        c = emit_fn_prototype(c2);
                                    } else {
                                        c = translate_const_decl(c);
                                    }
                                } else { c = tr_advance(c); }
                            }
                        }
                    }
                }
            }
            }
        }
    }

    tr_emit(c, "\n");
    return c;
}

fn emit_fn_prototype(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let fname = tr_lexeme(c);
    // Undefine preamble macro if user defines a function with the same name
    let mangled_check = mangle_top_level_fn_name(fname);
    if (fname == "test_section" || fname == "test_pass" || fname == "test_fail" || fname == "test_skip" || fname == "assert" || fname == "assert_eq" || fname == "assert_ne" || fname == "printf") {
        tr_emit_line(c, str_concat("#undef ", mangled_check));
    }
    c = tr_advance(c);
    let has_fn_generics = 0;
    if (!tr_at_end(c) && tr_kind(c) == TK_OP_LT()) { has_fn_generics = 1; }
    c = skip_generic_params(c);

    if (has_fn_generics == 1) {
        // Generic function: type-erased prototype (T → int64_t).
        if (!tr_at_end(c) && tr_kind(c) != TK_LPAREN()) {
            while (!tr_at_end(c) && tr_kind(c) != TK_LPAREN()) { c = tr_advance(c); }
        }
    }
    c = tr_advance(c);

    let params = "";
    let first = 1;
    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
        if (first == 0) { params = str_concat(params, ", "); c = tr_advance(c); }
        let p0 = tr_lexeme(c);
        if (p0 == "..." || p0 == "..") {
            params = str_concat(params, "...");
            while (!tr_at_end(c) && tr_kind(c) != TK_COMMA() && tr_kind(c) != TK_RPAREN()) { c = tr_advance(c); }
            first = 0;
            continue;
        }
        let pname = tr_lexeme(c);
        c = tr_advance(c);
        c = tr_advance(c);
        let ptype_kind = tr_kind(c);
        let ptype_name = tr_lexeme(c);
        c = tr_advance(c);
        if (ptype_kind == TK_OP_STAR()) {
            while (!tr_at_end(c) && tr_kind(c) != TK_COMMA() && tr_kind(c) != TK_RPAREN()) { c = tr_advance(c); }
            params = str_concat(params, str_concat("void* ", sanitize_c_name(pname)));
            first = 0;
            continue;
        }
        if (ptype_kind == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
        let pc = type_to_c(ptype_kind, ptype_name);
        if (ptype_kind == TK_LPAREN()) { pc = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
        c = skip_array_type_suffix(c, ptype_kind);
        c = skip_generic_params(c);
        if (ptype_kind == TK_KW_FN()) { c = skip_fn_type_sig(c); }
        if (ptype_kind == TK_LBRACKET()) { pc = "int64_t*"; }
        params = str_concat(params, str_concat(pc, str_concat(" ", sanitize_c_name(pname))));
        first = 0;
    }
    c = tr_advance(c);

    let ret_c = "void";
    if (!tr_at_end(c) && tr_kind(c) == TK_ARROW()) {
        c = tr_advance(c);
        let rk = tr_kind(c);
        let rn = tr_lexeme(c);
        ret_c = type_to_c(rk, rn);
        c = tr_advance(c);
        if (rk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
        if (rk == TK_LPAREN()) { ret_c = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
        c = skip_array_type_suffix(c, rk);
        c = skip_generic_params(c);
        if (rk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
    }

    // Skip where clause in prototype
    if (!tr_at_end(c) && tr_kind(c) == TK_KW_WHERE()) {
        while (!tr_at_end(c) && tr_kind(c) != TK_LBRACE()) { c = tr_advance(c); }
    }

    let mangled = mangle_top_level_fn_name(fname);
    tr_emit_line(c, str_concat(ret_c, str_concat(" ", str_concat(mangled, str_concat("(", str_concat(params, ");"))))));
    c = skip_brace_block(c);
    return c;
}

fn emit_impl_prototypes(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let type_name = tr_lexeme(c);
    c = tr_advance(c);
    c = skip_generic_params(c);
    if (!tr_at_end(c) && tr_lexeme(c) == "for") {
        c = tr_advance(c);
        if (!tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) {
            type_name = tr_lexeme(c);
            c = tr_advance(c);
        }
    }
    c = tr_advance(c);

    while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
        if (tr_kind(c) == TK_KW_PUB()) { c = tr_advance(c); }
        if (tr_kind(c) == TK_KW_FN()) {
            c = tr_advance(c);
            let fname = tr_lexeme(c);
            c = tr_advance(c);
            c = tr_advance(c);

            let params = "";
            let first = 1;
            while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                if (first == 0) { params = str_concat(params, ", "); c = tr_advance(c); }
                let pname = tr_lexeme(c);
                if (pname == "self") {
                    c = tr_advance(c);
                    if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
                        c = tr_advance(c);
                        if (!tr_at_end(c)) {
                            let sk = tr_kind(c); let sn = tr_lexeme(c);
                            c = tr_advance(c);
                            if (sk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
                            c = skip_generic_params(c);
                            if (sk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
                        }
                    }
                    params = str_concat(params, str_concat(type_name, " self"));
                } else {
                    c = tr_advance(c);
                    c = tr_advance(c);
                    let pk = tr_kind(c); let pn = tr_lexeme(c);
                    c = tr_advance(c);
                    if (pk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
                    let ipc = type_to_c(pk, pn);
                    if (pk == TK_LPAREN()) { ipc = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
                    c = skip_array_type_suffix(c, pk);
                    c = skip_generic_params(c);
                    if (pk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
                    if (pk == TK_LBRACKET()) { ipc = "int64_t*"; }
                    params = str_concat(params, str_concat(ipc, str_concat(" ", sanitize_c_name(pname))));
                }
                first = 0;
            }
            c = tr_advance(c);

            let ret_c = "void";
            if (!tr_at_end(c) && tr_kind(c) == TK_ARROW()) {
                c = tr_advance(c);
                let rk = tr_kind(c); let rn = tr_lexeme(c);
                ret_c = type_to_c(rk, rn); c = tr_advance(c);
                if (rk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
                if (rk == TK_LPAREN()) { ret_c = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
                c = skip_array_type_suffix(c, rk);
                c = skip_generic_params(c);
                if (rk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
            }

            let mangled = str_concat("kr_", str_concat(type_name, str_concat("_", fname)));
            tr_emit_line(c, str_concat(ret_c, str_concat(" ", str_concat(mangled, str_concat("(", str_concat(params, ");"))))));
            c = skip_brace_block(c);
        } else { c = tr_advance(c); }
    }
    if (!tr_at_end(c)) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// Closure extraction — emit static functions for all closure literals
// ---------------------------------------------------------------------------

fn emit_closure_statics(tr: Translator) -> Translator {
    let c: Translator = tr;
    // Pre-pass: emit forward declarations so nested closures can reference each other
    let fi = 0;
    while (fi < c.count) {
        let fk = vec_int_get(c.int_data, fi * 3);
        if (fk == TK_PIPE() || fk == TK_OP_BIT_OR() || fk == TK_OP_OR()) {
            let fprev = 0;
            if (fi > 0) { fprev = vec_int_get(c.int_data, (fi - 1) * 3); }
            if (fprev == TK_OP_ASSIGN() || fprev == TK_COMMA() || fprev == TK_LPAREN() || fprev == TK_LBRACKET() || fprev == TK_ARROW() || fprev == TK_KW_MOVE() || fprev == TK_KW_RETURN()) {
                let fj = fi + 1;
                let fparams = "void";
                if (fk != TK_OP_OR()) {
                    // Scan params between | and closing | to build prototype param list
                    let fp = fi + 1;
                    let fpstr = "";
                    let fpfirst = 1;
                    let fd = 0;
                    while (fp < c.count) {
                        let fpk = vec_int_get(c.int_data, fp * 3);
                        if (fpk == TK_LPAREN()) { fd = fd + 1; }
                        if (fpk == TK_RPAREN()) { fd = fd - 1; }
                        if (fd == 0 && (fpk == TK_PIPE() || fpk == TK_OP_BIT_OR() || fpk == TK_OP_OR())) { fj = fp + 1; break; }
                        if (fd == 0 && fpk == TK_IDENTIFIER()) {
                            let fpt = "int64_t";
                            if (fp + 1 < c.count && vec_int_get(c.int_data, (fp + 1) * 3) == TK_COLON()) {
                                if (fp + 2 < c.count) { fpt = type_to_c(vec_int_get(c.int_data, (fp + 2) * 3), vec_string_get(c.lexemes, fp + 2)); }
                            }
                            if (fpfirst == 0) { fpstr = str_concat(fpstr, ", "); }
                            fpstr = str_concat(fpstr, fpt);
                            fpfirst = 0;
                        }
                        fp = fp + 1;
                    }
                    if (fpstr != "") { fparams = fpstr; }
                } else {
                    fj = fi + 1;
                }
                let fret = "int64_t";
                if (fj < c.count && vec_int_get(c.int_data, fj * 3) == TK_ARROW()) {
                    fj = fj + 1;
                    if (fj < c.count) {
                        if (vec_int_get(c.int_data, fj * 3) == TK_LPAREN()) {
                            // Tuple return type: count arity and map to KrTupleN
                            fret = tuple_type_c(count_tuple_arity_at(c, fj));
                        } else {
                            fret = type_to_c(vec_int_get(c.int_data, fj * 3), vec_string_get(c.lexemes, fj));
                        }
                    }
                }
                // Fat closure: prepend void* _env to parameter list
                let fparams_full = "void*";
                if (fparams != "void") { fparams_full = str_concat("void*, ", fparams); }
                tr_emit_line(c, str_concat("static ", str_concat(fret, str_concat(" _kr_cl_", str_concat(fmt_int(fi), str_concat("(", str_concat(fparams_full, ");")))))));
            }
        }
        fi = fi + 1;
    }
    // Main pass: emit full closure definitions
    let i = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);
        if (k == TK_PIPE() || k == TK_OP_BIT_OR() || k == TK_OP_OR()) {
            let prev_k = 0;
            if (i > 0) { prev_k = vec_int_get(c.int_data, (i - 1) * 3); }
            if (prev_k == TK_OP_ASSIGN() || prev_k == TK_COMMA() || prev_k == TK_LPAREN() || prev_k == TK_LBRACKET() || prev_k == TK_ARROW() || prev_k == TK_KW_MOVE() || prev_k == TK_KW_RETURN()) {
                // Found closure at position i. Build a sub-translator.
                let cl: Translator = Translator {
                    pos: i, count: c.count, indent: 0, errors: c.errors,
                    file: c.file, int_data: c.int_data, lexemes: c.lexemes, out: c.out, sema: c.sema,
                };
                let cl_name = str_concat("_kr_cl_", fmt_int(i));

                // Parse parameters
                let params_c = "";
                let param_names = "";
                let pfirst = 1;
                cl = tr_advance(cl);
                if (k != TK_OP_OR()) {
                    // Single-pipe: parse params until closing pipe
                    while (!tr_at_end(cl) && tr_kind(cl) != TK_PIPE() && tr_kind(cl) != TK_OP_BIT_OR() && tr_kind(cl) != TK_OP_OR()) {
                        if (tr_kind(cl) == TK_COMMA()) { cl = tr_advance(cl); continue; }
                        if (tr_kind(cl) == TK_IDENTIFIER()) {
                            let pname = sanitize_c_name(tr_lexeme(cl));
                            cl = tr_advance(cl);
                            let ptype_c = "int64_t";
                            if (!tr_at_end(cl) && tr_kind(cl) == TK_COLON()) {
                                cl = tr_advance(cl);
                                if (!tr_at_end(cl)) {
                                    let ptk = tr_kind(cl);
                                    ptype_c = type_to_c(ptk, tr_lexeme(cl));
                                    cl = tr_advance(cl);
                                    if (ptk == TK_LPAREN()) { ptype_c = tuple_type_c(count_tuple_arity(cl)); cl = skip_tuple_type(cl); }
                                    if (ptk == TK_LBRACKET()) { ptype_c = "int64_t*"; cl = skip_array_type_suffix(cl, ptk); }
                                    cl = skip_generic_params(cl);
                                    if (ptk == TK_KW_FN()) { ptype_c = "void*"; cl = skip_fn_type_sig(cl); }
                                }
                            }
                            if (pfirst == 0) {
                                params_c = str_concat(params_c, ", ");
                                param_names = str_concat(param_names, ",");
                            }
                            params_c = str_concat(params_c, str_concat(ptype_c, str_concat(" ", pname)));
                            param_names = str_concat(param_names, pname);
                            pfirst = 0;
                        } else { cl = tr_advance(cl); }
                    }
                    if (!tr_at_end(cl)) { cl = tr_advance(cl); }
                }
                // || has no params — cl already past ||

                // Optional return type annotation
                let ret_c = "int64_t";
                if (!tr_at_end(cl) && tr_kind(cl) == TK_ARROW()) {
                    cl = tr_advance(cl);
                    if (!tr_at_end(cl)) {
                        let rtk = tr_kind(cl);
                        ret_c = type_to_c(rtk, tr_lexeme(cl));
                        cl = tr_advance(cl);
                        if (rtk == TK_LPAREN()) { ret_c = tuple_type_c(count_tuple_arity(cl)); cl = skip_tuple_type(cl); }
                        if (rtk == TK_LBRACKET()) { ret_c = "int64_t*"; cl = skip_array_type_suffix(cl, rtk); }
                        cl = skip_generic_params(cl);
                        if (rtk == TK_KW_FN()) { ret_c = "void*"; cl = skip_fn_type_sig(cl); }
                    }
                }

                // --- Capture detection ---
                let body_start_pos = cl.pos;
                let body_end_pos = body_start_pos;
                if (body_start_pos < c.count && vec_int_get(c.int_data, body_start_pos * 3) == TK_LBRACE()) {
                    body_end_pos = body_start_pos + 1;
                    let bdd = 1;
                    while (body_end_pos < c.count && bdd > 0) {
                        let bkk = vec_int_get(c.int_data, body_end_pos * 3);
                        if (bkk == TK_LBRACE()) { bdd = bdd + 1; }
                        if (bkk == TK_RBRACE()) { bdd = bdd - 1; }
                        body_end_pos = body_end_pos + 1;
                    }
                } else {
                    let pd3 = 0;
                    let bd3 = 0;
                    while (body_end_pos < c.count) {
                        let bkk = vec_int_get(c.int_data, body_end_pos * 3);
                        if (bkk == TK_LPAREN()) { pd3 = pd3 + 1; }
                        if (bkk == TK_RPAREN()) {
                            if (pd3 == 0 && bd3 == 0) { break; }
                            pd3 = pd3 - 1;
                        }
                        if (bkk == TK_LBRACE()) { bd3 = bd3 + 1; }
                        if (bkk == TK_RBRACE()) {
                            if (pd3 == 0 && bd3 == 0) { break; }
                            bd3 = bd3 - 1;
                        }
                        if (pd3 == 0 && bd3 == 0) {
                            if (bkk == TK_COMMA() || bkk == TK_SEMICOLON()) { break; }
                        }
                        body_end_pos = body_end_pos + 1;
                    }
                }
                // Scan body for captured identifiers
                let captures = "";
                let cap_count = 0;
                let bi = body_start_pos;
                let inner_depth = 0;
                while (bi < body_end_pos) {
                    let bkk = vec_int_get(c.int_data, bi * 3);
                    // Skip entire inner closures (params + body)
                    if (bkk == TK_PIPE() || bkk == TK_OP_BIT_OR() || bkk == TK_OP_OR()) {
                        let bprev = 0;
                        if (bi > 0) { bprev = vec_int_get(c.int_data, (bi - 1) * 3); }
                        if (bprev == TK_OP_ASSIGN() || bprev == TK_COMMA() || bprev == TK_LPAREN() || bprev == TK_ARROW() || bprev == TK_KW_MOVE() || bprev == TK_KW_RETURN()) {
                            // Inner closure detected — skip params
                            bi = bi + 1;
                            if (bkk != TK_OP_OR()) {
                                while (bi < body_end_pos) {
                                    let bik = vec_int_get(c.int_data, bi * 3);
                                    if (bik == TK_PIPE() || bik == TK_OP_BIT_OR() || bik == TK_OP_OR()) { bi = bi + 1; break; }
                                    bi = bi + 1;
                                }
                            }
                            // Skip -> RetType if present
                            if (bi < body_end_pos && vec_int_get(c.int_data, bi * 3) == TK_ARROW()) {
                                bi = bi + 1;
                                while (bi < body_end_pos && vec_int_get(c.int_data, bi * 3) != TK_LBRACE() && vec_int_get(c.int_data, bi * 3) != TK_SEMICOLON() && vec_int_get(c.int_data, bi * 3) != TK_COMMA()) { bi = bi + 1; }
                            }
                            // Skip body { ... } or expression body
                            if (bi < body_end_pos && vec_int_get(c.int_data, bi * 3) == TK_LBRACE()) {
                                let ibd = 1; bi = bi + 1;
                                while (bi < body_end_pos && ibd > 0) {
                                    let ibk = vec_int_get(c.int_data, bi * 3);
                                    if (ibk == TK_LBRACE()) { ibd = ibd + 1; }
                                    if (ibk == TK_RBRACE()) { ibd = ibd - 1; }
                                    bi = bi + 1;
                                }
                            } else {
                                // Expression body — skip until ; or , at depth 0
                                let epd = 0;
                                while (bi < body_end_pos) {
                                    let ebk = vec_int_get(c.int_data, bi * 3);
                                    if (ebk == TK_LPAREN() || ebk == TK_LBRACKET()) { epd = epd + 1; }
                                    if (ebk == TK_RPAREN() || ebk == TK_RBRACKET()) { epd = epd - 1; }
                                    if (epd == 0 && (ebk == TK_SEMICOLON() || ebk == TK_COMMA())) { break; }
                                    bi = bi + 1;
                                }
                            }
                            continue;
                        }
                    }
                    if (bkk == TK_IDENTIFIER()) {
                        let bname = vec_string_get(c.lexemes, bi);
                        let skip_cap = 0;
                        let found_local_let = 0;
                        // Skip function calls: identifier followed by open paren
                        // UNLESS the identifier is a local variable or fn-typed parameter (captured fn pointer)
                        if (bi + 1 < body_end_pos && vec_int_get(c.int_data, (bi + 1) * 3) == TK_LPAREN()) {
                            skip_cap = 1;
                            // Check if bname is declared in enclosing scope (let bname or param bname: fn)
                            let si2 = i - 1;
                            let sd2 = 0;
                            let found_brace = 0;
                            while (si2 >= 0) {
                                let sk2 = vec_int_get(c.int_data, si2 * 3);
                                if (sk2 == TK_RBRACE()) { sd2 = sd2 + 1; }
                                if (sk2 == TK_LBRACE()) {
                                    if (sd2 == 0) { found_brace = 1; si2 = si2 - 1; break; }
                                    sd2 = sd2 - 1;
                                }
                                // let bname = ... → local fn var
                                if (sd2 == 0 && sk2 == TK_KW_LET() && si2 + 1 < c.count) {
                                    if (vec_string_get(c.lexemes, si2 + 1) == bname) { skip_cap = 0; found_local_let = 1; }
                                }
                                si2 = si2 - 1;
                            }
                            // Continue past { to check function parameter list for bname: fn(...)
                            if (found_brace == 1 && skip_cap == 1) {
                                while (si2 >= 0) {
                                    let sk3 = vec_int_get(c.int_data, si2 * 3);
                                    if (sk3 == TK_RBRACE() || sk3 == TK_SEMICOLON()) { break; }
                                    // Stop at fn IDENTIFIER (function definition), not fn( (type annotation)
                                    if (sk3 == TK_KW_FN() && si2 + 1 < c.count && vec_int_get(c.int_data, (si2 + 1) * 3) == TK_IDENTIFIER()) { break; }
                                    if (vec_string_get(c.lexemes, si2) == bname && si2 + 2 < c.count) {
                                        if (vec_int_get(c.int_data, (si2 + 1) * 3) == TK_COLON() && vec_int_get(c.int_data, (si2 + 2) * 3) == TK_KW_FN()) { skip_cap = 0; }
                                    }
                                    si2 = si2 - 1;
                                }
                            }
                        }
                        // Skip type names (uppercase start)
                        if (skip_cap == 0 && strlen(bname) > 0) {
                            let bch = str_char_at(bname, 0);
                            if (bch >= 65 && bch <= 90) { skip_cap = 1; }
                        }
                        // Skip self/true/false/move
                        if (bname == "self" || bname == "true" || bname == "false" || bname == "move") { skip_cap = 1; }
                        // Skip top-level functions (known via sema) — but NOT if a local let was found
                        if (skip_cap == 0 && found_local_let == 0 && sema_has(c, str_concat("f:", str_concat(bname, ":ret")))) { skip_cap = 1; }
                        // Skip closure parameters
                        if (skip_cap == 0 && param_names != "") {
                            let pi3 = 0;
                            let plen2 = strlen(param_names);
                            while (pi3 < plen2) {
                                let pstart2 = pi3;
                                while (pi3 < plen2 && str_char_at(param_names, pi3) != 44) { pi3 = pi3 + 1; }
                                let pn2 = str_slice(param_names, pstart2, pi3);
                                if (pn2 == bname) { skip_cap = 1; }
                                if (pi3 < plen2) { pi3 = pi3 + 1; }
                            }
                        }
                        // Skip if already captured
                        if (skip_cap == 0 && captures != "") {
                            let ci4 = 0;
                            let clen3 = strlen(captures);
                            while (ci4 < clen3) {
                                let cstart3 = ci4;
                                while (ci4 < clen3 && str_char_at(captures, ci4) != 44) { ci4 = ci4 + 1; }
                                let cn3 = str_slice(captures, cstart3, ci4);
                                if (cn3 == bname) { skip_cap = 1; }
                                if (ci4 < clen3) { ci4 = ci4 + 1; }
                            }
                        }
                        // Skip if declared locally in the body (let bname / let mut bname / for (bname in ...))
                        if (skip_cap == 0) {
                            let li2 = body_start_pos;
                            while (li2 < body_end_pos) {
                                let li2k = vec_int_get(c.int_data, li2 * 3);
                                if (li2k == TK_KW_LET()) {
                                    let li3 = li2 + 1;
                                    // let bname
                                    if (li3 < body_end_pos && vec_string_get(c.lexemes, li3) == bname) {
                                        skip_cap = 1;
                                    }
                                    // let mut bname
                                    if (li3 < body_end_pos && vec_int_get(c.int_data, li3 * 3) == TK_KW_MUT()) {
                                        let li4 = li3 + 1;
                                        if (li4 < body_end_pos && vec_string_get(c.lexemes, li4) == bname) {
                                            skip_cap = 1;
                                        }
                                    }
                                }
                                // for (bname in ...) — loop variable is local
                                if (li2k == TK_KW_FOR()) {
                                    let li3 = li2 + 1;
                                    // for bname in ... or for (bname in ...)
                                    if (li3 < body_end_pos && vec_string_get(c.lexemes, li3) == bname) {
                                        skip_cap = 1;
                                    }
                                    if (li3 < body_end_pos && vec_int_get(c.int_data, li3 * 3) == TK_LPAREN()) {
                                        let li4 = li3 + 1;
                                        if (li4 < body_end_pos && vec_string_get(c.lexemes, li4) == bname) {
                                            skip_cap = 1;
                                        }
                                    }
                                }
                                li2 = li2 + 1;
                            }
                        }
                        // Skip wildcard _
                        if (skip_cap == 0 && bname == "_") { skip_cap = 1; }
                        if (skip_cap == 0) {
                            if (cap_count > 0) { captures = str_concat(captures, ","); }
                            captures = str_concat(captures, bname);
                            cap_count = cap_count + 1;
                        }
                    }
                    bi = bi + 1;
                }
                // Emit #define redirects: captures read from _env array
                if (captures != "") {
                    let ci5 = 0;
                    let clen4 = strlen(captures);
                    let cap_idx = 0;
                    while (ci5 < clen4) {
                        let cstart4 = ci5;
                        while (ci5 < clen4 && str_char_at(captures, ci5) != 44) { ci5 = ci5 + 1; }
                        let cname2 = str_slice(captures, cstart4, ci5);
                        let scname2 = sanitize_c_name(cname2);
                        let env_access = str_concat("((int64_t*)_env)[", str_concat(fmt_int(cap_idx), "]"));
                        tr_emit_line(cl, str_concat("#define ", str_concat(scname2, str_concat(" ", env_access))));
                        tr_emit_line(cl, str_concat("#define kr_", str_concat(scname2, str_concat(" ", env_access))));
                        cap_idx = cap_idx + 1;
                        if (ci5 < clen4) { ci5 = ci5 + 1; }
                    }
                    sema_set(c, str_concat("cl:", str_concat(fmt_int(i), ":caps")), captures);
                }

                // Set sema flags for captured variables so is_local_fn_var detects them
                if (captures != "") {
                    let ci8 = 0;
                    let clen7 = strlen(captures);
                    while (ci8 < clen7) {
                        let cstart7 = ci8;
                        while (ci8 < clen7 && str_char_at(captures, ci8) != 44) { ci8 = ci8 + 1; }
                        let cname5 = str_slice(captures, cstart7, ci8);
                        sema_set(c, str_concat("localfn:", cname5), "1");
                        if (ci8 < clen7) { ci8 = ci8 + 1; }
                    }
                }

                // Emit function header with void* _env as hidden first parameter
                let full_params = "void* _env";
                if (params_c != "") { full_params = str_concat("void* _env, ", params_c); }
                tr_emit_line(cl, str_concat("static ", str_concat(ret_c, str_concat(" ", str_concat(cl_name, str_concat("(", str_concat(full_params, ") {")))))));

                // Translate body
                if (!tr_at_end(cl) && tr_kind(cl) == TK_LBRACE()) {
                    cl = tr_advance(cl);
                    cl = tr_indent(cl);
                    // Set up implicit return for non-void closures
                    if (ret_c != "void") {
                        // Check if the last token before } is ; — if so, block is void (no implicit return)
                        let last_tok_before_close = body_end_pos - 2;
                        let block_is_void = 0;
                        if (last_tok_before_close >= cl.pos && vec_int_get(c.int_data, last_tok_before_close * 3) == TK_SEMICOLON()) {
                            block_is_void = 1;
                        }
                        if (block_is_void == 0) {
                            let scan_i = cl.pos;
                            let last_stmt_pos = cl.pos;
                            let scan_depth = 0;
                            while (scan_i < body_end_pos - 1) {
                                let sk = vec_int_get(c.int_data, scan_i * 3);
                                if (sk == TK_LBRACE()) { scan_depth = scan_depth + 1; }
                                if (sk == TK_RBRACE()) { scan_depth = scan_depth - 1; }
                                if (scan_depth == 0 && (sk == TK_SEMICOLON() || sk == TK_RBRACE())) {
                                    if (scan_i + 1 < body_end_pos - 1) {
                                        last_stmt_pos = scan_i + 1;
                                    }
                                }
                                scan_i = scan_i + 1;
                            }
                            let last_k = vec_int_get(c.int_data, last_stmt_pos * 3);
                            if (last_k != TK_KW_RETURN()) {
                                sema_set(c, "implicit_ret_pos", fmt_int(last_stmt_pos));
                            }
                        }
                    }
                    cl = translate_block_body(cl);
                    sema_set(c, "implicit_ret_pos", "");
                    cl = tr_dedent(cl);
                } else {
                    // Expression body — emit as return statement
                    cl = tr_indent(cl);
                    tr_emit_indent(cl);
                    if (ret_c != "void") { tr_emit(cl, "return "); }
                    cl = translate_expr(cl);
                    tr_emit(cl, ";\n");
                    cl = tr_dedent(cl);
                }
                tr_emit_line(cl, "}");
                // Clear localfn: sema flags for captured variables
                if (captures != "") {
                    let ci9 = 0;
                    let clen8 = strlen(captures);
                    while (ci9 < clen8) {
                        let cstart8 = ci9;
                        while (ci9 < clen8 && str_char_at(captures, ci9) != 44) { ci9 = ci9 + 1; }
                        let cname6 = str_slice(captures, cstart8, ci9);
                        sema_set(c, str_concat("localfn:", cname6), "");
                        if (ci9 < clen8) { ci9 = ci9 + 1; }
                    }
                }
                // Emit #undef for captures
                if (captures != "") {
                    let ci6 = 0;
                    let clen5 = strlen(captures);
                    while (ci6 < clen5) {
                        let cstart5 = ci6;
                        while (ci6 < clen5 && str_char_at(captures, ci6) != 44) { ci6 = ci6 + 1; }
                        let cname3 = str_slice(captures, cstart5, ci6);
                        tr_emit_line(cl, str_concat("#undef ", sanitize_c_name(cname3)));
                        tr_emit_line(cl, str_concat("#undef kr_", sanitize_c_name(cname3)));
                        if (ci6 < clen5) { ci6 = ci6 + 1; }
                    }
                }
                tr_emit(cl, "\n");
            }
        }
        i = i + 1;
    }
    return c;
}

fn skip_brace_block(tr: Translator) -> Translator {
    let c: Translator = tr;
    if (tr_at_end(c) || tr_kind(c) != TK_LBRACE()) { return c; }
    c = tr_advance(c);
    let depth = 1;
    while (!tr_at_end(c) && depth > 0) {
        let k = tr_kind(c);
        if (k == TK_LBRACE()) { depth = depth + 1; }
        if (k == TK_RBRACE()) { depth = depth - 1; }
        c = tr_advance(c);
    }
    return c;
}

// ---------------------------------------------------------------------------
// Vtable emission — emit vtable structs, wrappers, and instances
// ---------------------------------------------------------------------------

fn emit_vtables(tr: Translator) -> Translator {
    let c: Translator = tr;
    // Scan tokens for trait declarations, emit vtable struct per trait
    let i = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);
        if (k == TK_KW_TRAIT()) {
            let i1 = i + 1;
            if (i1 < c.count && vec_int_get(c.int_data, i1 * 3) == TK_IDENTIFIER()) {
                let trait_name = vec_string_get(c.lexemes, i1);
                let methods_str = sema_get(c, str_concat("t:", str_concat(trait_name, ":_methods")));
                if (methods_str != "") {
                    // Check object safety before emitting vtable struct
                    let vt_safe = 1;
                    let vsi = 0;
                    let vslen = strlen(methods_str);
                    while (vsi < vslen) {
                        let vss = vsi;
                        while (vsi < vslen && str_char_at(methods_str, vsi) != 44) { vsi = vsi + 1; }
                        let vsmn = str_slice(methods_str, vss, vsi);
                        let vsret = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", vsmn))));
                        if (vsret == "void*") { vt_safe = 0; }
                        let vsp = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", str_concat(vsmn, ":params")))));
                        if (vsp != "") {
                            let vpi = 0;
                            let vplen = strlen(vsp);
                            while (vpi < vplen) {
                                while (vpi < vplen && str_char_at(vsp, vpi) != 58) { vpi = vpi + 1; }
                                vpi = vpi + 1;
                                let vts = vpi;
                                while (vpi < vplen && str_char_at(vsp, vpi) != 44) { vpi = vpi + 1; }
                                if (str_slice(vsp, vts, vpi) == "void*") { vt_safe = 0; }
                                if (vpi < vplen) { vpi = vpi + 1; }
                            }
                        }
                        if (vsi < vslen) { vsi = vsi + 1; }
                    }
                    if (vt_safe == 0) { i = i + 1; continue; }
                    // Emit vtable struct: typedef struct { RetType (*method)(void*); ... } TraitName_VT;
                    tr_emit(c, "typedef struct { ");
                    // Parse comma-separated method names
                    let mi = 0;
                    let mlen = strlen(methods_str);
                    while (mi < mlen) {
                        let mstart = mi;
                        while (mi < mlen && str_char_at(methods_str, mi) != 44) { mi = mi + 1; }
                        let mname = str_slice(methods_str, mstart, mi);
                        let mret = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", mname))));
                        if (mret == "") { mret = "int64_t"; }
                        // Build function pointer type with extra params
                        let ep_str = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", str_concat(mname, ":params")))));
                        let ep_types = "";
                        if (ep_str != "") {
                            let epi = 0;
                            let eplen = strlen(ep_str);
                            while (epi < eplen) {
                                // Find the : separator to get type
                                let eps = epi;
                                while (epi < eplen && str_char_at(ep_str, epi) != 58) { epi = epi + 1; }
                                epi = epi + 1;
                                let ets = epi;
                                while (epi < eplen && str_char_at(ep_str, epi) != 44) { epi = epi + 1; }
                                ep_types = str_concat(ep_types, str_concat(", ", str_slice(ep_str, ets, epi)));
                                if (epi < eplen) { epi = epi + 1; }
                            }
                        }
                        tr_emit(c, str_concat(mret, str_concat(" (*", str_concat(mname, str_concat(")(void*", str_concat(ep_types, "); "))))));
                        if (mi < mlen) { mi = mi + 1; }
                    }
                    tr_emit(c, str_concat("} ", str_concat(trait_name, "_VT;\n")));
                }
            }
        }
        i = i + 1;
    }

    // Scan tokens for impl Trait for Type blocks, emit wrappers + vtable instances
    i = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);
        if (k == TK_KW_IMPL()) {
            let i1 = i + 1;
            if (i1 < c.count && vec_int_get(c.int_data, i1 * 3) == TK_IDENTIFIER()) {
                let first_name = vec_string_get(c.lexemes, i1);
                let ii = i1 + 1;
                // Skip generics on first name
                if (ii < c.count && vec_int_get(c.int_data, ii * 3) == TK_OP_LT()) {
                    let gd = 1; ii = ii + 1;
                    while (ii < c.count && gd > 0) {
                        if (vec_int_get(c.int_data, ii * 3) == TK_OP_LT()) { gd = gd + 1; }
                        if (vec_int_get(c.int_data, ii * 3) == TK_OP_GT()) { gd = gd - 1; }
                        ii = ii + 1;
                    }
                }
                // Check for "for Type"
                if (ii < c.count && vec_string_get(c.lexemes, ii) == "for") {
                    let trait_name = first_name;
                    ii = ii + 1;
                    let type_name = "";
                    if (ii < c.count && vec_int_get(c.int_data, ii * 3) == TK_IDENTIFIER()) {
                        type_name = vec_string_get(c.lexemes, ii);
                    }
                    if (type_name != "") {
                        let methods_str = sema_get(c, str_concat("t:", str_concat(trait_name, ":_methods")));
                        // Check if trait is object-safe (no Self params beyond self)
                        let obj_safe = 1;
                        if (methods_str != "") {
                            let osi = 0;
                            let oslen = strlen(methods_str);
                            while (osi < oslen) {
                                let osstart = osi;
                                while (osi < oslen && str_char_at(methods_str, osi) != 44) { osi = osi + 1; }
                                let osmn = str_slice(methods_str, osstart, osi);
                                // Check return type for Self (void*)
                                let osret = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", osmn))));
                                if (osret == "void*") { obj_safe = 0; }
                                let osp = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", str_concat(osmn, ":params")))));
                                if (osp != "") {
                                    // Has extra params — check if any are Self (void*)
                                    let opi = 0;
                                    let oplen = strlen(osp);
                                    while (opi < oplen) {
                                        while (opi < oplen && str_char_at(osp, opi) != 58) { opi = opi + 1; }
                                        opi = opi + 1;
                                        let ots = opi;
                                        while (opi < oplen && str_char_at(osp, opi) != 44) { opi = opi + 1; }
                                        let opty = str_slice(osp, ots, opi);
                                        if (opty == "void*") { obj_safe = 0; }
                                        if (opi < oplen) { opi = opi + 1; }
                                    }
                                }
                                if (osi < oslen) { osi = osi + 1; }
                            }
                        }
                        if (methods_str != "" && obj_safe == 1) {
                            // Emit wrapper functions and vtable instance
                            let mi = 0;
                            let mlen = strlen(methods_str);
                            while (mi < mlen) {
                                let mstart = mi;
                                while (mi < mlen && str_char_at(methods_str, mi) != 44) { mi = mi + 1; }
                                let mname = str_slice(methods_str, mstart, mi);
                                let mret = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", mname))));
                                if (mret == "") { mret = "int64_t"; }
                                // Wrapper: static RetType _kr_Type_Trait_method_wrap(void* _self) { return kr_Type_method(*(Type*)_self); }
                                let wrap_name = str_concat("_kr_", str_concat(type_name, str_concat("_", str_concat(trait_name, str_concat("_", str_concat(mname, "_wrap"))))));
                                let impl_name = str_concat("kr_", str_concat(type_name, str_concat("_", mname)));
                                if (mi < mlen) { mi = mi + 1; }
                            }
                            // Emit default method implementations BEFORE wrappers
                            // Scan the trait body to find default methods
                            mi = 0;
                            while (mi < mlen) {
                                let mstart2 = mi;
                                while (mi < mlen && str_char_at(methods_str, mi) != 44) { mi = mi + 1; }
                                let mname2 = str_slice(methods_str, mstart2, mi);
                                let impl_key = str_concat("i:", str_concat(type_name, str_concat(":", str_concat(trait_name, str_concat(":", mname2)))));
                                if (!sema_has(c, impl_key)) {
                                    // Scan tokens for trait TraitName { ... fn mname2(...) { default_body } ... }
                                    let ti2 = 0;
                                    while (ti2 < c.count) {
                                        if (vec_int_get(c.int_data, ti2 * 3) == TK_KW_TRAIT() && ti2 + 1 < c.count && vec_string_get(c.lexemes, ti2 + 1) == trait_name) {
                                            let tj = ti2 + 2;
                                            while (tj < c.count && vec_int_get(c.int_data, tj * 3) != TK_LBRACE()) { tj = tj + 1; }
                                            tj = tj + 1;
                                            let td = 1;
                                            while (tj < c.count && td > 0) {
                                                let tk2 = vec_int_get(c.int_data, tj * 3);
                                                if (tk2 == TK_LBRACE()) { td = td + 1; }
                                                if (tk2 == TK_RBRACE()) { td = td - 1; if (td == 0) { break; } }
                                                if (td == 1 && tk2 == TK_KW_FN() && tj + 1 < c.count && vec_string_get(c.lexemes, tj + 1) == mname2) {
                                                    // Found the method declaration — check if it has a body
                                                    let tj2 = tj + 2;
                                                    while (tj2 < c.count && vec_int_get(c.int_data, tj2 * 3) != TK_SEMICOLON() && vec_int_get(c.int_data, tj2 * 3) != TK_LBRACE()) { tj2 = tj2 + 1; }
                                                    if (tj2 < c.count && vec_int_get(c.int_data, tj2 * 3) == TK_LBRACE()) {
                                                        // Has default body — emit kr_Type_method
                                                        let mret2 = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", mname2))));
                                                        if (mret2 == "") { mret2 = "int64_t"; }
                                                        let impl_name2 = str_concat("kr_", str_concat(type_name, str_concat("_", mname2)));
                                                        tr_emit(c, str_concat(mret2, str_concat(" ", str_concat(impl_name2, str_concat("(", str_concat(type_name, " self) "))))));
                                                        let dcl: Translator = Translator {
                                                            pos: tj2, count: c.count, indent: 0, errors: c.errors,
                                                            file: c.file, int_data: c.int_data, lexemes: c.lexemes, out: c.out, sema: c.sema,
                                                        };
                                                        dcl = tr_advance(dcl);
                                                        tr_emit(dcl, "{\n");
                                                        dcl = tr_indent(dcl);
                                                        dcl = translate_block_body(dcl);
                                                        dcl = tr_dedent(dcl);
                                                        tr_emit_line(dcl, "}\n");
                                                        sema_set(c, impl_key, impl_name2);
                                                    }
                                                    break;
                                                }
                                                tj = tj + 1;
                                            }
                                            break;
                                        }
                                        ti2 = ti2 + 1;
                                    }
                                }
                                if (mi < mlen) { mi = mi + 1; }
                            }

                            // Now emit wrapper functions (after defaults are defined)
                            mi = 0;
                            while (mi < mlen) {
                                let mstart3 = mi;
                                while (mi < mlen && str_char_at(methods_str, mi) != 44) { mi = mi + 1; }
                                let mname3 = str_slice(methods_str, mstart3, mi);
                                let mret3 = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", mname3))));
                                if (mret3 == "") { mret3 = "int64_t"; }
                                let wrap_name3 = str_concat("_kr_", str_concat(type_name, str_concat("_", str_concat(trait_name, str_concat("_", str_concat(mname3, "_wrap"))))));
                                let impl_name3 = str_concat("kr_", str_concat(type_name, str_concat("_", mname3)));
                                // Build wrapper with extra params
                                let ep_str3 = sema_get(c, str_concat("t:", str_concat(trait_name, str_concat(":", str_concat(mname3, ":params")))));
                                let wp_decl = "";
                                let wp_pass = "";
                                if (ep_str3 != "") {
                                    let epi3 = 0;
                                    let eplen3 = strlen(ep_str3);
                                    while (epi3 < eplen3) {
                                        let eps3 = epi3;
                                        while (epi3 < eplen3 && str_char_at(ep_str3, epi3) != 58) { epi3 = epi3 + 1; }
                                        let epname = str_slice(ep_str3, eps3, epi3);
                                        epi3 = epi3 + 1;
                                        let ets3 = epi3;
                                        while (epi3 < eplen3 && str_char_at(ep_str3, epi3) != 44) { epi3 = epi3 + 1; }
                                        let eptyp = str_slice(ep_str3, ets3, epi3);
                                        // For Self type, substitute the concrete type
                                        if (eptyp == "void*") { eptyp = type_name; }
                                        wp_decl = str_concat(wp_decl, str_concat(", ", str_concat(eptyp, str_concat(" ", epname))));
                                        wp_pass = str_concat(wp_pass, str_concat(", ", epname));
                                        if (epi3 < eplen3) { epi3 = epi3 + 1; }
                                    }
                                }
                                tr_emit(c, str_concat("static ", str_concat(mret3, str_concat(" ", str_concat(wrap_name3, str_concat("(void* _self", str_concat(wp_decl, ") { ")))))));
                                if (mret3 != "void") { tr_emit(c, "return "); }
                                tr_emit(c, str_concat(impl_name3, str_concat("(*(", str_concat(type_name, str_concat("*)_self", str_concat(wp_pass, "); }\n"))))));
                                if (mi < mlen) { mi = mi + 1; }
                            }

                            // Vtable instance: static TraitName_VT _kr_Type_TraitName_vt = { .method = wrap, ... };
                            tr_emit(c, str_concat("static ", str_concat(trait_name, str_concat("_VT _kr_", str_concat(type_name, str_concat("_", str_concat(trait_name, "_vt = { ")))))));
                            mi = 0;
                            let vfirst = 1;
                            while (mi < mlen) {
                                let mstart = mi;
                                while (mi < mlen && str_char_at(methods_str, mi) != 44) { mi = mi + 1; }
                                let mname = str_slice(methods_str, mstart, mi);
                                let wrap_name = str_concat("_kr_", str_concat(type_name, str_concat("_", str_concat(trait_name, str_concat("_", str_concat(mname, "_wrap"))))));
                                if (vfirst == 0) { tr_emit(c, ", "); }
                                tr_emit(c, str_concat(".", str_concat(mname, str_concat(" = ", wrap_name))));
                                vfirst = 0;
                                if (mi < mlen) { mi = mi + 1; }
                            }
                            tr_emit(c, " };\n");
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    tr_emit(c, "\n");
    return c;
}

// ---------------------------------------------------------------------------
// Nested function prototype pass (forward-declare nested fns)
// ---------------------------------------------------------------------------

fn emit_nested_fn_prototypes(tr: Translator) -> Translator {
    let c: Translator = tr;
    let i = 0;
    let depth = 0;
    let in_fn_body = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);
        // Track what opens depth-1 blocks: only emit for fn bodies, not trait/impl
        if (depth == 0) {
            if (k == TK_KW_FN()) { in_fn_body = 1; }
            if (k == TK_KW_TRAIT() || k == TK_KW_IMPL() || k == TK_KW_STRUCT() || k == TK_KW_UNION() || k == TK_KW_ENUM()) { in_fn_body = 0; }
        }
        if (k == TK_LBRACE()) { depth = depth + 1; }
        if (k == TK_RBRACE()) {
            depth = depth - 1;
            if (depth == 0) { in_fn_body = 0; }
        }
        if (depth > 0 && in_fn_body == 1 && k == TK_KW_FN()) {
            let ni = i + 1;
            if (ni < c.count && vec_int_get(c.int_data, ni * 3) == TK_IDENTIFIER()) {
                let nfname = vec_string_get(c.lexemes, ni);
                let sub: Translator = Translator {
                    pos: i, count: c.count, indent: 0, errors: c.errors,
                    file: c.file, int_data: c.int_data, lexemes: c.lexemes, out: c.out, sema: c.sema,
                };
                sub = emit_fn_prototype(sub);
                // Register nested fn in sema so is_local_fn_var fallback is guarded
                let ri = ni + 1;
                let ret_n = "void";
                while (ri < c.count && vec_int_get(c.int_data, ri * 3) != TK_LBRACE()) {
                    if (vec_int_get(c.int_data, ri * 3) == TK_ARROW()) {
                        let ri2 = ri + 1;
                        if (ri2 < c.count) {
                            ret_n = type_to_c(vec_int_get(c.int_data, ri2 * 3), vec_string_get(c.lexemes, ri2));
                        }
                    }
                    ri = ri + 1;
                }
                sema_set(c, str_concat("f:", str_concat(nfname, ":ret")), ret_n);
            }
        }
        i = i + 1;
    }
    return c;
}

fn emit_nested_fn_bodies(tr: Translator) -> Translator {
    let c: Translator = tr;
    let i = 0;
    let depth = 0;
    let in_fn_body = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);
        if (depth == 0) {
            if (k == TK_KW_FN()) { in_fn_body = 1; }
            if (k == TK_KW_TRAIT() || k == TK_KW_IMPL() || k == TK_KW_STRUCT() || k == TK_KW_UNION() || k == TK_KW_ENUM()) { in_fn_body = 0; }
        }
        if (k == TK_LBRACE()) { depth = depth + 1; }
        if (k == TK_RBRACE()) {
            depth = depth - 1;
            if (depth == 0) { in_fn_body = 0; }
        }
        if (depth > 0 && in_fn_body == 1 && k == TK_KW_FN()) {
            let ni = i + 1;
            if (ni < c.count && vec_int_get(c.int_data, ni * 3) == TK_IDENTIFIER()) {
                let sub: Translator = Translator {
                    pos: i, count: c.count, indent: 0, errors: c.errors,
                    file: c.file, int_data: c.int_data, lexemes: c.lexemes, out: c.out, sema: c.sema,
                };
                sub = translate_fn(sub);
            }
        }
        i = i + 1;
    }
    return c;
}

fn neutralize_nested_fn_tokens(tr: Translator) -> Translator {
    // Replace nested fn definition tokens with TK_SEMICOLON so the main
    // translation pass never encounters them. Token positions are preserved
    // (important for closure IDs). Only token kinds are mutated.
    let c: Translator = tr;
    let i = 0;
    let depth = 0;
    let in_fn_body = 0;
    while (i < c.count) {
        let k = vec_int_get(c.int_data, i * 3);
        if (depth == 0) {
            if (k == TK_KW_FN()) { in_fn_body = 1; }
            if (k == TK_KW_TRAIT() || k == TK_KW_IMPL() || k == TK_KW_STRUCT() || k == TK_KW_UNION() || k == TK_KW_ENUM()) { in_fn_body = 0; }
        }
        if (k == TK_LBRACE()) { depth = depth + 1; }
        if (k == TK_RBRACE()) {
            depth = depth - 1;
            if (depth == 0) { in_fn_body = 0; }
        }
        if (depth > 0 && in_fn_body == 1 && k == TK_KW_FN()) {
            let ni = i + 1;
            if (ni < c.count && vec_int_get(c.int_data, ni * 3) == TK_IDENTIFIER()) {
                // Found nested fn definition — replace tokens through closing }
                let j = i;
                // Skip to opening {
                let found_brace = 0;
                while (j < c.count && found_brace == 0) {
                    if (vec_int_get(c.int_data, j * 3) == TK_LBRACE()) { found_brace = 1; }
                    vec_int_set(c.int_data, j * 3, TK_SEMICOLON());
                    j = j + 1;
                }
                // Skip past matching }
                let bd = 1;
                while (j < c.count && bd > 0) {
                    let bk = vec_int_get(c.int_data, j * 3);
                    if (bk == TK_LBRACE()) { bd = bd + 1; }
                    if (bk == TK_RBRACE()) { bd = bd - 1; }
                    vec_int_set(c.int_data, j * 3, TK_SEMICOLON());
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    return c;
}


// ---------------------------------------------------------------------------
// Main translation pass
// ---------------------------------------------------------------------------

fn translate_program(tr: Translator) -> Translator {
    let c: Translator = tr;

    // Sub-pass 1: emit ALL struct/enum definitions first
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_EOF()) { break; }
        if (tr_lexeme(c) == "extern") {
            while (!tr_at_end(c) && tr_kind(c) != TK_SEMICOLON()) { c = tr_advance(c); }
            if (!tr_at_end(c)) { c = tr_advance(c); }
            continue;
        }
        if (k == TK_KW_MODULE() || k == TK_KW_IMPORT()) {
            c = tr_advance(c); c = tr_advance(c);
            if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        } else {
            if (k == TK_KW_PUB()) {
                c = tr_advance(c);
                let k2 = tr_kind(c);
                if (k2 == TK_KW_STRUCT()) { c = translate_struct(c); }
                else {
                    if (k2 == TK_KW_UNION()) { c = translate_union(c); }
                    else {
                    if (k2 == TK_KW_ENUM()) { c = translate_enum(c); }
                    else {
                        if (k2 == TK_KW_TYPE()) { c = translate_type_alias(c); }
                        else {
                            if (k2 == TK_KW_CONST()) {
                                let c2: Translator = tr_advance(c);
                                if (!tr_at_end(c2) && tr_kind(c2) == TK_KW_FN()) {
                                    c = tr_advance(c);
                                } else {
                                    c = translate_const_decl(c);
                                }
                            }
                            else {
                                if (k2 == TK_KW_TRAIT()) { c = tr_advance(c); c = tr_advance(c); c = skip_generic_params(c); c = skip_brace_block(c); }
                                else { c = tr_advance(c); }
                            }
                        }
                    }
                    }
                }
            } else {
                if (k == TK_KW_STRUCT()) { c = translate_struct(c); }
                else {
                    if (k == TK_KW_UNION()) { c = translate_union(c); }
                    else {
                    if (k == TK_KW_ENUM()) { c = translate_enum(c); }
                    else {
                        if (k == TK_KW_TYPE()) { c = translate_type_alias(c); }
                        else {
                            if (k == TK_KW_CONST()) {
                                let c2: Translator = tr_advance(c);
                                if (!tr_at_end(c2) && tr_kind(c2) == TK_KW_FN()) {
                                    c = tr_advance(c);
                                } else {
                                    c = translate_const_decl(c);
                                }
                            }
                            else {
                                if (k == TK_KW_TRAIT()) { c = tr_advance(c); c = tr_advance(c); c = skip_generic_params(c); c = skip_brace_block(c); }
                                else { c = tr_advance(c); }
                            }
                        }
                    }
                    }
                }
            }
        }
    }

    // Sub-pass 1b: second pass for deferred structs (dependency ordering)
    c = tr_reset_pos(c);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_EOF()) { break; }
        if (k == TK_KW_PUB()) {
            c = tr_advance(c);
            let k2 = tr_kind(c);
            if (k2 == TK_KW_STRUCT()) { c = translate_struct(c); }
            else { c = tr_advance(c); }
        } else {
            if (k == TK_KW_STRUCT()) { c = translate_struct(c); }
            else { c = tr_advance(c); }
        }
    }

    // Sub-pass 1.25: emit vtable structs and instances using sema registry
    c = emit_vtables(tr_reset_pos(c));

    // Sub-pass 1.5: emit static closure functions (before function bodies reference them)
    c = emit_closure_statics(tr_reset_pos(c));

    // Sub-pass 1.75: forward-declare nested functions (defined inside other functions)
    c = emit_nested_fn_prototypes(tr_reset_pos(c));

    // Sub-pass 1.8: emit nested function bodies as top-level C functions
    c = emit_nested_fn_bodies(tr_reset_pos(c));

    // Sub-pass 1.9: neutralize nested fn tokens (replace with semicolons)
    // so the main pass never encounters fn definitions in statement position
    c = neutralize_nested_fn_tokens(tr_reset_pos(c));

    // Sub-pass 2: emit ALL function bodies (+ impl blocks)
    c = tr_reset_pos(c);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_EOF()) { break; }
        if (tr_lexeme(c) == "extern") {
            while (!tr_at_end(c) && tr_kind(c) != TK_SEMICOLON()) { c = tr_advance(c); }
            if (!tr_at_end(c)) { c = tr_advance(c); }
            continue;
        }
        if (k == TK_KW_MODULE() || k == TK_KW_IMPORT()) {
            c = tr_advance(c); c = tr_advance(c);
            if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        } else {
            if (k == TK_KW_PUB()) {
                c = tr_advance(c);
                let k2 = tr_kind(c);
                if (k2 == TK_KW_FN()) { c = translate_fn(c); }
                else {
                    if (k2 == TK_KW_TRAIT()) {
                        c = tr_advance(c);
                        c = tr_advance(c);
                        c = skip_generic_params(c);
                        c = skip_brace_block(c);
                    } else {
                        if (k2 == TK_KW_STRUCT() || k2 == TK_KW_UNION() || k2 == TK_KW_ENUM()) { c = skip_brace_block(tr_advance(tr_advance(c))); }
                        else {
                        if (k2 == TK_KW_IMPL()) { c = translate_impl(c); }
                        else {
                            if (k2 == TK_KW_TYPE()) {
                                c = translate_type_alias(c);
                            } else {
                                if (k2 == TK_KW_CONST()) {
                                    let c2: Translator = tr_advance(c);
                                    if (!tr_at_end(c2) && tr_kind(c2) == TK_KW_FN()) {
                                        c = translate_fn(c2);
                                    } else {
                                        c = translate_const_decl(c);
                                    }
                                } else { c = tr_advance(c); }
                            }
                        }
                        }
                    }
                }
            } else {
                if (k == TK_KW_FN()) { c = translate_fn(c); }
                else {
                    if (k == TK_KW_TRAIT()) {
                        c = tr_advance(c);
                        c = tr_advance(c);
                        c = skip_generic_params(c);
                        c = skip_brace_block(c);
                    } else {
                        if (k == TK_KW_STRUCT() || k == TK_KW_UNION() || k == TK_KW_ENUM()) { c = skip_brace_block(tr_advance(tr_advance(c))); }
                        else {
                        if (k == TK_KW_IMPL()) { c = translate_impl(c); }
                        else {
                            if (k == TK_KW_TYPE()) {
                                c = translate_type_alias(c);
                            } else {
                                if (k == TK_KW_CONST()) {
                                    let c2: Translator = tr_advance(c);
                                    if (!tr_at_end(c2) && tr_kind(c2) == TK_KW_FN()) {
                                        c = translate_fn(c2);
                                    } else {
                                        c = translate_const_decl(c);
                                    }
                                } else { c = tr_advance(c); }
                            }
                        }
                        }
                    }
                }
            }
        }
    }

    return c;
}

fn translate_top_level(tr: Translator) -> Translator {
    let k = tr_kind(tr);
    if (k == TK_KW_FN()) { return translate_fn(tr); }
    if (k == TK_KW_STRUCT()) { return translate_struct(tr); }
    if (k == TK_KW_UNION()) { return translate_union(tr); }
    return tr_advance(tr);
}

// ---------------------------------------------------------------------------
// Impl block → free functions with TypeName_ prefix
// ---------------------------------------------------------------------------

fn translate_impl(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let type_name = tr_lexeme(c);
    c = tr_advance(c);
    c = skip_generic_params(c);
    if (!tr_at_end(c) && tr_lexeme(c) == "for") {
        c = tr_advance(c);
        if (!tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) {
            type_name = tr_lexeme(c);
            c = tr_advance(c);
        }
    }
    c = tr_advance(c);

    while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
        // Skip pub if present
        if (tr_kind(c) == TK_KW_PUB()) { c = tr_advance(c); }
        if (tr_kind(c) == TK_KW_FN()) {
            c = translate_impl_fn(c, type_name);
        } else { c = tr_advance(c); }
    }
    if (!tr_at_end(c)) { c = tr_advance(c); }
    return c;
}

fn translate_impl_fn(tr: Translator, type_name: string) -> Translator {
    let c: Translator = tr_advance(tr);
    let fname = tr_lexeme(c);
    c = tr_advance(c);
    c = tr_advance(c);

    let params = "";
    let first = 1;
    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
        if (first == 0) { params = str_concat(params, ", "); c = tr_advance(c); }
        let pname = tr_lexeme(c);
        if (pname == "self") {
            c = tr_advance(c);
            if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
                c = tr_advance(c);
                if (!tr_at_end(c)) {
                    let sk = tr_kind(c); let sn = tr_lexeme(c);
                    c = tr_advance(c);
                    if (sk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
                    c = skip_generic_params(c);
                    if (sk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
                }
            }
            params = str_concat(params, str_concat(type_name, " self"));
        } else {
            c = tr_advance(c);
            c = tr_advance(c);
            let ptype_kind = tr_kind(c);
            let ptype_name = tr_lexeme(c);
            c = tr_advance(c);
            if (ptype_kind == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
            let ipc2 = type_to_c(ptype_kind, ptype_name);
            if (ptype_kind == TK_LPAREN()) { ipc2 = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
            c = skip_array_type_suffix(c, ptype_kind);
            c = skip_generic_params(c);
            if (ptype_kind == TK_KW_FN()) { c = skip_fn_type_sig(c); }
            if (ptype_kind == TK_LBRACKET()) { ipc2 = "int64_t*"; }
            params = str_concat(params, str_concat(ipc2, str_concat(" ", sanitize_c_name(pname))));
        }
        first = 0;
    }
    c = tr_advance(c);

    let ret_c = "void";
    if (!tr_at_end(c) && tr_kind(c) == TK_ARROW()) {
        c = tr_advance(c);
        let rk = tr_kind(c); let rn = tr_lexeme(c);
        ret_c = type_to_c(rk, rn); c = tr_advance(c);
        if (rk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
        if (rk == TK_LPAREN()) { ret_c = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
        c = skip_array_type_suffix(c, rk);
        c = skip_generic_params(c);
        if (rk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
    }

    let mangled = str_concat("kr_", str_concat(type_name, str_concat("_", fname)));
    tr_emit(c, str_concat(ret_c, str_concat(" ", str_concat(mangled, str_concat("(", str_concat(params, ") {\n"))))));

    let impl_body_start = c.pos;
    c = tr_advance(c);
    c = tr_indent(c);
    // Set up implicit return for non-void impl methods
    if (ret_c != "void") {
        let impl_body_end = impl_body_start + 1;
        let ibd = 1;
        while (impl_body_end < c.count && ibd > 0) {
            let ibk = vec_int_get(c.int_data, impl_body_end * 3);
            if (ibk == TK_LBRACE()) { ibd = ibd + 1; }
            if (ibk == TK_RBRACE()) { ibd = ibd - 1; }
            impl_body_end = impl_body_end + 1;
        }
        let scan_i = c.pos;
        let last_stmt_pos = c.pos;
        let scan_depth = 0;
        while (scan_i < impl_body_end - 1) {
            let sk = vec_int_get(c.int_data, scan_i * 3);
            if (sk == TK_LBRACE()) { scan_depth = scan_depth + 1; }
            if (sk == TK_RBRACE()) { scan_depth = scan_depth - 1; }
            if (scan_depth == 0 && (sk == TK_SEMICOLON() || sk == TK_RBRACE())) {
                if (scan_i + 1 < impl_body_end - 1) {
                    last_stmt_pos = scan_i + 1;
                }
            }
            scan_i = scan_i + 1;
        }
        let last_k = vec_int_get(c.int_data, last_stmt_pos * 3);
        if (last_k != TK_KW_RETURN()) {
            sema_set(c, "implicit_ret_pos", fmt_int(last_stmt_pos));
        }
    }
    c = translate_block_body(c);
    sema_set(c, "implicit_ret_pos", "");
    c = tr_dedent(c);
    tr_emit_line(c, "}");
    tr_emit(c, "\n");
    return c;
}

// ---------------------------------------------------------------------------
// Type alias → C typedef
// ---------------------------------------------------------------------------

fn translate_type_alias(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let alias_name = tr_lexeme(c);
    c = tr_advance(c);
    // Skip '='
    if (!tr_at_end(c) && tr_kind(c) == TK_OP_ASSIGN()) { c = tr_advance(c); }
    let tk = tr_kind(c);
    let tn = tr_lexeme(c);
    let c_type = type_to_c(tk, tn);
    c = tr_advance(c);
    if (tk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
    if (tk == TK_LPAREN()) { c_type = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
    c = skip_array_type_suffix(c, tk);
    c = skip_generic_params(c);
    if (tk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
    if (tk == TK_LBRACKET()) { c_type = "int64_t*"; }
    tr_emit_line(c, str_concat("typedef ", str_concat(c_type, str_concat(" ", str_concat(alias_name, ";")))));
    if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// Const declaration → #define
// ---------------------------------------------------------------------------

fn translate_const_decl(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let cname = tr_lexeme(c);
    c = tr_advance(c);
    // Skip optional ': type'
    if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
        c = tr_advance(c);
        c = tr_advance(c);
    }
    // Skip '='
    if (!tr_at_end(c) && tr_kind(c) == TK_OP_ASSIGN()) { c = tr_advance(c); }
    // Collect value tokens until semicolon
    let val = "";
    while (!tr_at_end(c) && tr_kind(c) != TK_SEMICOLON()) {
        val = str_concat(val, tr_lexeme(c));
        c = tr_advance(c);
    }
    tr_emit_line(c, str_concat("#define kr_", str_concat(cname, str_concat(" ", val))));
    if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// Enum declaration → typedef + #define constants
// ---------------------------------------------------------------------------

fn translate_enum(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let name = tr_lexeme(c);
    c = tr_advance(c);
    c = tr_advance(c);

    tr_emit_line(c, str_concat("typedef int64_t ", str_concat(name, ";")));
    let idx = 0;
    while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
        let variant = tr_lexeme(c); c = tr_advance(c);
        tr_emit_line(c, str_concat("#define ", str_concat(name, str_concat("_", str_concat(variant, str_concat(" ", fmt_int(idx)))))));
        idx = idx + 1;
        // Skip optional payload (Type) and comma
        if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
            c = tr_advance(c);
            while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) { c = tr_advance(c); }
            c = tr_advance(c);
        }
        if (!tr_at_end(c) && tr_kind(c) == TK_COMMA()) { c = tr_advance(c); }
    }
    if (!tr_at_end(c)) { c = tr_advance(c); }
    tr_emit(c, "\n");
    return c;
}

// ---------------------------------------------------------------------------
// Struct declaration
// ---------------------------------------------------------------------------

fn skip_struct_tokens(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    c = tr_advance(c);
    c = skip_generic_params(c);
    c = skip_brace_block(c);
    return c;
}

fn translate_struct(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let name = tr_lexeme(c);
    // Skip if already emitted (two-pass dedup)
    if (sema_has(c, str_concat("struct_emitted:", name))) {
        return skip_struct_tokens(tr);
    }
    c = tr_advance(c);
    c = skip_generic_params(c);
    c = tr_advance(c);

    // Check if any field references a struct not yet emitted — defer if so
    let si = c.pos;
    let has_unemitted_dep = 0;
    let sd = 0;
    while (si < c.count) {
        let sk = vec_int_get(c.int_data, si * 3);
        if (sk == TK_RBRACE() && sd == 0) { break; }
        if (sk == TK_LBRACE()) { sd = sd + 1; }
        if (sk == TK_RBRACE()) { sd = sd - 1; }
        if (sk == TK_COLON() && si + 1 < c.count) {
            let ftk = vec_int_get(c.int_data, (si + 1) * 3);
            if (ftk == TK_IDENTIFIER()) {
                let ftn = vec_string_get(c.lexemes, si + 1);
                if (strlen(ftn) > 1 && str_char_at(ftn, 0) >= 65 && str_char_at(ftn, 0) <= 90 && ftn != name) {
                    if (sema_has(c, str_concat("s:", str_concat(ftn, ":_fields"))) && !sema_has(c, str_concat("struct_emitted:", ftn))) {
                        has_unemitted_dep = 1;
                    }
                }
            }
        }
        si = si + 1;
    }
    if (has_unemitted_dep == 1) {
        return skip_struct_tokens(tr);
    }
    sema_set(c, str_concat("struct_emitted:", name), "1");

    tr_emit_line(c, str_concat("struct ", str_concat(name, " {")));
    while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
        let fname = tr_lexeme(c);
        c = tr_advance(c);
        if (tr_at_end(c)) { break; }
        if (tr_kind(c) != TK_COLON()) {
            if (tr_kind(c) == TK_RBRACE()) { break; }
            c = tr_advance(c);
            continue;
        }
        c = tr_advance(c);
        let fk = tr_kind(c); let fn_name = tr_lexeme(c); c = tr_advance(c);
        if (fk == TK_OP_STAR() && !tr_at_end(c)) { c = tr_advance(c); }
        c = skip_array_type_suffix(c, fk);
        c = skip_generic_params(c);
        let fc = type_to_c(fk, fn_name);
        if (fk == TK_IDENTIFIER() && strlen(fn_name) > 0) {
            let ch0 = str_char_at(fn_name, 0);
            if (ch0 >= 65 && ch0 <= 90) {
                if (strlen(fn_name) == 1) { fc = "int64_t"; }
                else {
                    if (sema_has(c, str_concat("s:", str_concat(fn_name, ":_fields")))) { fc = fn_name; }
                    else { fc = "void*"; }
                }
            }
        }
        if (fk == TK_KW_FN()) { fc = "void*"; c = skip_fn_type_sig(c); }
        tr_emit_line(c, str_concat(fc, str_concat(" ", str_concat(fname, ";"))));
        if (!tr_at_end(c) && (tr_kind(c) == TK_SEMICOLON() || tr_kind(c) == TK_COMMA())) { c = tr_advance(c); }
    }
    c = tr_advance(c);
    tr_emit_line(c, "};");
    tr_emit(c, "\n");
    return c;
}

// ---------------------------------------------------------------------------
// Function declaration
// ---------------------------------------------------------------------------

fn translate_fn(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let fname = tr_lexeme(c); c = tr_advance(c);
    let has_fn_generics = 0;
    if (!tr_at_end(c) && tr_kind(c) == TK_OP_LT()) { has_fn_generics = 1; }
    c = skip_generic_params(c);

    if (has_fn_generics == 1) {
        // Generic function: type-erased translation (T → int64_t).
        // Parse parameters with generic type params erased to int64_t.
        if (!tr_at_end(c) && tr_kind(c) != TK_LPAREN()) {
            while (!tr_at_end(c) && tr_kind(c) != TK_LPAREN()) { c = tr_advance(c); }
        }
    }
    c = tr_advance(c);

    let params = "";
    let first = 1;
    let has_fn_param = 0;
    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
        if (first == 0) { params = str_concat(params, ", "); c = tr_advance(c); }
        let p0 = tr_lexeme(c);
        if (p0 == "..." || p0 == "..") {
            params = str_concat(params, "...");
            while (!tr_at_end(c) && tr_kind(c) != TK_COMMA() && tr_kind(c) != TK_RPAREN()) { c = tr_advance(c); }
            first = 0;
            continue;
        }
        let pname = tr_lexeme(c); c = tr_advance(c); c = tr_advance(c);
        let pk = tr_kind(c); let pn = tr_lexeme(c); c = tr_advance(c);
        if (pk == TK_OP_STAR()) {
            while (!tr_at_end(c) && tr_kind(c) != TK_COMMA() && tr_kind(c) != TK_RPAREN()) { c = tr_advance(c); }
            params = str_concat(params, str_concat("void* ", sanitize_c_name(pname)));
            first = 0;
            continue;
        }
        if (pk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
        let pc = type_to_c(pk, pn);
        if (pk == TK_LPAREN()) { pc = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
        c = skip_array_type_suffix(c, pk);
        c = skip_generic_params(c);
        if (pk == TK_KW_FN()) { has_fn_param = 1; c = skip_fn_type_sig(c); }
        if (pk == TK_LBRACKET()) { pc = "int64_t*"; }
        params = str_concat(params, str_concat(pc, str_concat(" ", sanitize_c_name(pname))));
        first = 0;
    }
    c = tr_advance(c);

    let ret_c = "void";
    if (!tr_at_end(c) && tr_kind(c) == TK_ARROW()) {
        c = tr_advance(c);
        let rk = tr_kind(c); let rn = tr_lexeme(c);
        ret_c = type_to_c(rk, rn); c = tr_advance(c);
        if (rk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) { c = tr_advance(c); }
        if (rk == TK_LPAREN()) { ret_c = tuple_type_c(count_tuple_arity(c)); c = skip_tuple_type(c); }
        c = skip_array_type_suffix(c, rk);
        c = skip_generic_params(c);
        if (rk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
    }

    // Skip where clause: where T: Bound + Bound, U: Bound { ...
    if (!tr_at_end(c) && tr_kind(c) == TK_KW_WHERE()) {
        while (!tr_at_end(c) && tr_kind(c) != TK_LBRACE()) { c = tr_advance(c); }
    }

    let mangled = mangle_top_level_fn_name(fname);

    tr_emit(c, str_concat(ret_c, str_concat(" ", str_concat(mangled, str_concat("(", str_concat(params, ") {\n"))))));

    let fn_body_start = c.pos;
    c = tr_advance(c);
    c = tr_indent(c);
    // Set up implicit return for non-void functions
    if (ret_c != "void") {
        let fn_body_end = fn_body_start + 1;
        let fbd = 1;
        while (fn_body_end < c.count && fbd > 0) {
            let fbk = vec_int_get(c.int_data, fn_body_end * 3);
            if (fbk == TK_LBRACE()) { fbd = fbd + 1; }
            if (fbk == TK_RBRACE()) { fbd = fbd - 1; }
            fn_body_end = fn_body_end + 1;
        }
        let scan_i = c.pos;
        let last_stmt_pos = c.pos;
        let scan_depth = 0;
        while (scan_i < fn_body_end - 1) {
            let sk = vec_int_get(c.int_data, scan_i * 3);
            if (sk == TK_LBRACE()) { scan_depth = scan_depth + 1; }
            if (sk == TK_RBRACE()) { scan_depth = scan_depth - 1; }
            if (scan_depth == 0 && (sk == TK_SEMICOLON() || sk == TK_RBRACE())) {
                if (scan_i + 1 < fn_body_end - 1) {
                    last_stmt_pos = scan_i + 1;
                }
            }
            scan_i = scan_i + 1;
        }
        let last_k = vec_int_get(c.int_data, last_stmt_pos * 3);
        if (last_k != TK_KW_RETURN()) {
            sema_set(c, "implicit_ret_pos", fmt_int(last_stmt_pos));
        }
    }
    c = translate_block_body(c);
    sema_set(c, "implicit_ret_pos", "");
    c = tr_dedent(c);
    tr_emit_line(c, "}");
    tr_emit(c, "\n");
    return c;
}

// ---------------------------------------------------------------------------
// Block body
// ---------------------------------------------------------------------------

fn translate_block_body(tr: Translator) -> Translator {
    let c: Translator = tr;
    while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
        c = translate_statement(c);
    }
    if (!tr_at_end(c)) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// Statement
// ---------------------------------------------------------------------------

fn skip_to_sync(tr: Translator) -> Translator {
    let c: Translator = tr;
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_SEMICOLON()) { return tr_advance(c); }
        if (k == TK_RBRACE()) { return c; }
        c = tr_advance(c);
    }
    return c;
}

fn translate_statement(tr: Translator) -> Translator {
    let k = tr_kind(tr);
    if (k == TK_SEMICOLON()) { return tr_advance(tr); }
    if (k == TK_IDENTIFIER() && tr_lexeme(tr) == "static_assert") {
        // Semantic lowering: static_assert!(cond, msg) → runtime assertion
        let c: Translator = tr_advance(tr);
        // Skip optional `!` (macro-style invocation)
        if (!tr_at_end(c) && tr_kind(c) == TK_OP_NOT()) { c = tr_advance(c); }
        if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
            c = tr_advance(c);
            tr_emit_indent(c);
            tr_emit(c, "if (!(");
            // Translate condition (first arg) — stop at comma at depth 0
            let pd = 0;
            while (!tr_at_end(c)) {
                if (tr_kind(c) == TK_LPAREN()) { pd = pd + 1; }
                if (tr_kind(c) == TK_RPAREN()) { if (pd == 0) { break; } pd = pd - 1; }
                if (pd == 0 && tr_kind(c) == TK_COMMA()) { break; }
                c = translate_expr(c);
            }
            tr_emit(c, ")) { fprintf(stderr, \"static assertion failed: %s\\n\", ");
            // Skip comma
            if (!tr_at_end(c) && tr_kind(c) == TK_COMMA()) { c = tr_advance(c); }
            // Translate message (second arg)
            let pd2 = 0;
            while (!tr_at_end(c)) {
                if (tr_kind(c) == TK_LPAREN()) { pd2 = pd2 + 1; }
                if (tr_kind(c) == TK_RPAREN()) { if (pd2 == 0) { break; } pd2 = pd2 - 1; }
                c = translate_expr(c);
            }
            tr_emit(c, "); exit(1); }\n");
            // Skip closing paren
            if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
        }
        if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        return c;
    }
    if (k == TK_KW_LET() || k == TK_KW_CONST()) { return translate_var_decl(tr); }
    if (k == TK_KW_RETURN()) { return translate_return(tr); }
    if (k == TK_KW_IF()) { return translate_if(tr); }
    if (k == TK_KW_WHILE()) { return translate_while(tr); }
    if (k == TK_KW_FOR()) { return translate_for(tr); }
    if (k == TK_KW_MATCH()) {
        let mr_flag = sema_get(tr, "implicit_ret_pos");
        if (mr_flag != "" && mr_flag == fmt_int(tr.pos)) {
            sema_set(tr, "match_return", "1");
        }
        let mr_result: Translator = translate_match(tr);
        sema_set(mr_result, "match_return", "");
        return mr_result;
    }
    if (k == TK_KW_BREAK()) {
        tr_emit_line(tr, "break;");
        let c: Translator = tr_advance(tr);
        if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        return c;
    }
    if (k == TK_KW_CONTINUE()) {
        tr_emit_line(tr, "continue;");
        let c: Translator = tr_advance(tr);
        if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        return c;
    }
    if (k == TK_KW_DEFER()) {
        // Semantic lowering: defer → immediate expression (C has no destructor/scope-exit).
        let c: Translator = tr_advance(tr);
        tr_emit_indent(c);
        c = translate_expr(c);
        tr_emit(c, ";\n");
        if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        return c;
    }
    if (k == TK_KW_SPAWN()) {
        // Semantic lowering: spawn → immediate call (C has no built-in task scheduler).
        let c: Translator = tr_advance(tr);
        tr_emit_indent(c);
        c = translate_expr(c);
        tr_emit(c, ";\n");
        if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        return c;
    }
    if (k == TK_KW_UNSAFE()) {
        // Unsafe block: skip 'unsafe' keyword and translate inner block body.
        // translate_block_body already advances past the closing '}'.
        let c: Translator = tr_advance(tr);
        if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) {
            c = tr_advance(c);
            c = translate_block_body(c);
            return c;
        }
        return translate_expr_stmt(tr);
    }
    if (k == TK_EOF() || k == TK_RBRACE()) { return tr; }
    return translate_expr_stmt(tr);
}

// ---------------------------------------------------------------------------
// Variable declaration
// ---------------------------------------------------------------------------

fn translate_var_decl(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    // Skip 'mut' keyword: let mut x = ...;
    if (!tr_at_end(c) && tr_kind(c) == TK_KW_MUT()) { c = tr_advance(c); }
    if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
        // Tuple destructuring: let (a, b, ...) = (x, y, ...);
        // Collect LHS variable names (supports nested patterns like ((a, b), c)).
        let names = vec_string_new();
        c = tr_advance(c);
        let lhs_depth = 1;
        while (!tr_at_end(c) && lhs_depth > 0) {
            if (tr_kind(c) == TK_LPAREN()) { lhs_depth = lhs_depth + 1; }
            if (tr_kind(c) == TK_RPAREN()) { lhs_depth = lhs_depth - 1; if (lhs_depth == 0) { break; } }
            if (tr_kind(c) == TK_IDENTIFIER()) {
                vec_string_push(names, sanitize_c_name(tr_lexeme(c)));
            }
            c = tr_advance(c);
        }
        if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }

        // Optional tuple type annotation after ':'
        if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
            let pd = 0;
            let bd = 0;
            let sd = 0;
            c = tr_advance(c);
            while (!tr_at_end(c)) {
                let kk = tr_kind(c);
                if (kk == TK_LPAREN()) { pd = pd + 1; }
                if (kk == TK_RPAREN() && pd > 0) { pd = pd - 1; }
                if (kk == TK_LBRACE()) { bd = bd + 1; }
                if (kk == TK_RBRACE() && bd > 0) { bd = bd - 1; }
                if (kk == TK_LBRACKET()) { sd = sd + 1; }
                if (kk == TK_RBRACKET() && sd > 0) { sd = sd - 1; }
                if (pd == 0 && bd == 0 && sd == 0 && (kk == TK_OP_ASSIGN() || kk == TK_SEMICOLON())) { break; }
                c = tr_advance(c);
            }
        }

        // Bind from RHS: if RHS is a tuple literal (x, y, ...), bind per-element.
        if (!tr_at_end(c) && tr_kind(c) == TK_OP_ASSIGN()) {
            c = tr_advance(c);
            if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
                // RHS is tuple literal — bind per-element: __auto_type a = x;
                c = tr_advance(c);
                let ni = 0;
                let nlen = vec_string_len(names);
                while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                    if (ni > 0 && !tr_at_end(c) && tr_kind(c) == TK_COMMA()) { c = tr_advance(c); }
                    tr_emit_indent(c);
                    if (ni < nlen && vec_string_get(names, ni) != "_") {
                        tr_emit(c, str_concat("__auto_type ", str_concat(vec_string_get(names, ni), " = ")));
                    } else {
                        tr_emit(c, "(void)(");
                    }
                    c = translate_expr(c);
                    if (ni >= nlen || vec_string_get(names, ni) == "_") { tr_emit(c, ")"); }
                    tr_emit(c, ";\n");
                    ni = ni + 1;
                }
                if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
            } else {
                // RHS is not a tuple literal — store into KrTupleN temp and extract fields.
                let nlen2 = vec_string_len(names);
                let tup_type = str_concat("KrTuple", fmt_int(nlen2));
                let tup_tmp = str_concat("_kr_tup_", fmt_int(c.pos));
                tr_emit_indent(c);
                tr_emit(c, str_concat(tup_type, str_concat(" ", str_concat(tup_tmp, " = "))));
                // If RHS is a local fn var call, emit cast with tuple return type
                let tup_rhs_done = 0;
                if (tr_kind(c) == TK_IDENTIFIER()) {
                    let trn = tr_lexeme(c);
                    let trn1 = c.pos + 1;
                    if (trn1 < c.count && vec_int_get(c.int_data, trn1 * 3) == TK_LPAREN() && is_local_fn_var(c, trn)) {
                        tup_rhs_done = 1;
                        c = tr_advance(c);
                        c = tr_advance(c);
                        let tac = 0;
                        if (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) { tac = 1; }
                        let tsi = c.pos;
                        let tsd = 0;
                        while (tsi < c.count) {
                            let tsk = vec_int_get(c.int_data, tsi * 3);
                            if (tsk == TK_LPAREN() || tsk == TK_LBRACKET() || tsk == TK_LBRACE()) { tsd = tsd + 1; }
                            if (tsk == TK_RPAREN() || tsk == TK_RBRACKET() || tsk == TK_RBRACE()) {
                                if (tsd == 0) { break; }
                                tsd = tsd - 1;
                            }
                            if (tsd == 0 && tsk == TK_COMMA()) { tac = tac + 1; }
                            tsi = tsi + 1;
                        }
                        let tsig = "";
                        let tai = 0;
                        while (tai < tac) {
                            if (tai > 0) { tsig = str_concat(tsig, ", "); }
                            tsig = str_concat(tsig, "int64_t");
                            tai = tai + 1;
                        }
                        tr_emit(c, str_concat("((", str_concat(tup_type, str_concat("(*)(", str_concat(tsig, str_concat("))", str_concat(sanitize_c_name(trn), ")(")))))));
                        let tfa = 1;
                        while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                            if (tfa == 0) { tr_emit(c, ", "); c = tr_advance(c); }
                            c = translate_expr(c);
                            tfa = 0;
                        }
                        if (!tr_at_end(c)) { c = tr_advance(c); }
                        tr_emit(c, ")");
                    }
                }
                if (tup_rhs_done == 0) {
                    c = translate_expr(c);
                }
                tr_emit(c, ";\n");
                let ni2 = 0;
                while (ni2 < nlen2) {
                    if (vec_string_get(names, ni2) == "_") {
                        tr_emit_line(c, str_concat("(void)(", str_concat(tup_tmp, str_concat(".f", str_concat(fmt_int(ni2), ");")))));
                    } else {
                        tr_emit_line(c, str_concat("__auto_type ", str_concat(vec_string_get(names, ni2), str_concat(" = ", str_concat(tup_tmp, str_concat(".f", str_concat(fmt_int(ni2), ";")))))));
                    }
                    ni2 = ni2 + 1;
                }
            }
        } else {
            // No initializer — zero-init all bindings.
            let ni3 = 0;
            let nlen3 = vec_string_len(names);
            while (ni3 < nlen3) {
                tr_emit_line(c, str_concat("int64_t ", str_concat(vec_string_get(names, ni3), " = 0;")));
                ni3 = ni3 + 1;
            }
        }
        vec_string_free(names);

        if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        return c;
    }
    let vname = tr_lexeme(c); c = tr_advance(c);

    // Wildcard discard: let _ = expr; → (void)(expr);
    if (vname == "_") {
        // Skip optional type annotation
        if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
            c = tr_advance(c);
            while (!tr_at_end(c) && tr_kind(c) != TK_OP_ASSIGN() && tr_kind(c) != TK_SEMICOLON()) { c = tr_advance(c); }
        }
        if (!tr_at_end(c) && tr_kind(c) == TK_OP_ASSIGN()) {
            c = tr_advance(c);
            tr_emit_indent(c);
            tr_emit(c, "(void)(");
            c = translate_expr(c);
            tr_emit(c, ");\n");
        }
        if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
        return c;
    }

    let c_vname = sanitize_c_name(vname);

    let has_type = 0;
    let c_type = "__auto_type";
    let is_dyn_type = 0;
    let dyn_trait_name = "";
    if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
        c = tr_advance(c);
        let tk = tr_kind(c); let tn = tr_lexeme(c);
        if (tk == TK_KW_DYN()) { is_dyn_type = 1; }
        c_type = type_to_c(tk, tn); c = tr_advance(c);
        if (tk == TK_LBRACKET()) { c_type = "int64_t*"; }
        if (tk == TK_LPAREN()) {
            // Tuple type annotation: (T, U, ...) → count arity and map to KrTupleN
            // For nested tuples like ((int,int),(int,int)), flatten to total leaf count.
            let tup_paren_pos = c.pos - 1;
            let flat_arity = count_tuple_arity(c);
            let total_leaves = count_nested_tuple_leaves_at(c, tup_paren_pos);
            if (total_leaves != flat_arity && total_leaves >= 2 && total_leaves <= 10) {
                c_type = tuple_type_c(total_leaves);
                let struct_str = collect_tuple_structure_at(c, tup_paren_pos);
                sema_set(c, str_concat("ntup:", c_vname), struct_str);
            } else {
                c_type = tuple_type_c(flat_arity);
            }
            c = skip_tuple_type(c);
        }
        if (tk == TK_KW_DYN() && !tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) {
            dyn_trait_name = tr_lexeme(c);
            c = tr_advance(c);
        }
        c = skip_array_type_suffix(c, tk);
        c = skip_generic_params(c);
        if (tk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
        has_type = 1;
    }

    if (!tr_at_end(c) && tr_kind(c) == TK_OP_ASSIGN()) {
        c = tr_advance(c);
        if (is_dyn_type == 1 && dyn_trait_name != "") {
            // Dyn trait-object: construct KrDyn fat pointer with vtable.
            // let dc: dyn Shape = c; → { Type _tmp = c; dc = (KrDyn){ malloc+memcpy, &vtable }; }
            // Resolve concrete type from RHS: peek at current token
            let concrete = "";
            if (!tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) {
                let rhs_name = tr_lexeme(c);
                // Check if RHS is a struct literal: Name { ... }
                let rhs_next_pos = c.pos + 1;
                if (rhs_next_pos < c.count && vec_int_get(c.int_data, rhs_next_pos * 3) == TK_LBRACE()) {
                    concrete = rhs_name;
                } else {
                    // RHS is a variable — look up its declared type
                    let rhs_type = lookup_local_var_type_name(c, rhs_name);
                    if (rhs_type != "" && str_char_at(rhs_type, 0) >= 65 && str_char_at(rhs_type, 0) <= 90) {
                        concrete = rhs_type;
                    } else {
                        // Check if RHS var was initialized from a struct literal
                        concrete = lookup_dyn_concrete_type(c, rhs_name);
                    }
                }
            }
            if (concrete != "") {
                tr_emit_indent(c);
                tr_emit(c, str_concat(concrete, str_concat(" _dyn_tmp_", str_concat(c_vname, " = "))));
                c = translate_expr(c);
                tr_emit(c, ";\n");
                tr_emit_indent(c);
                tr_emit(c, str_concat("KrDyn ", str_concat(c_vname, str_concat(" = (KrDyn){ .data = malloc(sizeof(", str_concat(concrete, str_concat(")), .vtable = &_kr_", str_concat(concrete, str_concat("_", str_concat(dyn_trait_name, "_vt };\n")))))))));
                tr_emit_indent(c);
                tr_emit(c, str_concat("memcpy(", str_concat(c_vname, str_concat(".data, &_dyn_tmp_", str_concat(c_vname, str_concat(", sizeof(", str_concat(concrete, "));\n")))))));
            } else {
                // Fallback: can't resolve concrete type, just pass through
                tr_emit_indent(c);
                tr_emit(c, str_concat(c_type, str_concat(" ", str_concat(c_vname, " = "))));
                c = translate_expr(c);
                tr_emit(c, ";\n");
            }
        } else {
        tr_emit_indent(c);
        tr_emit(c, str_concat(c_type, str_concat(" ", str_concat(c_vname, " = "))));
        if (is_dyn_type == 1) {
            c = translate_expr(c);
        } else {
        if (c_type == "void*" || c_type == "uint8_t*" || c_type == "char*" || c_type == "kr_str") {
            tr_emit(c, str_concat("(", str_concat(c_type, ")(intptr_t)(")));
            c = translate_expr(c);
            tr_emit(c, ")");
        } else {
            c = translate_expr(c);
        }
        }
        tr_emit(c, ";\n");
        }
    } else {
        // Uninitialized declaration requires explicit type
        if (has_type == 0) { c_type = "int64_t"; }
        tr_emit_line(c, str_concat(c_type, str_concat(" ", str_concat(c_vname, ";"))));
    }

    if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// Return statement
// ---------------------------------------------------------------------------

fn translate_return(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    if (!tr_at_end(c) && tr_kind(c) != TK_SEMICOLON()) {
        tr_emit_indent(c);
        tr_emit(c, "return ");
        c = translate_expr(c);
        tr_emit(c, ";\n");
    } else {
        tr_emit_line(c, "return;");
    }
    if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// If statement
// ---------------------------------------------------------------------------

fn translate_if(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    tr_emit_indent(c);
    tr_emit(c, "if (");

    let had_paren = 0;
    if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) { c = tr_advance(c); had_paren = 1; }
    c = translate_expr(c);
    if (had_paren == 1 && !tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
    tr_emit(c, ") {\n");

    c = tr_advance(c);
    c = tr_indent(c);
    c = translate_block_body(c);
    c = tr_dedent(c);
    tr_emit_line(c, "}");

    if (!tr_at_end(c) && tr_kind(c) == TK_KW_ELSE()) {
        c = tr_advance(c);
        if (!tr_at_end(c) && tr_kind(c) == TK_KW_IF()) {
            tr_emit_indent(c);
            tr_emit(c, "else ");
            c = translate_if(c);
            return c;
        }
        tr_emit_line(c, "else {");
        c = tr_advance(c);
        c = tr_indent(c);
        c = translate_block_body(c);
        c = tr_dedent(c);
        tr_emit_line(c, "}");
    }
    return c;
}

// ---------------------------------------------------------------------------
// While loop
// ---------------------------------------------------------------------------

fn translate_while(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    tr_emit_indent(c);
    tr_emit(c, "while (");

    let had_paren = 0;
    if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) { c = tr_advance(c); had_paren = 1; }
    c = translate_expr(c);
    if (had_paren == 1 && !tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
    tr_emit(c, ") {\n");

    c = tr_advance(c);
    c = tr_indent(c);
    c = translate_block_body(c);
    c = tr_dedent(c);
    tr_emit_line(c, "}");
    return c;
}

// ---------------------------------------------------------------------------
// For loop
// ---------------------------------------------------------------------------

fn translate_for(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);
    let had_paren = 0;
    if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
        had_paren = 1;
        c = tr_advance(c);
    }

    if (tr_kind(c) == TK_KW_LET()) {
        c = tr_advance(c);
        let vname = tr_lexeme(c); c = tr_advance(c);

        // Check for 'in' keyword → for-in loop
        if (!tr_at_end(c) && tr_kind(c) == TK_KW_IN()) {
            c = tr_advance(c);
            return translate_for_in(c, vname);
        }

        tr_emit_indent(c);
        tr_emit(c, "for (");
        let c_type = "int64_t";
        if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
            c = tr_advance(c);
            let tk = tr_kind(c); let tn = tr_lexeme(c);
            c_type = type_to_c(tk, tn); c = tr_advance(c);
        }
        c = tr_advance(c);
        tr_emit(c, str_concat(c_type, str_concat(" ", str_concat(vname, " = "))));
        c = translate_expr(c);
    } else {
        // Check for: for (IDENT in ...) without let
        if (tr_kind(c) == TK_IDENTIFIER()) {
            let vname2 = tr_lexeme(c);
            let c2: Translator = tr_advance(c);
            if (!tr_at_end(c2) && tr_kind(c2) == TK_KW_IN()) {
                c = tr_advance(c2);
                return translate_for_in(c, vname2);
            }
        }
        tr_emit_indent(c);
        tr_emit(c, "for (");
        c = translate_expr(c);
    }
    if (had_paren == 1) { c = tr_advance(c); }
    tr_emit(c, "; ");

    c = translate_expr(c);
    if (had_paren == 1) { c = tr_advance(c); }
    tr_emit(c, "; ");

    // Increment: may be assignment like i = i + 1
    c = translate_expr(c);
    let ik = tr_kind(c);
    if (ik == TK_OP_ASSIGN() || ik == TK_OP_PLUS_ASSIGN() || ik == TK_OP_MINUS_ASSIGN()
        || ik == TK_OP_STAR_ASSIGN() || ik == TK_OP_SLASH_ASSIGN() || ik == TK_OP_PERCENT_ASSIGN()) {
        let op_lex = tr_lexeme(c);
        tr_emit(c, str_concat(" ", str_concat(op_lex, " ")));
        c = tr_advance(c);
        c = translate_expr(c);
    }
    if (had_paren == 1) { c = tr_advance(c); }
    tr_emit(c, ") {\n");

    c = tr_advance(c);
    c = tr_indent(c);
    c = translate_block_body(c);
    c = tr_dedent(c);
    tr_emit_line(c, "}");
    return c;
}

// ---------------------------------------------------------------------------
// Match statement → if / else if chains
// ---------------------------------------------------------------------------

fn is_match_arm_arrow(tr: Translator) -> bool {
    if (tr_at_end(tr)) { return false; }
    if (tr_kind(tr) == TK_ARROW()) { return true; }
    if (tr_kind(tr) == TK_OP_ASSIGN()) {
        if (tr.pos + 1 < tr.count && vec_int_get(tr.int_data, (tr.pos + 1) * 3) == TK_OP_GT()) {
            return true;
        }
    }
    return false;
}

fn skip_match_arm_arrow(tr: Translator) -> Translator {
    if (!tr_at_end(tr) && tr_kind(tr) == TK_ARROW()) { return tr_advance(tr); }
    if (!tr_at_end(tr) && tr_kind(tr) == TK_OP_ASSIGN()) {
        let c: Translator = tr_advance(tr);
        if (!tr_at_end(c) && tr_kind(c) == TK_OP_GT()) { return tr_advance(c); }
    }
    return tr;
}

fn translate_match(tr: Translator) -> Translator {
    return translate_match_simple(tr);
}

fn translate_match_simple(tr: Translator) -> Translator {
    let c: Translator = tr_advance(tr);

    // Skip '('
    if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) { c = tr_advance(c); }

    // Capture subject as raw lexeme string (handles identifiers and simple exprs)
    let subject = tr_lexeme(c);
    c = tr_advance(c);

    // If subject was a function call or member access, capture more
    // For now, handle simple identifiers — most common pattern
    if (!tr_at_end(c) && tr_kind(c) == TK_DOT()) {
        subject = str_concat(subject, ".");
        c = tr_advance(c);
        subject = str_concat(subject, tr_lexeme(c));
        c = tr_advance(c);
    }

    // Skip ')'
    if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
    // Skip '{'
    if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) { c = tr_advance(c); }

    let arm_idx = 0;
    while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
        let k = tr_kind(c);

        // Wildcard: _ -> { ... }
        if (k == TK_IDENTIFIER() && tr_lexeme(c) == "_") {
            c = tr_advance(c);
            // Optional guard: `_ if cond -> { ... }` or `_ if cond => { ... }`
            if (!tr_at_end(c) && tr_kind(c) == TK_KW_IF()) {
                while (!tr_at_end(c) && !is_match_arm_arrow(c)) { c = tr_advance(c); }
            }
            // Skip -> or =>
            c = skip_match_arm_arrow(c);
            if (arm_idx > 0) { tr_emit_line(c, "else if (1) {"); }
            else { tr_emit_indent(c); tr_emit(c, "if (1) {\n"); }
            if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) {
                c = tr_advance(c);
                c = tr_indent(c);
                c = translate_block_body(c);
                c = tr_dedent(c);
            } else {
                // Expression arm: _ => expr,
                c = tr_indent(c);
                tr_emit_indent(c);
                if (sema_get(c, "match_return") == "1") { tr_emit(c, "return "); }
                c = translate_expr(c);
                tr_emit(c, ";\n");
                if (!tr_at_end(c) && tr_kind(c) == TK_COMMA()) { c = tr_advance(c); }
                c = tr_dedent(c);
            }
            tr_emit_line(c, "}");
            arm_idx = arm_idx + 1;
        } else {
            // Pattern: value or EnumName::Variant (plus compatibility fallback for
            // ranges/or-patterns/guards)
            tr_emit_indent(c);
            if (arm_idx > 0) { tr_emit(c, "else "); }
            tr_emit(c, "if (");

            // Complex pattern fallback (e.g. `0..10`, `1 | 2 | 3`, `_ if cond`)
            // Scan up to `->` and lower to a neutral true condition.
            let is_complex_pat = 0;
            let is_struct_head = 0;
            if (k == TK_IDENTIFIER()) {
                let c_head: Translator = tr_advance(c);
                if (!tr_at_end(c_head) && tr_kind(c_head) == TK_LBRACE()) { is_struct_head = 1; }
            }
            if (is_struct_head == 0) {
                let s = c;
                while (!tr_at_end(s) && !is_match_arm_arrow(s)) {
                    let sk = tr_kind(s);
                    if (sk == TK_OP_DOT_DOT() || sk == TK_OP_DOT_DOT_EQ() || sk == TK_OP_BIT_OR() || sk == TK_KW_IF()) {
                        is_complex_pat = 1;
                    }
                    s = tr_advance(s);
                }
            }
            if (is_complex_pat == 1) {
                while (!tr_at_end(c) && !is_match_arm_arrow(c)) { c = tr_advance(c); }
                tr_emit(c, "1");
                tr_emit(c, ") {\n");
                c = skip_match_arm_arrow(c);
                if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) { c = tr_advance(c); }
                c = tr_indent(c);
                c = translate_block_body(c);
                c = tr_dedent(c);
                tr_emit_line(c, "}");
                arm_idx = arm_idx + 1;
                continue;
            }

            // Tuple pattern: (x, y) or ((x, y), z) -> { ... }
            if (k == TK_LPAREN()) {
                c = tr_advance(c);
                let tup_binds = "";
                let tup_idx = 0;
                let tup_depth = 1;
                while (!tr_at_end(c) && tup_depth > 0) {
                    if (tr_kind(c) == TK_LPAREN()) { tup_depth = tup_depth + 1; c = tr_advance(c); continue; }
                    if (tr_kind(c) == TK_RPAREN()) { tup_depth = tup_depth - 1; if (tup_depth == 0) { break; } c = tr_advance(c); continue; }
                    if (tr_kind(c) == TK_COMMA()) { c = tr_advance(c); continue; }
                    if (tr_kind(c) == TK_IDENTIFIER() && tr_lexeme(c) != "_") {
                        let bnd = sanitize_c_name(tr_lexeme(c));
                        tup_binds = str_concat(tup_binds, str_concat(bnd, str_concat(",", str_concat(fmt_int(tup_idx), ";"))));
                        tup_idx = tup_idx + 1;
                    }
                    c = tr_advance(c);
                }
                if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
                tr_emit(c, "1");
                tr_emit(c, ") {\n");
                // Skip -> or =>
                c = skip_match_arm_arrow(c);
                // Skip {
                if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) { c = tr_advance(c); }
                c = tr_indent(c);
                // Emit tuple bindings: int64_t x = subject.f0;
                let tb = 0;
                let tblen = strlen(tup_binds);
                while (tb < tblen) {
                    let ns = tb;
                    while (ns < tblen && str_char_at(tup_binds, ns) != 44) { ns = ns + 1; }
                    let bname = str_slice(tup_binds, tb, ns);
                    ns = ns + 1;
                    let is = ns;
                    while (is < tblen && str_char_at(tup_binds, is) != 59) { is = is + 1; }
                    let bidx = str_slice(tup_binds, ns, is);
                    tr_emit_line(c, str_concat("int64_t ", str_concat(bname, str_concat(" = ", str_concat(subject, str_concat(".f", str_concat(bidx, ";")))))));
                    tb = is + 1;
                }
                c = translate_block_body(c);
                c = tr_dedent(c);
                tr_emit_line(c, "}");
                arm_idx = arm_idx + 1;
                continue;
            }

            // Capture pattern value
            let bind_x = 0;
            let bind_y = 0;
            let bind_z = 0;
            let is_struct_pat = 0;
            let bind_payload = "";
            if (k == TK_IDENTIFIER()) {
                let pat_name = tr_lexeme(c); c = tr_advance(c);
                // Check for :: (enum variant)
                if (!tr_at_end(c) && tr_kind(c) == TK_COLON_COLON()) {
                    tr_emit(c, str_concat(subject, " == "));
                    c = tr_advance(c);
                    let variant = tr_lexeme(c); c = tr_advance(c);
                    tr_emit(c, str_concat(pat_name, str_concat("_", variant)));
                    // Skip optional payload binding (x)
                    if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
                        c = tr_advance(c);
                        if (!tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER() && tr_lexeme(c) != "_") {
                            bind_payload = sanitize_c_name(tr_lexeme(c));
                        }
                        while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) { c = tr_advance(c); }
                        c = tr_advance(c);
                    }
                } else {
                    // Struct pattern: Type { ... }
                    if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) {
                        is_struct_pat = 1;
                        c = tr_advance(c);
                        let depth_s = 1;
                        while (!tr_at_end(c) && depth_s > 0) {
                            let ks = tr_kind(c);
                            if (ks == TK_LBRACE()) { depth_s = depth_s + 1; }
                            if (ks == TK_RBRACE()) { depth_s = depth_s - 1; }
                            if (depth_s == 1 && ks == TK_IDENTIFIER()) {
                                let ln = tr_lexeme(c);
                                if (ln == "x") { bind_x = 1; }
                                if (ln == "y") { bind_y = 1; }
                                if (ln == "z") { bind_z = 1; }
                            }
                            c = tr_advance(c);
                        }
                        tr_emit(c, "1");
                    } else {
                        // Identifier pattern binding (e.g. `n -> { ... }`) is exhaustive.
                        // Keep compatibility by lowering to a true branch and synthetic bind.
                        if (strlen(pat_name) > 0) {
                            let chp = str_char_at(pat_name, 0);
                            if (chp >= 97 && chp <= 122) {
                                bind_payload = sanitize_c_name(pat_name);
                                tr_emit(c, "1");
                            } else {
                                tr_emit(c, str_concat(subject, " == "));
                                tr_emit(c, pat_name);
                            }
                        } else {
                            tr_emit(c, "1");
                        }
                    }
                }
            } else {
                // Integer or string literal
                tr_emit(c, str_concat(subject, " == "));
                if (k == TK_STRING_LIT()) {
                    tr_emit(c, str_concat("\"", str_concat(tr_lexeme(c), "\"")));
                } else {
                    tr_emit(c, tr_lexeme(c));
                }
                c = tr_advance(c);
            }

            tr_emit(c, ") {\n");

            // Skip -> or =>
            c = skip_match_arm_arrow(c);

            c = tr_indent(c);
            if (bind_payload != "") { tr_emit_line(c, str_concat("int64_t ", str_concat(bind_payload, " = 0;"))); }
            if (bind_x == 1) { tr_emit_line(c, "int64_t x = 0;"); }
            if (bind_y == 1) { tr_emit_line(c, "int64_t y = 0;"); }
            if (bind_z == 1) { tr_emit_line(c, "int64_t z = 0;"); }
            if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) {
                c = tr_advance(c);
                c = translate_block_body(c);
            } else {
                // Expression arm: pattern => expr,
                tr_emit_indent(c);
                if (sema_get(c, "match_return") == "1") { tr_emit(c, "return "); }
                c = translate_expr(c);
                tr_emit(c, ";\n");
                if (!tr_at_end(c) && tr_kind(c) == TK_COMMA()) { c = tr_advance(c); }
            }
            c = tr_dedent(c);
            tr_emit_line(c, "}");
            arm_idx = arm_idx + 1;
        }
    }
    if (!tr_at_end(c)) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// For-in loop → C for loop with range
// ---------------------------------------------------------------------------

fn translate_for_in(tr: Translator, vname: string) -> Translator {
    // At entry: c is past 'in', pointing at iterable expression
    let c: Translator = tr;

    // Look ahead to detect range (..) vs array iteration
    let is_range = 0;
    let la = c.pos + 1;
    if (la < c.count) {
        let lak = vec_int_get(c.int_data, la * 3);
        if (lak == TK_OP_DOT_DOT() || lak == TK_OP_DOT_DOT_EQ()) { is_range = 1; }
    }

    if (is_range == 1) {
        // Range iteration: for i in start..end → for (int64_t i = start; i < end; i++)
        tr_emit_indent(c);
        tr_emit(c, "for (");
        let range_start = tr_lexeme(c); c = tr_advance(c);
        let inclusive = 0;
        if (!tr_at_end(c) && tr_kind(c) == TK_OP_DOT_DOT_EQ()) {
            inclusive = 1;
            c = tr_advance(c);
        } else {
            if (!tr_at_end(c) && tr_kind(c) == TK_OP_DOT_DOT()) {
                c = tr_advance(c);
                if (!tr_at_end(c) && tr_kind(c) == TK_OP_ASSIGN()) {
                    inclusive = 1;
                    c = tr_advance(c);
                }
            }
        }
        let range_end = tr_lexeme(c); c = tr_advance(c);
        if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
        let cmp = " < ";
        if (inclusive == 1) { cmp = " <= "; }
        tr_emit(c, str_concat("int64_t ", str_concat(vname, str_concat(" = ", str_concat(range_start, str_concat("; ", str_concat(vname, str_concat(cmp, str_concat(range_end, str_concat("; ", str_concat(vname, "++")))))))))));
        tr_emit(c, ") {\n");
        c = tr_advance(c);
        c = tr_indent(c);
        c = translate_block_body(c);
        c = tr_dedent(c);
        tr_emit_line(c, "}");
        return c;
    }

    // Array iteration: for item in arr → { auto _arr = arr; for (i=0; i<len; i++) { auto item = get(arr,i); body } }
    let uid = fmt_int(c.pos);
    let arr_var = str_concat("_kr_arr_", uid);
    let idx_var = str_concat("_kr_i_", uid);
    tr_emit_line(c, "{");
    c = tr_indent(c);
    tr_emit_indent(c);
    tr_emit(c, str_concat("__auto_type ", str_concat(arr_var, " = ")));
    // Emit array expression — if it's a simple identifier followed by { or ),
    // emit directly to avoid translate_expr interpreting name { as struct literal
    if (tr_kind(c) == TK_IDENTIFIER()) {
        let next_pos = c.pos + 1;
        let next_is_body = 0;
        if (next_pos < c.count) {
            let nk = vec_int_get(c.int_data, next_pos * 3);
            if (nk == TK_LBRACE() || nk == TK_RPAREN()) { next_is_body = 1; }
        }
        if (next_is_body == 1) {
            tr_emit(c, sanitize_c_name(tr_lexeme(c)));
            c = tr_advance(c);
        } else {
            c = translate_expr(c);
        }
    } else {
        c = translate_expr(c);
    }
    tr_emit(c, ";\n");
    if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
    tr_emit_indent(c);
    let for_hdr = str_concat("for (int64_t ", str_concat(idx_var, str_concat(" = 0; ", str_concat(idx_var, str_concat(" < kr_vec_int_len(", str_concat(arr_var, str_concat("); ", str_concat(idx_var, "++)") )))))));
    tr_emit(c, for_hdr);
    tr_emit(c, " {\n");
    c = tr_advance(c);
    c = tr_indent(c);
    tr_emit_line(c, str_concat("__auto_type ", str_concat(sanitize_c_name(vname), str_concat(" = kr_vec_int_get(", str_concat(arr_var, str_concat(", ", str_concat(idx_var, ");")))))));
    c = translate_block_body(c);
    c = tr_dedent(c);
    tr_emit_line(c, "}");
    c = tr_dedent(c);
    tr_emit_line(c, "}");
    return c;
}

// ---------------------------------------------------------------------------
// Expression statement
// ---------------------------------------------------------------------------

fn translate_expr_stmt(tr: Translator) -> Translator {
    // Tuple assignment: (a, b) = (x, y);
    // Emit per-element assignments when RHS is a tuple literal.
    if (tr_kind(tr) == TK_LPAREN()) {
        let i = tr.pos + 1;
        let depth = 1;
        let has_tuple_comma = 0;
        while (i < tr.count && depth > 0) {
            let kk = vec_int_get(tr.int_data, i * 3);
            if (kk == TK_LPAREN()) { depth = depth + 1; }
            if (kk == TK_RPAREN()) { depth = depth - 1; }
            if (depth == 1 && kk == TK_COMMA()) { has_tuple_comma = 1; }
            i = i + 1;
        }
        if (has_tuple_comma == 1 && i < tr.count) {
            let ak = vec_int_get(tr.int_data, i * 3);
            if (ak == TK_OP_ASSIGN() || ak == TK_OP_PLUS_ASSIGN() || ak == TK_OP_MINUS_ASSIGN()
                || ak == TK_OP_STAR_ASSIGN() || ak == TK_OP_SLASH_ASSIGN() || ak == TK_OP_PERCENT_ASSIGN()) {
                // Collect LHS names
                let lhs_names = vec_string_new();
                let ci: Translator = tr_advance(tr);
                while (!tr_at_end(ci) && tr_kind(ci) != TK_RPAREN()) {
                    if (tr_kind(ci) == TK_IDENTIFIER()) { vec_string_push(lhs_names, tr_lexeme(ci)); }
                    ci = tr_advance(ci);
                    if (!tr_at_end(ci) && tr_kind(ci) == TK_COMMA()) { ci = tr_advance(ci); }
                }
                if (!tr_at_end(ci) && tr_kind(ci) == TK_RPAREN()) { ci = tr_advance(ci); }
                // Skip assignment operator
                let op_lex = "=";
                if (!tr_at_end(ci)) { op_lex = tr_lexeme(ci); ci = tr_advance(ci); }
                if (!tr_at_end(ci) && tr_kind(ci) == TK_LPAREN()) {
                    // RHS is tuple literal — per-element assignment
                    ci = tr_advance(ci);
                    let ei = 0;
                    let elen = vec_string_len(lhs_names);
                    while (!tr_at_end(ci) && tr_kind(ci) != TK_RPAREN()) {
                        if (ei > 0 && !tr_at_end(ci) && tr_kind(ci) == TK_COMMA()) { ci = tr_advance(ci); }
                        tr_emit_indent(ci);
                        if (ei < elen) {
                            tr_emit(ci, str_concat(vec_string_get(lhs_names, ei), str_concat(" ", str_concat(op_lex, " "))));
                        } else {
                            tr_emit(ci, "(void)(");
                        }
                        ci = translate_expr(ci);
                        if (ei >= elen) { tr_emit(ci, ")"); }
                        tr_emit(ci, ";\n");
                        ei = ei + 1;
                    }
                    if (!tr_at_end(ci) && tr_kind(ci) == TK_RPAREN()) { ci = tr_advance(ci); }
                } else {
                    // RHS is not a tuple — evaluate as (void) expression
                    tr_emit_indent(ci);
                    tr_emit(ci, "(void)(");
                    ci = translate_expr(ci);
                    tr_emit(ci, ");\n");
                }
                vec_string_free(lhs_names);
                if (!tr_at_end(ci) && tr_kind(ci) == TK_SEMICOLON()) { ci = tr_advance(ci); }
                return ci;
            }
        }
    }

    tr_emit_indent(tr);
    let implicit_ret = sema_get(tr, "implicit_ret_pos");
    if (implicit_ret != "" && implicit_ret == fmt_int(tr.pos)) {
        tr_emit(tr, "return ");
    }
    let c: Translator = translate_expr(tr);

    let k = tr_kind(c);
    if (k == TK_OP_ASSIGN() || k == TK_OP_PLUS_ASSIGN() || k == TK_OP_MINUS_ASSIGN()
        || k == TK_OP_STAR_ASSIGN() || k == TK_OP_SLASH_ASSIGN() || k == TK_OP_PERCENT_ASSIGN()) {
        let op_lex = tr_lexeme(c);
        tr_emit(c, str_concat(" ", str_concat(op_lex, " ")));
        c = tr_advance(c);
        c = translate_expr(c);
    }

    tr_emit(c, ";\n");
    if (!tr_at_end(c) && tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); }
    return c;
}

// ---------------------------------------------------------------------------
// Expression — precedence climbing
// ---------------------------------------------------------------------------

fn translate_expr(tr: Translator) -> Translator { return translate_or(tr); }

fn translate_or(tr: Translator) -> Translator {
    let c: Translator = translate_and(tr);
    while (!tr_at_end(c) && tr_kind(c) == TK_OP_OR()) {
        tr_emit(c, " || "); c = tr_advance(c); c = translate_and(c);
    }
    return c;
}

fn translate_and(tr: Translator) -> Translator {
    let c: Translator = translate_bit_or(tr);
    while (!tr_at_end(c) && tr_kind(c) == TK_OP_AND()) {
        tr_emit(c, " && "); c = tr_advance(c); c = translate_bit_or(c);
    }
    return c;
}

fn translate_bit_or(tr: Translator) -> Translator {
    let c: Translator = translate_bit_xor(tr);
    while (!tr_at_end(c) && tr_kind(c) == TK_OP_BIT_OR()) {
        tr_emit(c, " | "); c = tr_advance(c); c = translate_bit_xor(c);
    }
    return c;
}

fn translate_bit_xor(tr: Translator) -> Translator {
    let c: Translator = translate_bit_and(tr);
    while (!tr_at_end(c) && tr_kind(c) == TK_OP_BIT_XOR()) {
        tr_emit(c, " ^ "); c = tr_advance(c); c = translate_bit_and(c);
    }
    return c;
}

fn translate_bit_and(tr: Translator) -> Translator {
    let c: Translator = translate_equality(tr);
    while (!tr_at_end(c) && tr_kind(c) == TK_OP_BIT_AND()) {
        tr_emit(c, " & "); c = tr_advance(c); c = translate_equality(c);
    }
    return c;
}

// Scan ahead from position to find == or != at paren depth 0.
// Returns: 0 = not found, 1 = found ==, 2 = found !=
fn scan_eq_ahead(tr: Translator) -> int {
    let i = tr.pos;
    let depth = 0;
    while (i < tr.count) {
        let k = vec_int_get(tr.int_data, i * 3);
        if (k == TK_LPAREN()) { depth = depth + 1; }
        if (k == TK_RPAREN()) { depth = depth - 1; }
        if (depth < 0) { return 0; }
        if (depth == 0 && (k == TK_OP_EQ() || k == TK_OP_NEQ())) {
            if (k == TK_OP_EQ()) { return 1; }
            return 2;
        }
        if (depth == 0 && (k == TK_SEMICOLON() || k == TK_LBRACE() || k == TK_RBRACE()
            || k == TK_COMMA() || k == TK_COLON()
            || k == TK_OP_AND() || k == TK_OP_OR()
            || k == TK_OP_BIT_AND() || k == TK_OP_BIT_OR() || k == TK_OP_BIT_XOR()
            || k == TK_OP_LSHIFT() || k == TK_OP_RSHIFT())) { return 0; }
        i = i + 1;
    }
    return 0;
}

fn translate_equality(tr: Translator) -> Translator {
    // Detect EXPR (== | !=) EXPR → _KR_EQ / _KR_NEQ macro (handles strings via _Generic)
    let eq_mode = scan_eq_ahead(tr);
    if (eq_mode > 0) {
        if (eq_mode == 1) { tr_emit(tr, "_KR_EQ("); }
        else { tr_emit(tr, "_KR_NEQ("); }
        let c: Translator = translate_comparison(tr);
        c = tr_advance(c);
        tr_emit(c, ", ");
        c = translate_comparison(c);
        tr_emit(c, ")");
        return c;
    }

    let c: Translator = translate_comparison(tr);
    return c;
}

fn translate_comparison(tr: Translator) -> Translator {
    let c: Translator = translate_shift(tr);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_OP_LT() || k == TK_OP_LTE() || k == TK_OP_GT() || k == TK_OP_GTE()) {
            tr_emit(c, str_concat(" ", str_concat(tr_lexeme(c), " ")));
            c = tr_advance(c); c = translate_shift(c);
        } else { break; }
    }
    return c;
}

fn translate_shift(tr: Translator) -> Translator {
    let c: Translator = translate_addition(tr);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_OP_LSHIFT() || k == TK_OP_RSHIFT()) {
            tr_emit(c, str_concat(" ", str_concat(tr_lexeme(c), " ")));
            c = tr_advance(c); c = translate_addition(c);
        } else { break; }
    }
    return c;
}

fn count_plus_before_minus(tr: Translator) -> int {
    let plus_count = 0;
    let si = tr.pos;
    let sd = 0;
    while (si < tr.count) {
        let sk = vec_int_get(tr.int_data, si * 3);
        if (sk == TK_LPAREN() || sk == TK_LBRACKET() || sk == TK_LBRACE()) { sd = sd + 1; }
        if (sk == TK_RPAREN() || sk == TK_RBRACKET() || sk == TK_RBRACE()) {
            if (sd == 0) { break; }
            sd = sd - 1;
        }
        if (sd == 0 && sk == TK_OP_PLUS()) { plus_count = plus_count + 1; }
        if (sd == 0 && sk == TK_OP_MINUS()) { break; }
        if (sd == 0 && (sk == TK_SEMICOLON() || sk == TK_COMMA() || sk == TK_COLON()
            || sk == TK_OP_AND() || sk == TK_OP_OR() || sk == TK_OP_EQ() || sk == TK_OP_NEQ()
            || sk == TK_OP_LT() || sk == TK_OP_LTE() || sk == TK_OP_GT() || sk == TK_OP_GTE()
            || sk == TK_OP_BIT_AND() || sk == TK_OP_BIT_OR() || sk == TK_OP_BIT_XOR()
            || sk == TK_OP_LSHIFT() || sk == TK_OP_RSHIFT() || sk == TK_OP_ASSIGN()
            || sk == TK_ARROW() || sk == TK_QUESTION())) { break; }
        si = si + 1;
    }
    return plus_count;
}

fn translate_addition(tr: Translator) -> Translator {
    // Pre-scan: count + operators before next - at this precedence level
    let plus_count = count_plus_before_minus(tr);
    // Emit _KR_ADD( prefixes for left-associative nesting
    let pi2 = 0;
    while (pi2 < plus_count) { tr_emit(tr, "_KR_ADD("); pi2 = pi2 + 1; }
    let c: Translator = translate_multiplication(tr);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_OP_PLUS()) {
            tr_emit(c, ", "); c = tr_advance(c); c = translate_multiplication(c);
            tr_emit(c, ")");
        } else {
            if (k == TK_OP_MINUS()) {
                // After -, recurse into translate_addition which re-scans for + from the new position
                tr_emit(c, " - "); c = tr_advance(c); c = translate_addition(c);
            } else { break; }
        }
    }
    return c;
}

fn translate_multiplication(tr: Translator) -> Translator {
    let c: Translator = translate_unary(tr);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_OP_STAR() || k == TK_OP_SLASH() || k == TK_OP_PERCENT()) {
            tr_emit(c, str_concat(" ", str_concat(tr_lexeme(c), " ")));
            c = tr_advance(c); c = translate_unary(c);
        } else { break; }
    }
    return c;
}

fn translate_unary(tr: Translator) -> Translator {
    let k = tr_kind(tr);
    if (k == TK_KW_MOVE()) { return translate_unary(tr_advance(tr)); }
    if (k == TK_OP_NOT()) { tr_emit(tr, "!"); return translate_unary(tr_advance(tr)); }
    if (k == TK_OP_MINUS()) { tr_emit(tr, "-"); return translate_unary(tr_advance(tr)); }
    if (k == TK_OP_BIT_NOT()) { tr_emit(tr, "~"); return translate_unary(tr_advance(tr)); }
    if (k == TK_OP_BIT_AND()) {
        tr_emit(tr, "((void*)(intptr_t)(");
        let c: Translator = translate_unary(tr_advance(tr));
        tr_emit(c, "))");
        return c;
    }
    if (k == TK_KW_AWAIT()) {
        tr_emit(tr, "((int64_t)(intptr_t)");
        let c: Translator = translate_unary(tr_advance(tr));
        tr_emit(c, ")");
        return c;
    }
    if (k == TK_KW_SPAWN()) {
        let c1: Translator = tr_advance(tr);
        if (!tr_at_end(c1) && tr_kind(c1) == TK_LBRACE()) {
            // Semantic lowering: spawn { ... } → null handle (C has no task runtime).
            let c2: Translator = skip_brace_block(c1);
            tr_emit(c2, "((void*)0)");
            return c2;
        }
        tr_emit(tr, "((void*)(intptr_t)");
        let c: Translator = translate_unary(c1);
        tr_emit(c, ")");
        return c;
    }
    return translate_postfix(tr);
}

fn translate_postfix(tr: Translator) -> Translator {
    let c: Translator = translate_primary(tr);
    while (!tr_at_end(c)) {
        let k = tr_kind(c);
        if (k == TK_QUESTION()) {
            // Try operator: consume postfix '?' (C has no Result type; error propagation deferred).
            c = tr_advance(c);
            continue;
        }
        if (k == TK_DOT()) {
            let c1: Translator = tr_advance(c);
            if (!tr_at_end(c1) && tr_kind(c1) == TK_INT_LIT()) {
                // Tuple field access: x.0 → x.f0, x.1 → x.f1, etc.
                tr_emit(c, str_concat(".f", tr_lexeme(c1)));
                c = tr_advance(c1);
                continue;
            }
            tr_emit(c, "."); c = tr_advance(c);
            tr_emit(c, tr_lexeme(c)); c = tr_advance(c);
        } else {
            if (k == TK_LPAREN()) {
                c = tr_advance(c);
                tr_emit(c, "(");
                let fa = 1;
                while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                    if (fa == 0) { tr_emit(c, ", "); c = tr_advance(c); }
                    c = translate_expr(c); fa = 0;
                }
                c = tr_advance(c);
                tr_emit(c, ")");
            } else {
                if (k == TK_LBRACKET()) {
                    tr_emit(c, "["); c = tr_advance(c);
                    c = translate_expr(c);
                    if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) {
                        c = tr_advance(c);
                        c = translate_expr(c);
                    }
                    c = tr_advance(c);
                    tr_emit(c, "]");
                } else { break; }
            }
        }
    }
    return c;
}

// ---------------------------------------------------------------------------
// Primary expression
// ---------------------------------------------------------------------------

fn translate_primary(tr: Translator) -> Translator {
    let k = tr_kind(tr);

    if (k == TK_INT_LIT()) { tr_emit(tr, tr_lexeme(tr)); return tr_advance(tr); }
    if (k == TK_FLOAT_LIT()) { tr_emit(tr, tr_lexeme(tr)); return tr_advance(tr); }
    if (k == TK_STRING_LIT()) {
        let slit = str_replace(tr_lexeme(tr), "\\\\!", "!");
        tr_emit(tr, str_concat("\"", str_concat(slit, "\"")));
        return tr_advance(tr);
    }
    if (k == TK_KW_TRUE()) { tr_emit(tr, "true"); return tr_advance(tr); }
    if (k == TK_KW_FALSE()) { tr_emit(tr, "false"); return tr_advance(tr); }
    if (k == TK_KW_NULL()) { tr_emit(tr, "NULL"); return tr_advance(tr); }

    // If-expression: if cond { expr } else { expr } → (cond) ? (expr) : (expr)
    if (k == TK_KW_IF()) {
        let c: Translator = tr_advance(tr);
        tr_emit(c, "(");
        // Translate condition up to the opening {
        while (!tr_at_end(c) && tr_kind(c) != TK_LBRACE()) {
            c = translate_expr(c);
        }
        tr_emit(c, ") ? (");
        // Skip { and translate body expression(s), take last value
        if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) { c = tr_advance(c); }
        while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
            if (tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); continue; }
            c = translate_expr(c);
        }
        if (!tr_at_end(c) && tr_kind(c) == TK_RBRACE()) { c = tr_advance(c); }
        tr_emit(c, ") : (");
        // else { expr }
        if (!tr_at_end(c) && tr_kind(c) == TK_KW_ELSE()) {
            c = tr_advance(c);
            if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) { c = tr_advance(c); }
            while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
                if (tr_kind(c) == TK_SEMICOLON()) { c = tr_advance(c); continue; }
                c = translate_expr(c);
            }
            if (!tr_at_end(c) && tr_kind(c) == TK_RBRACE()) { c = tr_advance(c); }
        } else {
            tr_emit(c, "0");
        }
        tr_emit(c, ")");
        return c;
    }

    if (k == TK_LPAREN()) {
        // Unit tuple: () → (KrTuple1){.f0=0}
        let maybe_unit = tr.pos + 1;
        if (maybe_unit < tr.count && vec_int_get(tr.int_data, maybe_unit * 3) == TK_RPAREN()) {
            tr_emit(tr, "(KrTuple1){.f0=0}");
            let cu: Translator = tr_advance(tr);
            cu = tr_advance(cu);
            return cu;
        }
        // Tuple literal: (a, b, ...) → C comma-expression (evaluates all, returns last).
        let i = tr.pos + 1;
        let depth = 1;
        let has_tuple_comma = 0;
        while (i < tr.count && depth > 0) {
            let kk = vec_int_get(tr.int_data, i * 3);
            if (kk == TK_LPAREN()) { depth = depth + 1; }
            if (kk == TK_RPAREN()) { depth = depth - 1; }
            if (depth == 1 && kk == TK_COMMA()) { has_tuple_comma = 1; }
            i = i + 1;
        }
        if (has_tuple_comma == 1) {
            // Tuple literal: (a, b, c) → (KrTupleN){.f0 = a, .f1 = b, .f2 = c}
            let elem_count = 1;
            let j2 = tr.pos + 1;
            let jd2 = 1;
            while (j2 < tr.count && jd2 > 0) {
                let jk2 = vec_int_get(tr.int_data, j2 * 3);
                if (jk2 == TK_LPAREN()) { jd2 = jd2 + 1; }
                if (jk2 == TK_RPAREN()) { jd2 = jd2 - 1; }
                if (jd2 == 1 && jk2 == TK_COMMA()) { elem_count = elem_count + 1; }
                j2 = j2 + 1;
            }
            if (elem_count < 2) { elem_count = 2; }
            if (elem_count > 10) { elem_count = 10; }
            tr_emit(tr, str_concat("(KrTuple", str_concat(fmt_int(elem_count), "){")));
            let c: Translator = tr_advance(tr);
            let fi = 0;
            while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                if (fi > 0) {
                    c = tr_advance(c);
                    // Trailing comma: (42,) → skip comma, break before emitting another field
                    if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { break; }
                    tr_emit(c, ", ");
                }
                tr_emit(c, str_concat(".f", str_concat(fmt_int(fi), " = ")));
                c = translate_expr(c); fi = fi + 1;
            }
            if (!tr_at_end(c)) { c = tr_advance(c); }
            tr_emit(c, "}");
            return c;
        }

        tr_emit(tr, "(");
        let c: Translator = tr_advance(tr);
        c = translate_expr(c);
        if (!tr_at_end(c) && tr_kind(c) == TK_RPAREN()) { c = tr_advance(c); }
        tr_emit(c, ")");
        return c;
    }

    if (k == TK_PIPE() || k == TK_OP_BIT_OR() || k == TK_OP_OR()) {
        // Closure literal: emit function pointer to the static function generated by
        // emit_closure_statics (uses token position as unique ID).
        let cl_name = str_concat("_kr_cl_", fmt_int(tr.pos));
        let c: Translator = tr_advance(tr);
        if (k != TK_OP_OR()) {
            while (!tr_at_end(c) && tr_kind(c) != TK_PIPE() && tr_kind(c) != TK_OP_BIT_OR() && tr_kind(c) != TK_OP_OR()) { c = tr_advance(c); }
            if (!tr_at_end(c)) { c = tr_advance(c); }
        }
        // Skip optional return type annotation (must handle complex types like tuples, arrays, fn types)
        if (!tr_at_end(c) && tr_kind(c) == TK_ARROW()) {
            c = tr_advance(c);
            if (!tr_at_end(c)) {
                let rtk = tr_kind(c);
                c = tr_advance(c);
                if (rtk == TK_LPAREN()) { c = skip_tuple_type(c); }
                if (rtk == TK_LBRACKET()) { c = skip_array_type_suffix(c, rtk); }
                c = skip_generic_params(c);
                if (rtk == TK_KW_FN()) { c = skip_fn_type_sig(c); }
            }
        }

        if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) {
            c = skip_brace_block(c);
        } else {
            let pd = 0;
            let bd = 0;
            let qd = 0;
            while (!tr_at_end(c)) {
                let kk = tr_kind(c);
                if (kk == TK_LPAREN()) { pd = pd + 1; c = tr_advance(c); continue; }
                if (kk == TK_RPAREN()) {
                    if (pd == 0 && bd == 0 && qd == 0) { break; }
                    pd = pd - 1; c = tr_advance(c); continue;
                }
                if (kk == TK_LBRACE()) { bd = bd + 1; c = tr_advance(c); continue; }
                if (kk == TK_RBRACE()) {
                    if (pd == 0 && bd == 0 && qd == 0) { break; }
                    bd = bd - 1; c = tr_advance(c); continue;
                }
                if (kk == TK_LBRACKET()) { qd = qd + 1; c = tr_advance(c); continue; }
                if (kk == TK_RBRACKET()) {
                    if (pd == 0 && bd == 0 && qd == 0) { break; }
                    qd = qd - 1; c = tr_advance(c); continue;
                }
                if (pd == 0 && bd == 0 && qd == 0) {
                    if (kk == TK_COMMA() || kk == TK_SEMICOLON()) { break; }
                }
                c = tr_advance(c);
            }
        }
        // Fat closure: emit _kr_cl_alloc(fn, cap_count, cap1, cap2, ...)
        let cap_key = str_concat("cl:", str_concat(fmt_int(tr.pos), ":caps"));
        let cap_list = sema_get(c, cap_key);
        if (cap_list != "") {
            // Count captures
            let ncaps = 1;
            let ci7 = 0;
            let clen6 = strlen(cap_list);
            while (ci7 < clen6) {
                if (str_char_at(cap_list, ci7) == 44) { ncaps = ncaps + 1; }
                ci7 = ci7 + 1;
            }
            tr_emit(c, str_concat("_kr_cl_alloc((void*)", str_concat(cl_name, str_concat(", ", str_concat(fmt_int(ncaps), ", ")))));
            // Emit each capture as (int64_t)name
            ci7 = 0;
            let cfirst = 1;
            while (ci7 < clen6) {
                let cstart6 = ci7;
                while (ci7 < clen6 && str_char_at(cap_list, ci7) != 44) { ci7 = ci7 + 1; }
                let cname4 = str_slice(cap_list, cstart6, ci7);
                let scname4 = sanitize_c_name(cname4);
                if (cfirst == 0) { tr_emit(c, ", "); }
                tr_emit(c, str_concat("(int64_t)", scname4));
                cfirst = 0;
                if (ci7 < clen6) { ci7 = ci7 + 1; }
            }
            tr_emit(c, ")");
        } else {
            // No captures: allocate fat closure with 0 captures
            tr_emit(c, str_concat("_kr_cl_alloc((void*)", str_concat(cl_name, ", 0)")));
        }
        return c;
    }

    // Array literal: [expr, expr, ...] → _kr_vec_int_of(n, ...) or _kr_vec_string_of(n, ...)
    if (k == TK_LBRACKET()) {
        let c: Translator = tr_advance(tr);
        let is_str_arr = 0;
        if (!tr_at_end(c) && tr_kind(c) == TK_STRING_LIT()) { is_str_arr = 1; }
        // Count elements by scanning ahead for commas at depth 0
        let elem_count = 0;
        if (!tr_at_end(c) && tr_kind(c) != TK_RBRACKET()) {
            elem_count = 1;
            let sc = c.pos;
            let sd = 0;
            let last_was_comma = 0;
            while (sc < c.count) {
                let sk = vec_int_get(c.int_data, sc * 3);
                if (sk == TK_LBRACKET() || sk == TK_LPAREN() || sk == TK_LBRACE()) { sd = sd + 1; last_was_comma = 0; }
                if (sk == TK_RBRACKET() || sk == TK_RPAREN() || sk == TK_RBRACE()) {
                    if (sd == 0) { break; }
                    sd = sd - 1;
                    last_was_comma = 0;
                }
                if (sd == 0 && sk == TK_COMMA()) { elem_count = elem_count + 1; last_was_comma = 1; }
                else { last_was_comma = 0; }
                sc = sc + 1;
            }
            // Trailing comma correction: [a, b,] has 2 commas but 2 elements, not 3
            if (last_was_comma == 1) { elem_count = elem_count - 1; }
        }
        // Pre-scan: check if ] is immediately followed by [ (subscript)
        let has_imm_sub = 0;
        let sc2 = c.pos;
        let sd2 = 0;
        while (sc2 < c.count) {
            let sk2 = vec_int_get(c.int_data, sc2 * 3);
            if (sk2 == TK_LBRACKET()) { sd2 = sd2 + 1; }
            if (sk2 == TK_RBRACKET()) {
                if (sd2 == 0) { break; }
                sd2 = sd2 - 1;
            }
            sc2 = sc2 + 1;
        }
        if (sc2 + 1 < c.count && vec_int_get(c.int_data, (sc2 + 1) * 3) == TK_LBRACKET()) {
            has_imm_sub = 1;
        }
        if (has_imm_sub == 1) { tr_emit(c, "kr_vec_int_get("); }
        if (elem_count == 0) {
            if (is_str_arr == 1) { tr_emit(c, "kr_vec_string_new()"); }
            else { tr_emit(c, "kr_vec_int_new()"); }
            if (!tr_at_end(c)) { c = tr_advance(c); }
        } else {
            if (is_str_arr == 1) {
                tr_emit(c, str_concat("_kr_vec_string_of(", str_concat(fmt_int(elem_count), ", ")));
            } else {
                tr_emit(c, str_concat("_kr_vec_int_of(", str_concat(fmt_int(elem_count), ", ")));
            }
            let af = 1;
            while (!tr_at_end(c) && tr_kind(c) != TK_RBRACKET()) {
                if (af == 0) {
                    c = tr_advance(c);
                    // Trailing comma: [a, b,] — skip comma, break before emitting another element
                    if (!tr_at_end(c) && tr_kind(c) == TK_RBRACKET()) { break; }
                    tr_emit(c, ", ");
                }
                if (is_str_arr == 0) { tr_emit(c, "(int64_t)"); }
                c = translate_expr(c); af = 0;
            }
            if (!tr_at_end(c)) { c = tr_advance(c); }
            tr_emit(c, ")");
        }
        if (has_imm_sub == 1) {
            // Handle immediate subscript: [1,2,3][0] → kr_vec_int_get(..., 0)
            c = tr_advance(c);
            tr_emit(c, ", ");
            c = translate_expr(c);
            if (!tr_at_end(c) && tr_kind(c) == TK_RBRACKET()) { c = tr_advance(c); }
            tr_emit(c, ")");
        }
        return c;
    }

    if (k == TK_IDENTIFIER() || k == TK_KW_SELF()) {
        let name = tr_lexeme(tr);
        let c: Translator = tr_advance(tr);
        c = maybe_skip_turbofish(c);

        // Name::member(...)
        // - lower-case member with call syntax => associated function: kr_Name_member(...)
        // - otherwise => enum variant constant: Name_Member
        if (!tr_at_end(c) && tr_kind(c) == TK_COLON_COLON()) {
            c = tr_advance(c);
            // Turbofish: name::<Type>(args) → kr_name(args)
            if (!tr_at_end(c) && tr_kind(c) == TK_OP_LT()) {
                c = skip_generic_params(c);
                let mangled = mangle_top_level_fn_name(name);
                if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
                    c = tr_advance(c);
                    tr_emit(c, str_concat(mangled, "("));
                    let fa = 1;
                    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                        if (fa == 0) { tr_emit(c, ", "); c = tr_advance(c); }
                        c = translate_expr(c); fa = 0;
                    }
                    c = tr_advance(c);
                    tr_emit(c, ")");
                    return c;
                }
                tr_emit(c, mangled);
                return c;
            }
            let member = tr_lexeme(c); c = tr_advance(c);

            if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN() && strlen(member) > 0) {
                let ch0 = str_char_at(member, 0);
                if (ch0 >= 97 && ch0 <= 122) {
                    c = tr_advance(c);
                    tr_emit(c, str_concat("kr_", str_concat(name, str_concat("_", str_concat(member, "(")))));
                    let fa = 1;
                    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                        if (fa == 0) { tr_emit(c, ", "); c = tr_advance(c); }
                        c = translate_expr(c); fa = 0;
                    }
                    c = tr_advance(c);
                    tr_emit(c, ")");
                    return c;
                }
            }

            tr_emit(c, str_concat(name, str_concat("_", member)));
            if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
                c = tr_advance(c);
                while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) { c = tr_advance(c); }
                c = tr_advance(c);
            }
            return c;
        }

        // Function call
        if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
            // Pre-scan for chained calls: name(a)(b)(c) — count chains and their arg counts
            let chain_args = vec_int_new();
            let csp = c.pos + 1;
            let csd = 1;
            while (csp < c.count && csd > 0) {
                let csk = vec_int_get(c.int_data, csp * 3);
                if (csk == TK_LPAREN() || csk == TK_LBRACKET() || csk == TK_LBRACE()) { csd = csd + 1; }
                if (csk == TK_RPAREN() || csk == TK_RBRACKET() || csk == TK_RBRACE()) { csd = csd - 1; }
                csp = csp + 1;
            }
            while (csp < c.count && vec_int_get(c.int_data, csp * 3) == TK_LPAREN()) {
                csp = csp + 1;
                let cca = 0;
                if (csp < c.count && vec_int_get(c.int_data, csp * 3) != TK_RPAREN()) { cca = 1; }
                csd = 1;
                while (csp < c.count && csd > 0) {
                    let csk = vec_int_get(c.int_data, csp * 3);
                    if (csk == TK_LPAREN() || csk == TK_LBRACKET() || csk == TK_LBRACE()) { csd = csd + 1; }
                    if (csk == TK_RPAREN() || csk == TK_RBRACKET() || csk == TK_RBRACE()) { csd = csd - 1; }
                    if (csd == 1 && csk == TK_COMMA()) { cca = cca + 1; }
                    csp = csp + 1;
                }
                vec_int_push(chain_args, cca);
            }
            let chain_count = vec_int_len(chain_args);

            // Emit chained fat closure call prefixes (outermost first = reverse order)
            let ci = chain_count - 1;
            while (ci >= 0) {
                let ca2 = vec_int_get(chain_args, ci);
                tr_emit(c, str_concat("_kr_cl_call", str_concat(fmt_int(ca2), "((void*)")));
                ci = ci - 1;
            }

            c = tr_advance(c);
            if (is_local_fn_var(tr, name)) {
                // Fat closure call: ((ret(*)(void*,params))_KR_CL_FN(name))(_KR_CL_ENV(name), args)
                // Pre-scan to count arguments
                let arg_count = 0;
                if (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) { arg_count = 1; }
                let si = c.pos;
                let sd = 0;
                while (si < c.count) {
                    let sk = vec_int_get(c.int_data, si * 3);
                    if (sk == TK_LPAREN() || sk == TK_LBRACKET() || sk == TK_LBRACE()) { sd = sd + 1; }
                    if (sk == TK_RPAREN() || sk == TK_RBRACKET() || sk == TK_RBRACE()) {
                        if (sd == 0) { break; }
                        sd = sd - 1;
                    }
                    if (sd == 0 && sk == TK_COMMA()) { arg_count = arg_count + 1; }
                    si = si + 1;
                }
                // Build signature: void* for env + int64_t per arg
                let sig = "void*";
                let ai = 0;
                while (ai < arg_count) {
                    sig = str_concat(sig, ", int64_t");
                    ai = ai + 1;
                }
                let sname = sanitize_c_name(name);
                tr_emit(c, str_concat("((int64_t(*)(", str_concat(sig, str_concat("))_KR_CL_FN(", str_concat(sname, str_concat("))(_KR_CL_ENV(", str_concat(sname, ")")))))));
                // Translate arguments
                let fa = 1;
                while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                    tr_emit(c, ", ");
                    if (fa == 0) { c = tr_advance(c); }
                    c = translate_expr(c);
                    fa = 0;
                }
                if (!tr_at_end(c)) { c = tr_advance(c); }
                tr_emit(c, ")");
            } else {
            tr_emit(c, str_concat(mangle_top_level_fn_name(name), "("));
            let fa = 1;
            while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                if (fa == 0) { tr_emit(c, ", "); c = tr_advance(c); }
                if (name == "block_on" && fa == 1) {
                    tr_emit(c, "(void*)(intptr_t)(");
                    c = translate_expr(c);
                    tr_emit(c, ")");
                } else {
                    if (name == "strcmp") {
                        tr_emit(c, "(kr_str)(intptr_t)(");
                        c = translate_expr(c);
                        tr_emit(c, ")");
                    } else {
                    if (name == "fmt_int") {
                        tr_emit(c, "(int64_t)(intptr_t)(");
                        c = translate_expr(c);
                        tr_emit(c, ")");
                    } else {
                        c = translate_expr(c);
                    }
                    }
                }
                fa = 0;
            }
            c = tr_advance(c);
            tr_emit(c, ")");
            }

            // Handle chained call suffixes: , args) for each chain level
            let cci = 0;
            while (cci < chain_count) {
                if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) {
                    c = tr_advance(c);
                    let fa2 = 1;
                    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                        tr_emit(c, ", ");
                        if (fa2 == 0) { c = tr_advance(c); }
                        c = translate_expr(c);
                        fa2 = 0;
                    }
                    if (!tr_at_end(c)) { c = tr_advance(c); }
                    tr_emit(c, ")");
                }
                cci = cci + 1;
            }
            return c;
        }

        // Struct literal: Name { field: value, ... }
        // Disambiguate from block braces by checking for IDENTIFIER COLON inside
        if (!tr_at_end(c) && tr_kind(c) == TK_LBRACE()) {
        let is_struct_lit = 0;
        let pk1 = c.pos + 1;
        // Empty struct literal: Name {}
        if (pk1 < c.count && vec_int_get(c.int_data, pk1 * 3) == TK_RBRACE()) {
            is_struct_lit = 1;
        }
        // Field struct literal: Name { field: value, ... }
        if (pk1 < c.count && vec_int_get(c.int_data, pk1 * 3) == TK_IDENTIFIER()) {
            let pk2 = pk1 + 1;
            if (pk2 < c.count && vec_int_get(c.int_data, pk2 * 3) == TK_COLON()) {
                is_struct_lit = 1;
            }
        }
        if (is_struct_lit == 1) {
            c = tr_advance(c);
            tr_emit(c, str_concat("(", str_concat(name, "){")));
            let ff = 1;
            while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
                if (ff == 0) {
                    // Skip comma separator; handle trailing comma
                    c = tr_advance(c);
                    if (tr_kind(c) == TK_RBRACE()) { break; }
                    tr_emit(c, ", ");
                }
                let field_name = tr_lexeme(c); c = tr_advance(c); c = tr_advance(c);
                tr_emit(c, str_concat(".", str_concat(field_name, " = ")));
                if (!tr_at_end(c) && tr_kind(c) == TK_IDENTIFIER()) {
                    let c1: Translator = tr_advance(c);
                    if (!tr_at_end(c1) && tr_kind(c1) == TK_LBRACE()) {
                        // Nested struct literal: Name { field: val, ... }
                        let nested_name = tr_lexeme(c);
                        c = tr_advance(c1);
                        tr_emit(c, str_concat("(", str_concat(nested_name, "){")));
                        let nf = 1;
                        while (!tr_at_end(c) && tr_kind(c) != TK_RBRACE()) {
                            if (nf == 0) {
                                c = tr_advance(c);
                                if (tr_kind(c) == TK_RBRACE()) { break; }
                                tr_emit(c, ", ");
                            }
                            let nfname = tr_lexeme(c); c = tr_advance(c); c = tr_advance(c);
                            tr_emit(c, str_concat(".", str_concat(nfname, " = ")));
                            c = translate_expr(c); nf = 0;
                        }
                        c = tr_advance(c);
                        tr_emit(c, "}");
                        ff = 0;
                        continue;
                    }
                }
                c = translate_expr(c); ff = 0;
            }
            c = tr_advance(c);
            tr_emit(c, "}");
            return c;
        }
        }

        // Method call on typed local variable:
        //   obj.method(a, b) -> kr_Type_method(obj, a, b)
        if (!tr_at_end(c) && tr_kind(c) == TK_DOT()) {
            let c1: Translator = tr_advance(c);
            if (!tr_at_end(c1) && tr_kind(c1) == TK_IDENTIFIER()) {
                let method = tr_lexeme(c1);
                let c2: Translator = tr_advance(c1);
                if (!tr_at_end(c2) && tr_kind(c2) == TK_LPAREN()) {
                    let recv_type = lookup_local_var_type_name(tr, name);
                    // Fallback: resolve type from untyped struct literal init
                    if (recv_type == "") {
                        recv_type = lookup_dyn_concrete_type(tr, name);
                    }
                    // Fallback: check sema for method existence on known types
                    if (recv_type == "") {
                        // Try sema i:Type::method for all registered struct types
                        let sema_key = str_concat("i:", str_concat(name, str_concat("::", method)));
                        if (sema_has(tr, sema_key)) {
                            // name itself is a type with this method — unlikely for a variable
                        }
                    }
                    if (recv_type != "") {
                        // Array method dispatch: result.push(x) → kr_vec_int_push(result, x)
                        if (recv_type == "[array]") {
                            let c3: Translator = tr_advance(c2);
                            tr_emit(c3, str_concat("kr_vec_int_", str_concat(method, str_concat("(", str_concat(sanitize_c_name(name), "")))));
                            if (!tr_at_end(c3) && tr_kind(c3) != TK_RPAREN()) { tr_emit(c3, ", "); }
                            let fa = 1;
                            while (!tr_at_end(c3) && tr_kind(c3) != TK_RPAREN()) {
                                if (fa == 0) { tr_emit(c3, ", "); c3 = tr_advance(c3); }
                                c3 = translate_expr(c3);
                                fa = 0;
                            }
                            if (!tr_at_end(c3)) { c3 = tr_advance(c3); }
                            tr_emit(c3, ")");
                            return c3;
                        }
                        // Dyn vtable dispatch: ((TraitName_VT*)obj.vtable)->method(obj.data)
                        if (strlen(recv_type) > 4 && str_char_at(recv_type, 0) == 100 && str_char_at(recv_type, 1) == 121 && str_char_at(recv_type, 2) == 110 && str_char_at(recv_type, 3) == 58) {
                            let dyn_trait = str_slice(recv_type, 4, strlen(recv_type));
                            let c3: Translator = tr_advance(c2);
                            tr_emit(c3, str_concat("((", str_concat(dyn_trait, str_concat("_VT*)", str_concat(sanitize_c_name(name), str_concat(".vtable)->", str_concat(method, str_concat("(", str_concat(sanitize_c_name(name), ".data")))))))));
                            // Translate additional args after self
                            while (!tr_at_end(c3) && tr_kind(c3) != TK_RPAREN()) {
                                tr_emit(c3, ", ");
                                c3 = translate_expr(c3);
                                if (!tr_at_end(c3) && tr_kind(c3) == TK_COMMA()) { c3 = tr_advance(c3); }
                            }
                            if (!tr_at_end(c3)) { c3 = tr_advance(c3); }
                            tr_emit(c3, ")");
                            return c3;
                        }
                        let c3: Translator = tr_advance(c2);
                        tr_emit(c3, str_concat("kr_", str_concat(recv_type, str_concat("_", str_concat(method, "(")))));
                        tr_emit(c3, name);
                        if (!tr_at_end(c3) && tr_kind(c3) != TK_RPAREN()) { tr_emit(c3, ", "); }
                        let fa = 1;
                        while (!tr_at_end(c3) && tr_kind(c3) != TK_RPAREN()) {
                            if (fa == 0) { tr_emit(c3, ", "); c3 = tr_advance(c3); }
                            c3 = translate_expr(c3);
                            fa = 0;
                        }
                        if (!tr_at_end(c3)) { c3 = tr_advance(c3); }
                        tr_emit(c3, ")");
                        return c3;
                    }
                }

                // Generic-call receiver field-access: emit as normal field access
                // (generic structs like Box<T> are real C structs with fields)

            }
        }

        // Slice syntax: name[start:end] → kr_str_slice(name, start, end)
        if (!tr_at_end(c) && tr_kind(c) == TK_LBRACKET()) {
            let sl_i = c.pos + 1;
            let sl_d = 0;
            let sl_found = 0;
            while (sl_i < c.count) {
                let sl_k = vec_int_get(c.int_data, sl_i * 3);
                if (sl_k == TK_LBRACKET() || sl_k == TK_LPAREN() || sl_k == TK_LBRACE()) { sl_d = sl_d + 1; }
                if (sl_k == TK_RBRACKET() || sl_k == TK_RPAREN() || sl_k == TK_RBRACE()) {
                    if (sl_d == 0) { break; }
                    sl_d = sl_d - 1;
                }
                if (sl_d == 0 && sl_k == TK_COLON()) { sl_found = 1; break; }
                sl_i = sl_i + 1;
            }
            if (sl_found == 1) {
                c = tr_advance(c);
                tr_emit(c, str_concat("kr_str_slice(", str_concat(sanitize_c_name(name), ", ")));
                c = translate_expr(c);
                if (!tr_at_end(c) && tr_kind(c) == TK_COLON()) { c = tr_advance(c); }
                tr_emit(c, ", ");
                c = translate_expr(c);
                if (!tr_at_end(c) && tr_kind(c) == TK_RBRACKET()) { c = tr_advance(c); }
                tr_emit(c, ")");
                return c;
            }
            // Array subscript: arr[i] → kr_vec_int_get(arr, i) for [T]-typed variables
            let arr_type = lookup_local_var_type_name(c, name);
            if (arr_type == "[array]") {
                c = tr_advance(c);
                // Check if subscript is immediately called: arr[i](args) → ((KrClosure)kr_vec_int_get(...))(args)
                let sub_called = 0;
                let sc3 = c.pos;
                let sd3 = 0;
                while (sc3 < c.count) {
                    let sk3 = vec_int_get(c.int_data, sc3 * 3);
                    if (sk3 == TK_LBRACKET()) { sd3 = sd3 + 1; }
                    if (sk3 == TK_RBRACKET()) {
                        if (sd3 == 0) { break; }
                        sd3 = sd3 - 1;
                    }
                    sc3 = sc3 + 1;
                }
                if (sc3 + 1 < c.count && vec_int_get(c.int_data, (sc3 + 1) * 3) == TK_LPAREN()) {
                    sub_called = 1;
                }
                if (sub_called == 1) {
                    // Fat closure indirect call: arr[i](args) → _kr_cl_callN((void*)kr_vec_int_get(arr, i), args)
                    // Pre-scan to count call arguments
                    let call_argc = 0;
                    let sc4 = c.pos;
                    let sd4 = 0;
                    // First skip to ] to find the call's (
                    while (sc4 < c.count) {
                        let sk4 = vec_int_get(c.int_data, sc4 * 3);
                        if (sk4 == TK_LBRACKET()) { sd4 = sd4 + 1; }
                        if (sk4 == TK_RBRACKET()) { if (sd4 == 0) { break; } sd4 = sd4 - 1; }
                        sc4 = sc4 + 1;
                    }
                    // sc4 is at ], sc4+1 should be (, sc4+2 is first arg or )
                    if (sc4 + 2 < c.count && vec_int_get(c.int_data, (sc4 + 2) * 3) != TK_RPAREN()) {
                        call_argc = 1;
                        let sc5 = sc4 + 2;
                        let sd5 = 0;
                        while (sc5 < c.count) {
                            let sk5 = vec_int_get(c.int_data, sc5 * 3);
                            if (sk5 == TK_LPAREN() || sk5 == TK_LBRACKET() || sk5 == TK_LBRACE()) { sd5 = sd5 + 1; }
                            if (sk5 == TK_RPAREN() || sk5 == TK_RBRACKET() || sk5 == TK_RBRACE()) {
                                if (sd5 == 0) { break; }
                                sd5 = sd5 - 1;
                            }
                            if (sd5 == 0 && sk5 == TK_COMMA()) { call_argc = call_argc + 1; }
                            sc5 = sc5 + 1;
                        }
                    }
                    tr_emit(c, str_concat("_kr_cl_call", str_concat(fmt_int(call_argc), "((void*)")));
                }
                tr_emit(c, str_concat("kr_vec_int_get(", str_concat(sanitize_c_name(name), ", ")));
                c = translate_expr(c);
                if (!tr_at_end(c) && tr_kind(c) == TK_RBRACKET()) { c = tr_advance(c); }
                tr_emit(c, ")");
                if (sub_called == 1) {
                    tr_emit(c, ", ");
                    if (!tr_at_end(c) && tr_kind(c) == TK_LPAREN()) { c = tr_advance(c); }
                    let fa2 = 1;
                    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                        if (fa2 == 0) { tr_emit(c, ", "); c = tr_advance(c); }
                        c = translate_expr(c); fa2 = 0;
                    }
                    if (!tr_at_end(c)) { c = tr_advance(c); }
                    tr_emit(c, ")");
                }
                return c;
            }
        }

        // Tuple field closure call: name.N(args) → ((int64_t(*)(int64_t,...))name.fN)(args)
        if (!tr_at_end(c) && tr_kind(c) == TK_DOT()) {
            let tf1 = c.pos + 1;
            if (tf1 < c.count && vec_int_get(c.int_data, tf1 * 3) == TK_INT_LIT()) {
                let tf2 = tf1 + 1;
                if (tf2 < c.count && vec_int_get(c.int_data, tf2 * 3) == TK_LPAREN()) {
                    let tfc = 0;
                    let tf3 = tf2 + 1;
                    if (tf3 < c.count && vec_int_get(c.int_data, tf3 * 3) != TK_RPAREN()) { tfc = 1; }
                    let tfsi = tf3;
                    let tfsd = 0;
                    while (tfsi < c.count) {
                        let tfsk = vec_int_get(c.int_data, tfsi * 3);
                        if (tfsk == TK_LPAREN() || tfsk == TK_LBRACKET() || tfsk == TK_LBRACE()) { tfsd = tfsd + 1; }
                        if (tfsk == TK_RPAREN() || tfsk == TK_RBRACKET() || tfsk == TK_RBRACE()) {
                            if (tfsd == 0) { break; }
                            tfsd = tfsd - 1;
                        }
                        if (tfsd == 0 && tfsk == TK_COMMA()) { tfc = tfc + 1; }
                        tfsi = tfsi + 1;
                    }
                    let tfsig = "";
                    let tfai = 0;
                    while (tfai < tfc) {
                        if (tfai > 0) { tfsig = str_concat(tfsig, ", "); }
                        tfsig = str_concat(tfsig, "int64_t");
                        tfai = tfai + 1;
                    }
                    let field_idx = vec_string_get(c.lexemes, tf1);
                    tr_emit(c, str_concat("((int64_t(*)(", str_concat(tfsig, str_concat("))", str_concat(sanitize_c_name(name), str_concat(".f", str_concat(field_idx, ")(")))))));
                    c = tr_advance(c);
                    c = tr_advance(c);
                    c = tr_advance(c);
                    let tffa = 1;
                    while (!tr_at_end(c) && tr_kind(c) != TK_RPAREN()) {
                        if (tffa == 0) { tr_emit(c, ", "); c = tr_advance(c); }
                        c = translate_expr(c);
                        tffa = 0;
                    }
                    if (!tr_at_end(c)) { c = tr_advance(c); }
                    tr_emit(c, ")");
                    return c;
                }
            }
        }

        if (is_top_level_fn_name(tr, name) && !is_local_fn_var(tr, name)) {
            tr_emit(c, mangle_top_level_fn_name(name));
        } else {
            if (strlen(name) > 0) {
                let ch0 = str_char_at(name, 0);
                if (ch0 >= 65 && ch0 <= 90) {
                    tr_emit(c, "0");
                    return c;
                }
            }
            tr_emit(c, sanitize_c_name(name));
        }
        return c;
    }

    if (!tr_at_end(tr)) {
        if (tr_kind(tr) == TK_IDENTIFIER()) {
            tr_emit(tr, sanitize_c_name(tr_lexeme(tr)));
        } else {
            tr_emit(tr, "0");
        }
        return tr_advance(tr);
    }
    return tr;
}

// ---------------------------------------------------------------------------
// Join VecString into a single string
// ---------------------------------------------------------------------------

pub fn join_output(out: VecString) -> string {
    let result = "";
    let len = vec_string_len(out);
    let i = 0;
    while (i < len) {
        result = str_concat(result, vec_string_get(out, i));
        i = i + 1;
    }
    return result;
}
