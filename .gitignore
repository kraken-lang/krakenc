# src/main.c is intentionally tracked: it is the portable bootstrap source.
# Anyone with clang can build krakenc directly with `clang src/main.c -o krakenc`
# (plus -lm -lpthread on Linux, -lm on macOS). It is regenerated whenever any
# .kr source under src/ changes; commit the regen alongside the .kr edit.

# Generated artifacts that ARE build-only (not bootstrap sources)
src/main.ll
src/main_runtime.c
src/parser.c
src/main_gen2.c
tests/*.c
tests/*.ll
tests/*_runtime.c
tests/*.exe

# Test outputs that aren't sources
test.c
test.exe
_kr_runtime.c
build_err.txt
build/run_log.txt
build/main_out.txt
build/main_err.txt
build/main_self.txt
build/lex_out.txt
build/test_lex.txt
build/bc4_log.txt
